---
/**
 * Vorlage "praxishell", Aufbau nach zahnarzt-wels.at.
 * Vom Nutzer gelobt, vor allem die Landingpages: Bilder reichen von links bis ganz rechts
 * und im Auftakt bis an den oberen Rand, eine sehr leichte Schrift, schlichte Pillenknoepfe,
 * Auszeichnungen und Bewertungen transparent auf dem Auftakt, ein Hinweis auf Formulare
 * als Glasfeld mit leichtem Blur. Dazu Kacheln mit Angeboten, Zufriedenheit als Karten,
 * ein einfaches Team. Statt Video steht ein Foto; beides geht.
 * Nicht uebernommen: die kleinen Rubrik-Pillen ueber den Kacheltiteln.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const angebote = [['1027','Zahnspangen und Aligner'],['823','Kinderzahnmedizin'],['445','Implantate'],['832','Kieferchirurgie'],['1011','Behandlung in Vollnarkose'],['669','Ästhetische Füllungen'],['856','Prophylaxe'],['338','Parodontologie']];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Praxis Dr. Muster – Zahnmedizin in Musterstadt</title></head>
<body>
<header><a class="wm" href="#"><b aria-hidden="true">M</b>Dr. Muster</a><nav aria-label="Hauptnavigation"><a href="#">Start</a><a href="#leistungen">Leistungen</a><a href="#praxis">Praxis</a><a href="#team">Team</a><a href="#">Karriere</a><a href="#kontakt">Kontakt</a></nav><a class="p tel" href="tel:+4900000000">☏ +49 000 000 00</a></header>
<a class="fest p" href="#kontakt">Termin vereinbaren <span aria-hidden="true">+</span></a>
<main>
  <section class="start"><img src={b('1011')} alt="Behandlungszimmer der Praxis" /><div class="text"><h1>Ihr Zahnarzt in Musterstadt und Umgebung</h1><p>Unsere Praxis bietet Ihnen Behandlungen in allen Fachbereichen der Zahnmedizin, auf hohem wissenschaftlichem Stand. Dabei stehen Sie für uns immer im Mittelpunkt.</p><div class="zwei"><a class="p" href="#kontakt">Online Termin vereinbaren</a><a class="p leer" href="#leistungen">Leistungen erkunden</a></div>
    <ul class="preise" aria-label="Auszeichnungen und Bewertungen"><li class="kranz">Patienten-<br />empfehlung<br /><b>2025</b></li><li class="schild">Regionale<br />Auszeichnung<br /><b>2025</b></li><li class="note"><small>Google</small><b>4,8</b><span aria-hidden="true">★★★★★</span><small>120+ Bewertungen</small></li><li class="note"><small>Arztportal</small><b>5,0</b><span aria-hidden="true">★★★★★</span><small>400+ Bewertungen</small></li></ul></div>
    <aside class="glas"><img src={b('445')} alt="" /><div><p>Hier finden Sie unsere Aufnahmebögen.</p><a href="#">Für Erwachsene →</a><a href="#">Für Kinder →</a></div></aside></section>
  <section class="info"><article><h2>Öffnungszeiten</h2><dl>{[['Mo','07:30 – 12:00','13:30 – 18:00'],['Di','07:30 – 12:00','13:30 – 18:00'],['Mi','07:30 – 12:00','13:30 – 18:00'],['Do','07:30 – 12:00','13:30 – 18:00'],['Fr','07:30 – 12:00','–']].map(([t, v, n]) => <div><dt>{t}</dt><dd>{v}</dd><dd>{n}</dd></div>)}</dl></article><article><h2>Kontakt</h2><p>Musterstraße 11, 12345 Musterstadt<br />+49 000 000 00<br />praxis@muster.example</p><a href="#">Route berechnen →</a></article><article><h2>Treten Sie mit uns in Kontakt</h2><p>Vereinbaren Sie einfach und schnell einen Termin online oder rufen Sie uns an.</p><a class="p" href="#kontakt">Online Termin vereinbaren</a><a class="p dunkel" href="tel:+4900000000">+49 000 000 00</a></article></section>
  <section class="qualitaet"><h2>Qualität ist kein Zufall</h2><ul>{[['Google','4,8','120+ Bewertungen'],['Arztportal','5,0','400+ Bewertungen'],['Branchenbuch','5,0','50+ Bewertungen']].map(([q, w, a]) => <li><small>{q}</small><b>{w}</b><span aria-hidden="true">★★★★★</span><small>{a}</small></li>)}</ul></section>
  <section class="gruende"><h2>Sechs Gründe, warum Patienten gerne zu uns kommen</h2><ol>{[['Umfassende Fachkompetenz','In unserer Praxis decken Spezialisten jede Fachrichtung der Zahnmedizin ab.'],['Auch schwierige Fälle','Wir sind erfahren mit komplexen Fällen und umfassenden Sanierungen.'],['Einfühlsam mit Kindern','Kinder werden bei uns mit Zeit und Ruhe behandelt.'],['Behandlung in Vollnarkose','Für Angstpatienten und große Eingriffe, sicher begleitet.'],['Wurzelbehandlung mit Mikroskop','Feinste Technik für den Erhalt Ihrer Zähne.'],['Moderne Kieferorthopädie','Mit unsichtbaren Schienen und festen Spangen.']].map(([t, p], i) => <li><span aria-hidden="true">{i + 1}</span><h3>{t}</h3><p>{p}</p></li>)}</ol></section>
  <section class="breit" id="praxis"><img src={b('128')} alt="Landschaft rund um Musterstadt" loading="lazy" /><h2>Mitten im Grünen der Region</h2></section>
  <section class="angebot" id="leistungen"><h2>Das können wir für Sie tun</h2><ul>{angebote.map(([n, t]) => <li><a href="#"><img src={b(n)} alt="" loading="lazy" /><h3>{t}</h3><span aria-hidden="true">→</span></a></li>)}</ul></section>
  <section class="breit hoch"><img src={b('1027')} alt="Patientin lächelt nach der Behandlung" loading="lazy" /><h2>Hinter jedem Lächeln steht eine Geschichte</h2></section>
  <section class="stimmen"><div class="kopf"><h2>Zufriedene Patienten aus der Region</h2><ul class="mini"><li><small>Google</small><b>4,8</b></li><li><small>Arztportal</small><b>5,0</b></li></ul></div><ul class="karten" tabindex="0" aria-label="Stimmen, waagerecht scrollbar">{[['„Ein echter Experte“','Ich kann nur das Beste über diese Praxis sagen. Freundlich, kompetent und herzlich.'],['„Perfekt für Angstpatienten“','Ich hatte jahrelang Angst. Hier wurde mir jede Sorge genommen.'],['„Endlich ein Zahnarzt, dem ich vertraue“','Gründlich, ehrlich und mit viel Zeit für Fragen.']].map(([t, p]) => <li><small>Arztportal · bestätigte Bewertung</small><h3>{t}</h3><p>{p}</p><span aria-label="fünf von fünf">5/5 ★★★★★</span></li>)}</ul></section>
  <section class="team" id="team"><h2>Für jede Fachrichtung ein Spezialist</h2><ul>{[['856','Dr. Max Muster','Implantologie'],['1027','Dr. Anna Beispiel','Kieferorthopädie'],['1005','Dr. Tim Probe','Ästhetische Zahnheilkunde'],['832','Dr. Lea Vorlage','Endodontie']].map(([n, t, r]) => <li><img src={b(n)} alt="" loading="lazy" /><h3>{t}</h3><p>{r}</p></li>)}</ul><a class="p leer dunkel-rand" href="#">Gesamtes Team ansehen</a></section>
  <section class="breit kontakt"><img src={b('823')} alt="" loading="lazy" /><h2>Nehmen Sie Kontakt zu uns auf</h2><a class="p weiss" href="tel:+4900000000">☏ +49 000 000 00</a></section>
  <section class="satz"><p>In unserer Praxis legen wir großen Wert auf Ihr Vertrauen, Ihre Gesundheit und Ihr Wohlbefinden. Wir wissen, dass der Gang zum Zahnarzt für viele schwer ist, <span>und haben deshalb ein Umfeld des Vertrauens geschaffen.</span></p></section>
  <section class="fragen"><h2>Häufige Fragen</h2>{[['Wie finde ich einen guten Zahnarzt?','Achten Sie auf Erfahrung, Bewertungen und darauf, dass man sich Zeit für Sie nimmt.'],['Wo liegt die Praxis?','Mitten in Musterstadt, mit Parkplätzen im Hof.'],['Wie oft sollte ich zur Kontrolle?','In der Regel zweimal im Jahr.'],['Sind Sie Kassenzahnarzt?','Wir behandeln Kassen- und Privatpatienten.']].map(([f, a]) => <details><summary>{f}</summary><p>{a}</p></details>)}</section>
</main>
<footer id="kontakt"><div class="oben"><img src={b('1011')} alt="" loading="lazy" /><h2>Vereinbaren Sie einen Termin in unserer Praxis</h2><div><a class="p" href="#">Jetzt Termin vereinbaren</a><a class="p leer" href="tel:+4900000000">+49 000 000 00</a></div></div><div class="spalten"><div><h3>Navigation</h3><p>Start<br />Leistungen<br />Praxis<br />Team<br />Karriere</p></div><div><h3>Aufnahmebögen</h3><p>Erwachsene<br />Kinder</p></div><div><h3>Rechtliches</h3><p><a href="#">Impressum</a><br /><a href="#">Datenschutz</a></p></div><div><h3>Kontakt</h3><p>Musterstraße 11<br />12345 Musterstadt<br />+49 000 000 00</p></div></div><small>Beispielinhalte, die Praxis ist erfunden.</small></footer>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; } body { margin: 0; background: #fff; color: #1d1d1b; font-family: var(--font-body); font-size: 16px; line-height: 1.6; font-weight: 300; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; } ul, ol { list-style: none; } a { color: inherit; text-decoration: none; } b { font-weight: 500; }
  h1, h2 { font-family: var(--font-display); font-weight: 400; letter-spacing: -.01em; line-height: 1.2; } h2 { font-size: clamp(30px, 3.6vw, 52px); } h3 { font-size: 20px; font-weight: 400; line-height: 1.3; }
  .p { display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px; border-radius: 100px; background: #4e6f8a; color: #fff; font-weight: 400; border: 1px solid #4e6f8a; transition: background .2s; } .p:hover { background: #3c5a72; } .p.leer { background: transparent; border-color: #fff; } .p.dunkel { background: #3e3a35; border-color: #3e3a35; } .p.weiss { background: #fff; color: #1d1d1b; border-color: #fff; } .dunkel-rand { color: #1d1d1b !important; border-color: #1d1d1b !important; }
  header { position: absolute; inset: 0 0 auto; z-index: 5; display: flex; align-items: center; gap: 40px; height: 88px; padding: 0 4%; color: #fff; } .wm { display: flex; align-items: center; gap: 10px; font-size: 26px; font-weight: 400; } .wm b { width: 36px; height: 36px; border-radius: 50%; background: #fff; color: #1d1d1b; display: grid; place-content: center; font-size: 18px; } header nav { display: flex; gap: 40px; margin: 0 auto; font-size: 17px; font-weight: 400; } .tel { background: rgb(78 111 138 / .9); }
  .fest { position: fixed; right: 4%; bottom: 22px; z-index: 20; box-shadow: 0 4px 30px rgb(0 0 0 / .15); font-size: 18px; } .fest span { font-size: 26px; line-height: 1; }
  .start { position: relative; height: max(100vh, 760px); color: #fff; } .start > img { position: absolute; inset: 0; filter: brightness(.62); } .text { position: relative; padding: 190px 4% 0; max-width: 760px; } h1 { font-size: clamp(42px, 5vw, 70px); margin-bottom: 26px; } .text > p { max-width: 560px; margin-bottom: 30px; } .zwei { display: flex; flex-wrap: wrap; gap: 18px; }
  .preise { display: flex; gap: 22px; align-items: center; margin-top: 70px; } .preise li { display: grid; justify-items: center; text-align: center; font-size: 11px; line-height: 1.25; } .kranz, .schild { width: 106px; height: 106px; place-content: center; border: 1.5px solid rgb(255 255 255 / .8); } .kranz { border-radius: 50%; } .schild { clip-path: polygon(50% 0, 100% 22%, 100% 78%, 50% 100%, 0 78%, 0 22%); background: rgb(255 255 255 / .12); } .kranz b, .schild b { font-size: 15px; } .note { width: 94px; padding: 8px 4px; border: 1.5px solid rgb(255 255 255 / .85); border-radius: 5px; background: rgb(0 0 0 / .2); } .note b { font-size: 30px; font-weight: 300; line-height: 1.1; } .note span { letter-spacing: 1px; font-size: 12px; }
  .glas { position: absolute; right: 4%; bottom: 100px; display: flex; gap: 16px; align-items: center; width: 440px; padding: 16px; border-radius: 6px; background: rgb(18 18 18 / .3); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); font-size: 16px; } .glas img { width: 140px; height: 122px; border-radius: 3px; flex: none; } .glas p { margin-bottom: 14px; } .glas a { display: block; margin-top: 4px; font-weight: 400; }
  .info { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 60px 4%; } .info article { border: 1px solid #e2ded6; border-radius: 6px; padding: 26px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; font-size: 14px; } .info h2 { font-size: 20px; } .info dl div { display: grid; grid-template-columns: 40px 1fr 1fr; } .info .p { padding: 9px 16px; font-size: 13px; }
  .qualitaet { text-align: center; padding: 60px 4% 100px; } .qualitaet h2 { font-size: clamp(36px, 4.6vw, 64px); } .qualitaet ul { display: flex; justify-content: center; gap: 22px; margin-top: 40px; } .qualitaet li, .mini li { display: grid; justify-items: center; padding: 14px 22px; border-radius: 6px; background: #fbf6ea; font-size: 12px; } .qualitaet b { font-size: 40px; font-weight: 300; color: #8a6d1a; line-height: 1.1; } .qualitaet span { color: #c99a1e; letter-spacing: 1px; }
  .gruende { padding: 40px 10% 110px; text-align: center; } .gruende h2 { max-width: 640px; margin: 0 auto 60px; font-size: clamp(28px, 3vw, 40px); } .gruende ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 50px 60px; text-align: left; } .gruende span { display: grid; place-content: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid #1d1d1b; font-size: 13px; margin-bottom: 16px; } .gruende h3 { margin-bottom: 12px; } .gruende p { font-size: 14px; color: #4a4741; }
  .breit { position: relative; height: 640px; color: #fff; } .breit > img { position: absolute; inset: 0; } .breit::after { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / .22); } .breit h2 { position: absolute; z-index: 1; left: 4%; top: 40px; } .breit.hoch { height: 620px; } .breit.hoch h2 { top: auto; bottom: 40px; } .kontakt h2 { top: auto; bottom: 50px; } .kontakt .p { position: absolute; z-index: 1; right: 4%; bottom: 54px; }
  .angebot { padding: 100px 4%; } .angebot h2 { text-align: center; margin-bottom: 50px; } .angebot ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; } .angebot a { position: relative; display: block; height: 380px; border-radius: 6px; overflow: hidden; color: #fff; } .angebot img { transition: scale .6s; } .angebot a:hover img { scale: 1.05; } .angebot a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(rgb(0 0 0 / .45), rgb(0 0 0 / .05) 50%, rgb(0 0 0 / .25)); } .angebot h3 { position: absolute; z-index: 1; left: 20px; right: 20px; top: 20px; font-size: 22px; } .angebot span { position: absolute; z-index: 1; right: 16px; bottom: 16px; width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #1d1d1b; display: grid; place-content: center; }
  .stimmen { padding: 100px 0 100px 4%; } .stimmen .kopf { display: flex; justify-content: space-between; align-items: flex-end; padding-right: 4%; margin-bottom: 40px; } .mini { display: flex; gap: 12px; } .mini b { font-size: 26px; font-weight: 300; color: #8a6d1a; } .karten { display: flex; gap: 20px; overflow-x: auto; scrollbar-width: none; padding-right: 4%; } .karten li { flex: 0 0 420px; background: #fbf6ea; border-radius: 6px; padding: 26px; font-size: 14px; } .karten small { color: #5f5b54; } .karten h3 { margin: 18px 0 12px; } .karten span { display: block; margin-top: 30px; color: #8a6d1a; }
  .team { padding: 90px 4%; text-align: center; } .team ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin: 50px 0 40px; } .team img { height: 340px; background: #f0efec; } .team h3 { margin-top: 18px; } .team p { font-size: 13px; color: #5f5b54; }
  .satz { padding: 110px 4%; } .satz p { max-width: 900px; margin-left: auto; font-family: var(--font-display); font-size: clamp(26px, 2.6vw, 36px); line-height: 1.35; } .satz span { color: #7a766e; }
  .fragen { max-width: 860px; margin: 0 auto; padding: 40px 24px 110px; } .fragen h2 { text-align: center; margin-bottom: 40px; } details { border-bottom: 1px solid #e2ded6; } summary { cursor: pointer; list-style: none; display: flex; gap: 16px; padding: 16px 0; font-weight: 400; } summary::-webkit-details-marker { display: none; } summary::before { content: '+'; display: grid; place-content: center; width: 22px; height: 22px; border-radius: 50%; background: #f0efec; } details[open] summary::before { content: '–'; } details p { padding: 0 0 16px 38px; color: #4a4741; }
  footer { background: #262624; color: #fff; padding-bottom: 30px; } .oben { position: relative; height: 300px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; padding: 0 4% 50px; } .oben img { position: absolute; inset: 0; filter: brightness(.4); } .oben h2, .oben div { position: relative; } .oben h2 { max-width: 620px; } .oben div { display: flex; flex-direction: column; gap: 12px; } .spalten { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; padding: 50px 4%; font-size: 14px; color: #d8d6d1; } .spalten h3 { font-size: 13px; color: #fff; margin-bottom: 12px; } footer small { display: block; padding: 0 4%; color: #c9c6bf; }
  a:focus-visible, summary:focus-visible, [tabindex]:focus-visible { outline: 2px solid #4e6f8a; outline-offset: 3px; } @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  @media (max-width: 960px) { header { height: 70px; padding: 0 16px; gap: 10px; } header nav { display: none; } .tel { margin-left: auto; padding: 9px 14px; font-size: 13px; } .fest { right: 12px; bottom: 12px; font-size: 15px; padding: 11px 18px; } .start { height: auto; min-height: 760px; padding-bottom: 30px; } .text { padding: 120px 20px 0; } .preise { flex-wrap: wrap; gap: 12px; margin-top: 40px; } .kranz, .schild { width: 84px; height: 84px; } .glas { position: relative; inset: auto; width: auto; margin: 30px 20px 0; } .glas img { width: 100px; height: 90px; } .info, .gruende ol, .angebot ul, .team ul, .spalten { grid-template-columns: 1fr; } .angebot ul, .team ul { grid-template-columns: 1fr 1fr; } .angebot a { height: 240px; } .angebot h3 { font-size: 17px; left: 12px; top: 12px; } .team img { height: 220px; } .qualitaet ul { flex-wrap: wrap; gap: 10px; } .gruende { padding: 30px 20px 70px; } .breit { height: 380px; } .breit h2 { left: 20px; right: 20px; } .kontakt .p { left: 20px; right: auto; bottom: 20px; } .kontakt h2 { bottom: 80px; } .stimmen .kopf { flex-direction: column; align-items: flex-start; gap: 18px; } .karten li { flex-basis: 300px; } .satz { padding: 70px 20px; } .oben { height: auto; min-height: 340px; flex-direction: column; align-items: flex-start; padding: 40px 20px; } }
</style>
</body></html>
