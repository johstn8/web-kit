---
/**
 * Vorlage "verlauf", Aufbau nach metagram-solutions.com.
 * Viel Weiss, Poppins 500, schillernde Verlaufsflaechen als einzige Farbe neben Blau.
 * Mittiger Titel 81 px auf Hellblau, Pfeil, Zeichnung in blauer Flaeche, grosser
 * Mittelsatz, laufendes Wortband, Saeulen-Diagramm, Kacheln mit Mini-Diagrammen,
 * Punktweltkarte mit Boegen, Ergebniskarte auf Schillerflaeche, Leistungen zum Wischen,
 * Ueber uns, Fragen, Kontakt auf Schillerflaeche.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const worte = ['Integration', 'Datenanalyse', 'Betrieb', 'Beratung', 'Migration', 'Validierung', 'Planung'];
const orte = [[250, 96], [600, 80], [700, 130], [840, 200], [180, 170]];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>prozesswerk</title></head>
<body>
<header><b>prozesswerk</b><nav><a href="#">Leistungen</a><a href="#">Über uns</a><a href="#">Wissen</a><a href="#">Kontakt</a></nav><a class="k" href="#">Gespräch vereinbaren</a></header>
<main>
  <section class="start"><div class="schiller a"></div><h1>Wirksame Beratung für Produktion 4.0</h1><p>Wir machen aus Ihrer Fertigung ein digitales Kraftwerk.</p><a class="k" href="#">Gespräch vereinbaren</a><i class="pfeil">↓</i></section>
  <section class="bild"><div><span class="b1">Wo fangen<br />wir an?</span><span class="b2">Ist der Betrieb<br /><em>bereit</em> dafür?</span><span class="b3">Haben wir genug<br /><em>Fachleute</em>?</span><button aria-label="Film abspielen">▶</button></div></section>
  <section class="satz"><p>Wir helfen Betrieben mit erstklassiger Digitalisierung und einem bewährten Modell. So digitalisieren, skalieren und optimieren Sie Ihr Geschäft.</p><a class="k" href="#">Gespräch vereinbaren</a></section>
  <div class="lauf" aria-hidden="true"><div>{[...worte, ...worte, ...worte].map((w) => <span>{w}</span>)}</div></div>
  <section class="saeulen"><div class="schiller c"></div><div class="dia"><b>Digitales<br />Kraftwerk</b><span class="p1">Menschen<br />&amp; Teams</span><span class="p2">Abläufe<br />&amp; Werte</span><span class="p3">Technik<br />&amp; Daten</span><span class="p4">Partner<br />im Verbund</span></div><div><h2>Die vier Säulen der digitalen Fabrik</h2><p>Unsere Lösung baut Ihr eigenes digitales Kraftwerk auf.</p></div></section>
  <section class="kraft"><h2>Die Stärke der<br />Zusammenarbeit</h2>
    <div class="raster"><article class="gross"><div class="plan"><span>Projektzeit</span><span>Kosten</span><span>Durchlauf</span></div><h3>Bis zu 28 % kürzere Projektzeiten</h3><p>Schlanke Abläufe mit klaren Schritten, ohne Abstriche bei der Qualität.</p></article>
      <article class="balk"><div><h3>Projektkosten senken</h3><p>Budget effizient steuern, ohne Einbußen.</p></div><div class="diag"><b>↓ 16 %</b>{[9, 8, 7, 7, 6, 5, 5, 4, 3].map((h) => <i style={`height:${h * 10}%`}></i>)}</div></article>
      <article class="balk"><div><h3>Schneller durchlaufen</h3><p>Mehr Effizienz in jedem Schritt.</p></div><svg viewBox="0 0 120 80"><path d="M0 10 20 18 40 16 60 34 80 44 100 42 120 70" fill="none" stroke="#0060ff" stroke-width="1.6" /></svg></article></div>
    <ul class="drei">{['Schneller freigeben','Weniger Handarbeit','Beim ersten Mal richtig'].map((t) => <li><i>▣</i><h3>{t}</h3><p>Geprüfte Abläufe verringern Fehler und Wartezeit.</p></li>)}</ul>
    <div class="ruf"><p>Bereit für die Kraft von prozesswerk?</p><a class="k" href="#">Gespräch vereinbaren</a></div></section>
  <section class="welt"><h2>Erstklassige Leistungen<br />weltweit</h2><div class="kipp" aria-hidden="true"><svg viewBox="0 0 1000 330"><defs><pattern id="p" width="13" height="13" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.5" fill="#c7cdd8" /></pattern></defs><path d="M60 80 180 40 330 60 400 130 340 240 240 300 200 190 90 150ZM470 40 640 30 800 60 920 120 860 190 720 200 620 290 540 230 500 130Z" fill="url(#p)" />{orte.map(([x, y], i) => <path class="bg" style={`--i:${i}`} d={`M420 110 Q${(420 + x) / 2} ${Math.min(y, 110) - 90} ${x} ${y}`} pathLength="1" />)}</svg><span class="s1">Hamburg</span><span class="s2">Meppen</span></div></section>
  <section class="ergeb"><h2>Ergebnisse unserer Kunden</h2><div class="schillerkarte"><div class="karte"><h3>Weltweiter Lohnfertiger</h3><p>Die Anlage wurde vollständig eingeführt, einschließlich Reinigung, Material und Lieferkette.</p><ul><li>Fahrplan und Steuerung</li><li>Unabhängige Auswahl</li><li>Abnahme und Schulung</li></ul><dl><div><dd>100 %</dd><dt>Pünktlich freigegeben</dt></div><div><dd>100 %</dd><dt>Pünktlich geliefert</dt></div><div><dd>20 %</dd><dt>Weniger Bestand</dt></div><div><dd>1–2</dd><dt>Wochen weniger</dt></div></dl></div></div></section>
  <section class="leist"><div class="k2"><h2>Leistungen, die Sie<br />weiterbringen</h2><a class="k" href="#">Gespräch vereinbaren</a></div><ul tabindex="0" aria-label="Leistungen, waagerecht scrollbar">{['Strategie','Einstieg','Planung','Umsetzung','Start & Betreuung','Exzellenz'].map((t) => <li><i>▦</i><h3>{t}</h3><p>Beratung für diesen Schritt, von Anfang bis Abschluss.</p><ul><li>Festlegen der Ziele</li><li>Auswahl der Partner</li><li>Fahrplan</li></ul></li>)}</ul></section>
  <section class="ueber"><div><h2>Über<br />prozesswerk</h2><p>Wir haben für alles eine Lösung und die passende Erfahrung. Unser Antrieb ist, Dinge besser zu machen.</p><a class="u" href="#">Mehr über uns</a></div><img src={b('3')} alt="" loading="lazy" /></section>
  <section class="fragen"><h2>Häufige Fragen</h2>{['Wie plane ich eine moderne Produktion?','Welches System passt zu meinem Betrieb?','Wie begründe ich die Investition?','Wie läuft eine Migration ab?'].map((f) => <details><summary>{f}<i>+</i></summary><p>Das klären wir gemeinsam im ersten Gespräch.</p></details>)}</section>
  <section class="kontakt"><div class="schiller b"></div><div class="t"><h2>Sprechen Sie mit unseren Fachleuten</h2><p>Ein erstes Gespräch ist kostenfrei.</p><a class="k" href="#">Gespräch vereinbaren</a></div></section>
</main>
<footer><b>prozesswerk</b><ul><li>Start</li><li>Leistungen</li><li>Über uns</li></ul><ul><li>Impressum</li><li>Datenschutz</li></ul><ul><li>Beispielinhalt einer Vorlage</li></ul></footer>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; background: #fff; color: #111; font-family: var(--font-body); font-size: 16px; line-height: 1.5; overflow-x: clip; } img { display: block; width: 100%; object-fit: cover; } h1, h2, h3, p, ul, dl, dd { margin: 0; padding: 0; font-weight: 500; } p { font-weight: 400; } ul { list-style: none; } a { color: inherit; text-decoration: none; } h1, h2, h3, header b, footer b { font-family: var(--font-display); }
  h2 { font-size: clamp(32px, 4.2vw, 60px); line-height: 1.16; } .k { display: inline-block; background: #0060ff; color: #fff; padding: 9px 18px; border-radius: 4px; font-size: 14px; }
  .schiller { position: absolute; border-radius: 50%; filter: blur(30px); background: conic-gradient(from 210deg, #ffd6ec, #d8c7ff, #b7e4ff, #c6ffe9, #fff2b8, #ffd6ec); opacity: .75; }
  header { position: absolute; inset: 0 0 auto; z-index: 3; display: flex; align-items: center; gap: 30px; padding: 30px 100px; } header b { font-size: 24px; font-weight: 600; } nav { display: flex; gap: 28px; margin-left: auto; font-size: 15px; }
  .start { position: relative; min-height: 900px; background: #f6f8fc; text-align: center; padding: 240px 20px 0; overflow: hidden; } .a { width: 900px; height: 900px; right: -300px; bottom: -500px; } h1 { position: relative; font-size: clamp(42px, 5.6vw, 81px); line-height: 1.12; max-width: 1040px; margin: auto; } .start p { position: relative; margin: 26px 0; font-size: 18px; } .pfeil { position: absolute; left: 50%; bottom: 40px; translate: -50% 0; width: 24px; height: 40px; border: 1px solid #111; border-radius: 12px; font-style: normal; }
  .bild { padding: 90px 100px 0; } .bild div { position: relative; height: 680px; max-width: 1110px; margin: auto; background: #eaf1ff; } .bild span { position: absolute; background: #fff; border: 1px solid #333; padding: 10px 16px; border-radius: 6px; font-size: 18px; } .b1 { left: 8%; top: 22%; } .b2 { left: 45%; top: 10%; } .b3 { left: 72%; top: 20%; } em { font-style: normal; color: #0060ff; } .bild button { position: absolute; left: 0; bottom: 0; width: 60px; height: 60px; border: 0; background: #0060ff; color: #fff; font-size: 20px; }
  .satz { text-align: center; padding: 70px 20px; } .satz p { font-family: var(--font-display); font-weight: 500; font-size: clamp(24px, 2.8vw, 40px); line-height: 1.28; max-width: 1020px; margin: 0 auto 30px; }
  .lauf { overflow: hidden; padding: 60px 0; } .lauf div { display: flex; gap: 60px; width: max-content; font: 700 40px var(--font-body); white-space: nowrap; animation: lauf 40s linear infinite; } @keyframes lauf { to { transform: translateX(-33.3%); } }
  .saeulen { position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 40px; padding: 60px 100px; min-height: 710px; overflow: hidden; } .c { width: 800px; height: 500px; right: -200px; bottom: -100px; opacity: .5; } .dia { position: relative; height: 480px; } .dia b { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 200px; height: 200px; border-radius: 50%; display: grid; place-items: center; text-align: center; background: #0060ff; color: #fff; font-size: 18px; font-weight: 500; } .dia span { position: absolute; font-size: 15px; text-align: center; font-weight: 500; width: 190px; height: 190px; border-radius: 50%; display: grid; place-items: center; background: rgb(240 243 250 / .8); box-shadow: inset 0 0 0 1px #e5e9f2; } .p1 { left: 8%; top: 0; } .p2 { right: 8%; top: 0; } .p3 { left: 8%; bottom: 0; } .p4 { right: 8%; bottom: 0; } .saeulen > div:last-child { position: relative; } .saeulen p { margin-top: 18px; }
  .kraft { padding: 110px 100px; } .raster { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; margin-top: 60px; } article { background: #f6f7f9; padding: 22px; border-radius: 8px; } .gross { grid-row: 1 / 3; display: flex; flex-direction: column; } .plan { flex: 1; background: #fff; display: flex; gap: 30px; padding: 16px; font-size: 13px; margin-bottom: 18px; min-height: 300px; } h3 { font-size: 21px; line-height: 1.3; margin-bottom: 8px; } article p { font-size: 14px; color: #555; } .balk { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; } .diag { position: relative; background: #fff; padding: 26px 12px 8px; display: flex; align-items: flex-end; gap: 4px; min-height: 180px; } .diag b { position: absolute; top: 6px; left: 12px; color: #0060ff; font-size: 13px; } .diag i { flex: 1; background: #0060ff; } .balk svg { background: #fff; width: 100%; }
  .drei { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; } .drei li { background: #f6f7f9; padding: 22px; border-radius: 8px; } .drei i { color: #0060ff; font-style: normal; font-size: 24px; } .drei p { font-size: 14px; color: #555; } .ruf { display: flex; justify-content: space-between; align-items: center; background: #f6f7f9; padding: 22px 26px; margin-top: 14px; border-radius: 8px; } .ruf p { font-family: var(--font-display); font-size: 22px; font-weight: 500; }
  .welt { text-align: center; padding: 60px 40px 120px; } .kipp { position: relative; max-width: 1200px; margin: 30px auto 0; perspective: 1200px; } .kipp svg { transform: rotateX(50deg) scale(1.1); overflow: visible; } .bg { fill: none; stroke: #0060ff; stroke-width: 2; stroke-dasharray: 1; animation: ziehen 3s var(--i, 0) ease-out infinite alternate; } @keyframes ziehen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } } .kipp span { position: absolute; background: #111; color: #fff; padding: 3px 12px; border-radius: 20px; font-size: 13px; } .s1 { left: 56%; top: 24%; } .s2 { left: 40%; top: 46%; }
  .ergeb { padding: 90px 100px; } .schillerkarte { margin-top: 40px; padding: 60px; border-radius: 8px; background: linear-gradient(110deg, #f6f7f9 10%, #e7d9ff 25%, #bfeaff 40%, #f6f7f9 60%, #fff0c4 90%); } .karte { background: rgb(255 255 255 / .75); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); padding: 40px; border: 1px solid #fff; border-radius: 8px; } .karte ul { columns: 2; margin: 16px 0; font-size: 14px; } .karte li::before { content: '• '; } dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 0; } dd { font-family: var(--font-display); font-size: 36px; color: #0060ff; } dt { font-size: 13px; color: #555; }
  .leist { padding: 110px 0 110px 100px; } .k2 { display: flex; align-items: flex-end; gap: 30px; margin-bottom: 40px; } .leist > ul { display: flex; gap: 14px; overflow-x: auto; scrollbar-width: none; } .leist > ul > li { flex: 0 0 340px; background: #f6f7f9; padding: 24px; border-radius: 8px; } .leist i { color: #0060ff; font-style: normal; font-size: 24px; } .leist p { font-size: 14px; color: #555; } .leist li ul { margin-top: 14px; font-size: 14px; } .leist li li::before { content: '• '; }
  .ueber { display: grid; grid-template-columns: 1fr .7fr; gap: 80px; padding: 60px 100px; } .ueber p { margin: 20px 0; max-width: 560px; } .u { display: inline-block; border: 1px solid #0060ff; color: #0060ff; padding: 8px 16px; border-radius: 4px; font-size: 14px; } .ueber img { height: 460px; border-radius: 6px; }
  .fragen { max-width: 1240px; margin: auto; padding: 110px 100px; text-align: center; } details { border-bottom: 1px solid #ddd; padding: 20px 8px; text-align: left; } summary { display: flex; justify-content: space-between; list-style: none; cursor: pointer; font-family: var(--font-display); font-weight: 500; font-size: 20px; } summary i { font-style: normal; }
  .kontakt { position: relative; display: grid; grid-template-columns: 1fr 1fr; margin: 0 100px 80px; min-height: 440px; background: #f6f7f9; border-radius: 8px; overflow: hidden; } .b { width: 700px; height: 700px; left: -160px; top: -120px; opacity: 1; } .t { position: relative; grid-column: 2; align-self: center; padding: 30px; } .t p { margin: 14px 0 20px; }
  footer { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 30px; padding: 40px 100px 80px; font-size: 14px; } footer b { font-size: 26px; font-weight: 600; }
  @media (max-width: 760px) { header { padding: 18px; } nav { display: none; } header .k { margin-left: auto; } .start { min-height: 640px; padding-top: 150px; } .bild, .kraft, .ergeb, .ueber, .fragen { padding-inline: 16px; } .bild div { height: 340px; } .bild span { font-size: 12px; padding: 6px 8px; } .saeulen, .raster, .drei, .ueber, .kontakt, footer { grid-template-columns: 1fr; padding-inline: 16px; } .dia { height: 360px; } .dia span { width: 130px; height: 130px; font-size: 13px; } .dia b { width: 130px; height: 130px; font-size: 14px; } .gross { grid-row: auto; } .balk { grid-template-columns: 1fr; } .ruf { flex-direction: column; gap: 12px; align-items: flex-start; } .schillerkarte { padding: 16px; } dl { grid-template-columns: 1fr 1fr; } .karte { padding: 20px; } .karte ul { columns: 1; } .leist { padding-left: 16px; } .k2 { flex-direction: column; align-items: flex-start; } .kontakt { margin-inline: 16px; padding: 0; } .t { grid-column: 1; padding-top: 180px; } }
  @media (prefers-reduced-motion: reduce) { .lauf div, .bg { animation: none; stroke-dashoffset: 0; } }
  /* Gemessen an metagram-solutions.com: das Filmbild schrumpft beim Hereinscrollen von 100 auf 77 %. */
  @supports (animation-timeline: view()) { @media (prefers-reduced-motion: no-preference) { .bild > div { animation: schrumpf linear both; animation-timeline: view(); animation-range: entry 0% cover 55%; } @keyframes schrumpf { from { scale: 1; } to { scale: .77; } } } }
</style>
</body></html>
