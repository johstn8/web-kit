---
/**
 * Vorlage "schmal", Aufbau nach meracinque.com.
 * Fotos randlos, sehr grosse schmale Antiqua in Lila, Rosa, Koralle auf Creme und
 * Lila. Winzige Kopfinsel mittig oben, Stern als Aufkleber unten rechts mit fester
 * Lage. Das Produkt steht in der Mitte fest, der Titel laeuft hinter ihm durch und
 * es wandert beim Scrollen an den Rand. Listen mit Sternen, Foto-Halbseiten, Karte,
 * rosa Kontakt, Fuss in Creme.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Hofmühle Sommer</title></head>
<body>
<nav class="insel" aria-label="Hauptnavigation"><span class="siegel">M</span><a href="#">Menü</a><i></i></nav>
<a class="stern" href="#" aria-label="Probierpaket"><span>✦</span></a>
<main>
  <section class="foto"><img src={b('107')} alt="Reifes Getreide" /><h1>Die Geschichte von fünf Schwestern</h1><a href="#">Entdecken ▸</a></section>
  <section class="creme"><p class="sehr">Von Papas Handwerk zu unserem großen Traum, das <em>Mehl der Wunder</em> zu mahlen ✦</p><a class="kn" href="#">Unsere Familie ▸</a></section>
  <section class="produkt" data-produkt>
    <div class="klebt">
      <h2 class="lauf"><span>Das Mehl der</span><span>Wunder</span></h2>
      <p class="k1">100 % aus eigenem Anbau</p><p class="k2">Ein Jahr gereift</p>
      <div class="packung" aria-hidden="true"><b>HOFMÜHLE</b><u>Mehl<br />Type 550</u><small>Stein gemahlen</small></div>
      <div class="vorteile"><div class="bilder"><img src={b('102')} alt="" /><img src={b('225')} alt="" /></div><ul><li>Bäckt gleichmäßiger und geht länger auf</li><li>Trägt das Aroma des Korns bis in die Kruste</li><li>Bindet Wasser für saftige Krume</li><li>Grobes Korn für ein Mehl mit Biss</li></ul><a href="#">Unser Mehl ▸</a></div>
    </div>
  </section>
  <section class="halb"><div><h2>Die Kunst des Könnens</h2><p>Fünfzig Jahre Erfahrung in der Mühle treffen auf neue Ideen, um eine Landwirtschaft zu leben, die den Boden nährt und die Vielfalt schützt.</p><a class="kn" href="#">Unsere Methode ▸</a></div><img src={b('177')} alt="" /></section>
  <section class="lila"><small>Wo wir sind</small><p>Unsere Felder liegen im Ried zwischen Rhein und Neckar, in einer schmalen Lage, die es so nur einmal gibt.</p><svg viewBox="0 0 600 300" aria-hidden="true"><path d="M60 170 120 80 210 110 270 60 330 120 420 50 520 110 540 200 440 270 340 230 260 280 170 230 80 240Z" fill="#ebafb4" /><circle cx="300" cy="180" r="9" fill="#fff" /></svg></section>
  <section class="breit"><img src={b('128')} alt="" /></section>
  <section class="creme mitte"><h2>Ein Mehl, das Bäcker überzeugt</h2><a class="kn" href="#">Probierpaket ▸</a></section>
  <section class="rosa"><h2>Kontakt</h2><div><p>Wir sind die Partner für Profis. Schreiben Sie uns für Ihre Backstube.</p><form><input aria-label="Name" placeholder="Name" /><input aria-label="E-Mail" placeholder="E-Mail" /><textarea aria-label="Nachricht" placeholder="Nachricht"></textarea><button type="button">Senden ▸</button></form></div></section>
</main>
<footer><ul><li>Methode</li><li>Unser Mehl</li><li>Wer wir sind</li></ul><ul><li>Probe anfragen</li><li>Kaufen</li><li>Kontakt</li></ul><div><b>HOFMÜHLE</b><small>Musterweg 5 · Beispielinhalt einer Vorlage</small></div></footer>
<script is:inline>
(() => {
  const s = document.querySelector('[data-produkt]');
  const z = () => { const r = s.getBoundingClientRect(); const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))); s.style.setProperty('--p', p); s.classList.toggle('zwei', p > .55); };
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) { s.classList.add('zwei'); return; }
  addEventListener('scroll', z, { passive: true }); z();
})();
</script>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; font-family: var(--font-body); background: #faf6e6; color: #232438; font-size: 14px; overflow-x: clip; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, p, ul, form { margin: 0; padding: 0; font-weight: 400; } ul { list-style: none; } a { color: inherit; }
  h1, h2, .sehr { font-family: var(--font-display); font-size: clamp(58px, 8.85vw, 127px); line-height: 1.02; letter-spacing: -.02em; transform: scaleX(.8); transform-origin: left; width: 125%; }
  .insel { position: fixed; top: 25px; left: 50%; translate: -50% 0; z-index: 30; width: 200px; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; border-radius: 16px; background: #f0ecdd; color: #5f63a8; } .insel a { text-decoration: none; font-size: 11px; letter-spacing: .08em; } .insel i { width: 22px; height: 18px; border-block: 4px double currentColor; } .siegel { width: 34px; height: 34px; border-radius: 50%; border: 1px solid; display: grid; place-items: center; font-family: var(--font-display); }
  .stern { position: fixed; right: 26px; bottom: 26px; z-index: 30; width: 74px; height: 74px; display: grid; place-items: center; font-size: 74px; line-height: 1; color: #ebafb4; text-decoration: none; transform: rotate(14deg); }
  .foto { position: relative; height: 100vh; } .foto h1 { position: absolute; left: 22px; bottom: 16px; color: #faf6e6; max-width: 70%; } .foto a { position: absolute; right: 110px; bottom: 34px; color: #fff; font-size: 12px; border: 1px solid #fff; border-radius: 4px; padding: 5px 12px; text-decoration: none; letter-spacing: .08em; }
  .creme { min-height: 92vh; padding: 16vh 22px 12vh; } .sehr { color: #5f63a8; max-width: 92%; } em { font-style: normal; color: #c9606f; } .kn { display: inline-block; margin-top: 26px; background: #d23a4c; color: #fff; padding: 6px 14px; border-radius: 7px; font-size: 12px; text-decoration: none; letter-spacing: .08em; }
  .produkt { height: 420vh; background: #5f63a8; --p: 0; } .klebt { position: sticky; top: 0; height: 100vh; overflow: hidden; color: #faf6e6; }
  .lauf { position: absolute; inset: 50% 0 auto; translate: 0 -50%; width: 100%; transform: none; display: flex; justify-content: center; gap: 22vw; color: #f7d6d8; font-size: 8vw; transition: opacity .4s; } .lauf span { transform: scaleX(.8); }
  .k1, .k2 { position: absolute; font-size: 11px; letter-spacing: .08em; transition: opacity .4s; } .k1 { left: 16%; top: 64%; } .k2 { right: 18%; top: 37%; }
  .packung { position: absolute; left: 50%; top: 50%; width: 260px; height: 520px; margin: -260px 0 0 -130px; background: #f4efe0; color: #4b4f94; border-radius: 12px 12px 26px 26px / 14px 14px 30px 30px; padding: 34px 20px; text-align: center; box-shadow: inset 0 0 50px rgb(120 110 80 / .22), 0 16px 34px rgb(0 0 0 / .18); display: grid; align-content: start; gap: 20px; transition: transform .9s cubic-bezier(.16,1,.3,1); font-family: var(--font-display); font-size: 28px; line-height: 1.05; } .packung u { text-decoration: none; font-size: 34px; } .packung small { font: 11px var(--font-body); letter-spacing: .1em; }
  .zwei .packung { transform: translateX(34vw) rotate(-14deg) scale(.88); } .zwei .lauf, .zwei .k1, .zwei .k2 { opacity: 0; }
  .vorteile { position: absolute; inset: 14vh 24vw 10vh 6vw; display: grid; grid-template-columns: 240px 1fr; grid-template-rows: auto auto 1fr; gap: 20px 30px; opacity: 0; transition: opacity .5s; } .zwei .vorteile { opacity: 1; } .bilder { position: relative; grid-row: 1 / 4; } .bilder img { position: absolute; width: 170px; height: 200px; border-radius: 8px; } .bilder img:first-child { left: 60px; top: 0; } .bilder img:last-child { left: 0; top: 120px; height: 270px; }
  .vorteile li { font-family: var(--font-display); font-size: 34px; line-height: 1.05; padding-left: 30px; position: relative; } .vorteile li::before { content: '✦'; position: absolute; left: 0; color: #ebafb4; font-size: 22px; } .vorteile a { justify-self: start; font-size: 11px; border: 1px solid; padding: 5px 12px; border-radius: 4px; text-decoration: none; }
  .halb { display: grid; grid-template-columns: 1fr 1fr; height: 92vh; background: #faf6e6; } .halb > div { padding: 40px 22px; } .halb h2 { color: #c9606f; font-size: 7vw; } .halb p { font-family: var(--font-display); font-size: 32px; line-height: 1.08; color: #5f63a8; max-width: 500px; margin-top: 12vh; }
  .lila { background: #5f63a8; color: #faf6e6; text-align: center; padding: 150px 22px 90px; } .lila small { letter-spacing: .12em; font-size: 11px; } .lila p { font-family: var(--font-display); font-size: 40px; line-height: 1.1; max-width: 860px; margin: 18px auto 40px; } .lila svg { width: min(620px, 90%); }
  .breit { height: 100vh; } .mitte { min-height: auto; text-align: center; padding-block: 120px; } .mitte h2 { color: #5f63a8; width: 100%; transform: none; font-size: 8vw; }
  .rosa { background: #ebafb4; color: #8f2232; padding: 70px 22px; } .rosa h2 { text-align: center; width: 100%; transform: none; } .rosa > div { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 50px; } .rosa p { font-family: var(--font-display); font-size: 34px; line-height: 1.1; } form { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; } input, textarea { background: #faf6e6; border: 0; padding: 12px; border-radius: 6px; font: inherit; color: #232438; } textarea { grid-column: 1 / -1; min-height: 110px; } form button { justify-self: end; grid-column: 2; background: none; border: 1px solid #232438; color: #232438; padding: 6px 14px; border-radius: 5px; font: inherit; }
  footer { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 20px; padding: 40px 22px; background: #f0ecdd; font-family: var(--font-display); font-size: 24px; color: #5f63a8; } footer div { text-align: center; font-family: var(--font-body); font-size: 16px; display: grid; gap: 6px; } footer small { font-size: 11px; }
  @media (max-width: 760px) { h1, h2, .sehr { transform: none; width: 100%; font-size: 15vw; } .halb, .rosa > div, footer { grid-template-columns: 1fr; height: auto; } .halb img { height: 320px; } .halb h2 { font-size: 15vw; } .vorteile { inset: 12vh 16px 8vh; grid-template-columns: 1fr; } .bilder { display: none; } .vorteile li { font-size: 26px; } .packung { width: 180px; height: 360px; margin: -180px 0 0 -90px; font-size: 20px; } .zwei .packung { transform: translateX(42vw) rotate(-14deg) scale(.6); } .lauf { font-size: 14vw; gap: 40vw; } form { grid-template-columns: 1fr; } form button { grid-column: 1; } }
</style>
</body></html>
