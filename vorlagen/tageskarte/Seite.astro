---
/**
 * Vorlage "tageskarte", Aufbau nach padella.co.
 * Schwarz, weiss, nichts sonst. Volles Foto der Ladenfront, Wortmarke mittig, drei hohe
 * Bilder fuer die Standorte direkt darunter: beim Ueberfahren wechselt das Bild, der
 * Ausschnitt zieht langsam heran und der Name steigt. Danach die Karte des Tages in einem
 * weissen Rahmen, zwei Spalten in sehr kleiner Schrift, Datum als einziger grosser Satz.
 * Kurzer Text, Fuss. Das weiche Scrollen macht beim Original Lenis; hier uebernimmt das
 * ein kleines Skript ohne Abhaengigkeit, nur am Mausrad und nicht bei reduzierter Bewegung.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const heute = new Date().toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long' });
const orte = [['Markthalle','834','395'],['Kreuzberg','635','513'],['Altstadt','625','946']];
const links: [string, [string, string][]][] = [
  ['Antipasti', [['Oliven aus Apulien','4'],['Sauerteigbrot mit Olivenöl','5,5'],['Radicchio, Minze und Parmesan','7,5'],['Salame della Rosa','8,5'],['Burrata mit Olivenöl','9,5'],['Bruschetta mit Wintertomaten','11,5'],['Rindercarpaccio, Parmesan, Balsamico','14']]],
  ['Pasta', [['Tagliarini mit Chili, Knoblauch und Bröseln','9,5'],['Tagliarini mit Tomatensauce','12,5'],['Pici cacio e pepe','13,5'],['Fettuccine mit Nduja und Mascarpone','14'],['Ravioli mit Kürbis und Salbeibutter','14,5'],['Agnolotti mit geschmortem Rind','15'],['Fettuccine mit Waldpilzen','15,5'],['Pappardelle mit Ochsenbacke','16,5']]],
  ['Dolci', [['Tiramisù','8,5'],['Biscotti und Marsala','7,5'],['Birnen-Mandel-Tarte','8,5']]],
  ['Eis', [['Affogato','6,5'],['Vanille','5'],['Salzkaramell','5'],['Zitronensorbet','5']]],
];
const rechts: [string, [string, string][]][] = [
  ['Aperitivi', [['Negroni sbagliato','8,5'],['Negroni des Hauses','8,5'],['Martini des Hauses','9'],['Aperol Spritz','9,5'],['Campari Spritz','9,5']]],
  ['Bier', [['Helles vom Fass, 0,4 l','6'],['Alkoholfreies Lager','6']]],
  ['Softdrinks', [['Limonade, Ginger Beer, Cola','4'],['Hausgemachte Rosmarinlimonade','4,5'],['Ingwer-Switchel','5,5']]],
  ['Wein', [['Falanghina 2023, Kampanien (weiß)','7'],['Vermentino 2023, Toskana (weiß)','8,5'],['Primitivo 2022, Apulien (rot)','7'],['Barbera 2023, Piemont (rot)','7,5'],['Chianti 2021, Toskana (rot)','8']]],
  ['Espresso', [['Caffè Espresso','2'],['Macchiato','2,5']]],
  ['Digestivi', [['Marsala Riserva','5,5'],['Grappa','4'],['Amaro','4'],['Limoncello','3,5']]],
];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>PASTINA – Frische Pasta in Berlin</title></head>
<body>
<header><nav aria-label="Standorte">{orte.map(([n]) => <a href="#orte">{n}</a>)}</nav><a class="wm" href="#">PASTINA</a><nav aria-label="Weiteres"><a href="#">Gutscheine</a><a href="#">Jobs</a></nav></header>
<main>
  <section class="start"><img src={b('437')} alt="Gäste vor dem Laden" /><h1>Frische Pasta, jeden Tag von Hand</h1><a class="ab" href="#orte" aria-label="Weiter zu den Standorten"><svg viewBox="0 0 24 14" aria-hidden="true"><path d="m2 2 10 10L22 2" /></svg></a></section>
  <section class="orte" id="orte" aria-label="Standorte"><ul>{orte.map(([n, a, c]) => <li><a href="#"><img src={b(a)} alt="" /><img class="z" src={b(c)} alt="" loading="lazy" /><svg class="klein" viewBox="0 0 120 22" aria-hidden="true"><text x="60" y="17" text-anchor="middle">PASTINA</text></svg><h2>{n}</h2></a></li>)}</ul></section>
  <section class="karte" aria-labelledby="karte"><h2 id="karte">{heute}</h2><div class="sp">{[links, rechts].map((g) => <div>{g.map(([t, z]) => <section><h3>{t}</h3><dl>{z.map(([n, p]) => <div><dt>{n}</dt><dd>{p} €</dd></div>)}</dl></section>)}</div>)}</div></section>
  <section class="ueber"><h2>Über uns</h2><p>PASTINA ist der lang gehegte Traum von Ada und Ben: eine Pastabar mit frischer, von Hand gerollter Pasta und Saucen, die auf ihren Reisen durch Italien entstanden sind.</p><p>Wenn Sie mehr Zeit mitbringen, besuchen Sie unser anderes Restaurant, <a href="#">Trattoria Ada</a>.</p></section>
</main>
<footer><span class="logo" aria-hidden="true">P</span><p><a href="#">Datenschutz</a><a href="#">Cookies</a><a href="#">Impressum</a><span>Beispielinhalte, der Betrieb ist erfunden.</span></p></footer>
<script is:inline>
(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(pointer: fine)').matches) return;
  let ziel = scrollY, jetzt = scrollY, laeuft = false;
  const schritt = () => { jetzt += (ziel - jetzt) * .1; if (Math.abs(ziel - jetzt) < .5) { jetzt = ziel; laeuft = false; } scrollTo(0, jetzt); if (laeuft) requestAnimationFrame(schritt); };
  addEventListener('wheel', (e) => { if (e.ctrlKey) return; e.preventDefault(); if (!laeuft) { jetzt = ziel = scrollY; } ziel = Math.max(0, Math.min(document.documentElement.scrollHeight - innerHeight, ziel + e.deltaY)); if (!laeuft) { laeuft = true; requestAnimationFrame(schritt); } }, { passive: false });
})();
</script>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; } body { margin: 0; background: #000; color: #fff; font-family: var(--font-body); font-size: 20px; font-weight: 400; line-height: 1.45; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul, dl, dd { margin: 0; padding: 0; } ul { list-style: none; } a { color: inherit; } h1, h2, h3, .wm, nav { font-family: var(--font-display); text-transform: uppercase; }
  header { position: absolute; inset: 0 0 auto; z-index: 5; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 92px; padding: 0 56px; background: rgb(0 0 0 / .45); } nav { display: flex; gap: 26px; font-size: 16px; font-weight: 500; letter-spacing: .01em; } nav:last-child { justify-content: flex-end; } nav a { text-decoration: none; } nav a:hover { color: #c4c4c4; } .wm { font-size: 46px; font-weight: 700; letter-spacing: .05em; text-decoration: none; transform: rotate(-2deg); }
  .start { position: relative; height: 100vh; min-height: 560px; overflow: hidden; } .start img { filter: brightness(.82); animation: heran 24s ease-out both; } @keyframes heran { from { scale: 1.08; } } h1 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } .ab { position: absolute; left: 50%; bottom: 26px; translate: -50% 0; padding: 12px; } .ab svg { display: block; width: 30px; fill: none; stroke: #fff; stroke-width: 3; }
  .orte ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; padding: 56px 56px 0; } .orte a { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; text-decoration: none; text-align: center; } .orte img { position: absolute; inset: 0; transition: scale 1.2s cubic-bezier(.2,.7,.2,1), opacity .6s; } .orte .z { opacity: 0; } .orte a::after { content: ''; position: absolute; inset: 55% 0 0; background: linear-gradient(transparent, rgb(0 0 0 / .72)); } .orte .klein, .orte h2 { position: absolute; z-index: 1; left: 0; right: 0; transition: translate .5s cubic-bezier(.2,.7,.2,1); } .orte .klein { bottom: 74px; width: 120px; margin: 0 auto; font-family: var(--font-display); font-size: 17px; font-weight: 500; letter-spacing: .08em; fill: #fff; } .orte h2 { bottom: 26px; font-size: 32px; font-weight: 700; letter-spacing: -.01em; }
  .orte a:hover img, .orte a:focus-visible img { scale: 1.06; } .orte a:hover .z, .orte a:focus-visible .z { opacity: 1; } .orte a:hover h2, .orte a:hover .klein, .orte a:focus-visible h2, .orte a:focus-visible .klein { translate: 0 -14px; }
  .karte { margin: 56px 56px 0; padding: 50px 44px 60px; border: 4px solid #fff; } .karte > h2 { text-align: center; font-size: 40px; font-weight: 700; letter-spacing: -.01em; margin-bottom: 40px; } .sp { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; } h3 { font-size: 24px; font-weight: 700; margin: 28px 0 10px; } .sp > div > section:first-child h3 { margin-top: 0; } dl > div { display: flex; justify-content: space-between; gap: 18px; font-size: 16px; font-weight: 300; line-height: 1.75; color: #e4e4e4; } dd { font-weight: 600; white-space: nowrap; }
  .ueber { max-width: 760px; margin: 0 auto; padding: 90px 24px 100px; text-align: center; } .ueber h2 { font-size: 40px; font-weight: 700; margin-bottom: 22px; } .ueber p { font-size: 22px; font-weight: 300; margin-bottom: 18px; }
  footer { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 0 26px; padding: 24px 0 30px; border-top: 1px solid #5c5c5c; } .logo { display: grid; place-content: center; width: 54px; height: 54px; border: 3px solid #fff; border-radius: 50%; font-family: var(--font-display); font-size: 26px; font-weight: 700; } footer p { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 28px; font-size: 15px; } footer span:not(.logo) { color: #c4c4c4; }
  a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; } @media (prefers-reduced-motion: reduce) { .start img { animation: none; } * { transition: none !important; } }
  @media (max-width: 860px) { header { grid-template-columns: 1fr auto; height: 72px; padding: 0 16px; } header nav:first-child { display: none; } .wm { font-size: 34px; } .orte ul { grid-template-columns: 1fr; gap: 14px; padding: 16px 16px 0; } .orte a { aspect-ratio: 4 / 3; } .karte { margin: 26px 16px 0; padding: 28px 16px 34px; } .karte > h2 { font-size: 30px; } .sp { grid-template-columns: 1fr; gap: 28px; } .ueber { padding: 60px 20px; } .ueber p { font-size: 20px; } footer { margin: 0 16px; flex-direction: column; align-items: flex-start; } footer p { justify-content: flex-start; } }
</style>
</body></html>
