<footer><ul><li class="t">Menü</li><li>Home</li><li>Lösungen</li><li>Über uns</li><li>Kontakt</li></ul><ul><li class="t">Rechtliches</li><li>Impressum</li><li>Datenschutz</li><li>AGB</li></ul><ul><li class="t">Kontakt</li><li>Tel: +49 000 000 00</li><li>hallo@beispiel.de</li></ul><ul><li class="t">Social Media</li><li>Beispielinhalt einer Vorlage</li></ul></footer>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; } body { margin: 0; background: #fff; color: #0d2230; font-family: var(--font-body); font-size: 16px; line-height: 1.55; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul { margin: 0; padding: 0; font-weight: 400; } ul { list-style: none; } a { color: inherit; text-decoration: none; } h1, h2, h3, .wm { font-family: var(--font-display); font-weight: 500; line-height: 1.2; letter-spacing: -.01em; } h2 { font-size: clamp(28px, 3.4vw, 49px); } h3 { font-size: 22px; } p { color: #52626c; }
  .v, .l, .tel, .schwebe { display: inline-block; padding: 9px 18px; border-radius: 5px; font-weight: 500; font-size: 14px; } .v, .tel, .schwebe { background: #0b7a9e; color: #fff; } .l { box-shadow: inset 0 0 0 1.5px #0d2230; } .branche .l { box-shadow: inset 0 0 0 1.5px #0b7a9e; color: #096a89; }
  .schwebe { position: fixed; right: 18px; bottom: 16px; z-index: 20; } header { position: absolute; inset: 0 0 auto; z-index: 5; display: flex; align-items: center; gap: 28px; padding: 22px 80px; } .wm { font-size: 30px; font-style: italic; color: #52626c; } .wm b { color: #0b7a9e; font-weight: 500; } nav { display: flex; gap: 28px; margin-left: auto; font-size: 14px; font-weight: 500; } .an { color: #096a89; }
  .start { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; min-height: 900px; padding: 130px 80px 40px; background: #f3fafc; border-radius: 0 0 0 200px; overflow: hidden; } .ecke { position: absolute; left: 0; bottom: 0; width: 400px; height: 400px; border-radius: 50%; border: 14px solid #0b7a9e; clip-path: polygon(0 50%, 50% 50%, 50% 100%, 0 100%); } h1 { font-size: clamp(30px, 3.4vw, 49px); max-width: 680px; } .text p { max-width: 520px; margin: 22px 0; } .k { display: flex; gap: 14px; } .siegel { display: flex; gap: 12px; margin-top: 40px; } .siegel li { background: #fff; box-shadow: 0 2px 12px rgb(0 40 60 / .1); border-radius: 6px; padding: 10px 14px; font-size: 12px; color: #52626c; } .siegel b { display: block; font-size: 22px; color: #0d2230; }
  .portrait { position: relative; align-self: end; height: 680px; } .portrait span { position: absolute; left: 28%; bottom: 0; width: 66%; height: 66%; background: #0b7a9e; border-radius: 30px 60px 0 0; transform: skewX(-5deg); } .portrait img { position: absolute; left: 22%; bottom: 0; width: 62%; height: 100%; clip-path: inset(0 0 0 0 round 200px 200px 0 0); object-position: 50% 40%; } .team { position: absolute; left: 4%; bottom: 70px; width: 200px; background: #fff; padding: 14px 18px; border-radius: 8px; box-shadow: 0 4px 20px rgb(0 40 60 / .16); font-size: 14px; font-weight: 500; text-align: center; } .team b { display: block; color: #096a89; font-size: 24px; }
  .wand { text-align: center; padding: 90px 80px; } .wand h2 { font-size: 22px; font-weight: 500; } .wand ul { display: grid; grid-template-columns: repeat(6, 1fr); gap: 38px 30px; margin-top: 50px; font: 600 21px var(--font-display); color: #3a4a54; }
  .vorteil { padding: 30px 80px 60px; } .vorteil ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 36px; } .vorteil li { padding: 24px; border-radius: 12px; box-shadow: 0 0 0 1px #e3edf1; } .vorteil i { display: block; width: 40px; height: 40px; border-radius: 10px; background: #dff1f6; margin-bottom: 18px; } .vorteil h3 { font-size: 18px; margin-bottom: 10px; } .vorteil li p { font-size: 14px; }
  .leist { text-align: center; padding: 90px 80px; } .leist > h2 { max-width: 560px; margin: auto; } .leist > ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 50px; align-items: start; } .leist > ul > li:not(.spalte), .spalte article { padding: 24px; border-radius: 12px; box-shadow: 0 0 0 1px #e3edf1; } .leist li:nth-child(2) { margin-top: 30px; } .spalte { display: grid; gap: 14px; text-align: left; } .leist li p { font-size: 14px; margin-top: 8px; } .m { margin: 16px auto; } .lap { width: 70%; height: 160px; background: #dff1f6; border-radius: 8px 8px 0 0; border: 6px solid #0d2230; border-bottom: 0; } .tel2 { width: 150px; height: 240px; border: 6px solid #0d2230; border-radius: 22px; overflow: hidden; }
  .branche { position: relative; background: #f3fafc; text-align: center; padding: 110px 80px; border-radius: 0 200px 0 0; overflow: hidden; } .ecke2 { position: absolute; right: 0; top: 0; width: 400px; height: 400px; border-radius: 50%; border: 14px solid #0b7a9e; clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); } .m2 { max-width: 680px; margin: 16px auto 80px; font-size: 14px; } .zeile { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: center; text-align: left; max-width: 1110px; margin: 0 auto 90px; } .zeile h3 { font-size: 32px; } .zeile p { margin: 16px 0; font-size: 15px; } .hk li { padding-left: 24px; position: relative; margin-bottom: 6px; font-size: 14px; } .hk li::before { content: '✓'; position: absolute; left: 0; color: #096a89; font-weight: 700; } .zeile .l { margin-top: 20px; }
  .col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; perspective: 900px; } .col img { border-radius: 4px; transform: rotateY(-9deg); } .col .a { grid-row: 1 / 3; height: 420px; } .col .b, .col .c { height: 204px; } .col.r img { transform: rotateY(9deg); }
  .mitte { text-align: center; padding: 70px 0; } .mitte small { display: block; margin-top: 8px; }
  .wer { position: relative; display: grid; grid-template-columns: 1fr 1.15fr; gap: 60px; align-items: center; padding: 90px 80px; background: #f3fafc; border-radius: 0 120px 0 0; overflow: hidden; } .ecke3 { position: absolute; right: 0; top: 0; width: 240px; height: 240px; border-radius: 50%; border: 12px solid #0b7a9e; clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); } .wer p { margin-top: 18px; font-size: 15px; } .col2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; perspective: 900px; } .col2 img { height: 220px; border-radius: 4px; transform: rotateY(9deg); } .col2 .h { grid-column: 2; grid-row: 1 / 3; height: 452px; }
  .fragen { text-align: center; max-width: 700px; margin: auto; padding: 110px 20px; } details { border-bottom: 1px solid #e3edf1; padding: 14px 4px; text-align: left; } summary { display: flex; justify-content: space-between; align-items: center; list-style: none; cursor: pointer; font-size: 15px; font-weight: 500; } summary i { width: 12px; height: 12px; border-radius: 50%; background: #073a4e; } .fragen h2 { margin-bottom: 40px; }
  .ab { position: relative; overflow: hidden; background: #073a4e; color: #fff; text-align: center; border-radius: 0 200px 0 0; padding: 90px 80px; } .ab::before { content: ''; position: absolute; right: 0; top: 0; width: 400px; height: 400px; border-radius: 50%; border: 14px solid #0b7a9e; clip-path: polygon(50% 0, 100% 0, 100% 50%, 50% 50%); } .ab h2 { max-width: 640px; margin: auto; } .g3 { display: grid; grid-template-columns: 1fr 1.5fr 1fr; gap: 30px; margin-top: 50px; text-align: left; } .g3 li { padding: 0 0 34px; font-size: 14px; color: #d3e3ea; } .g3 b { display: block; color: #fff; font: 500 17px var(--font-display); margin-bottom: 6px; } .lappi { text-align: center; } .schirm { height: 250px; border: 8px solid #0d2230; border-radius: 12px 12px 0 0; overflow: hidden; } .unter { height: 18px; margin: 0 -22px 26px; background: #b7c6cd; border-radius: 0 0 14px 14px; } .lappi small { display: block; margin-top: 8px; color: #d3e3ea; }
  footer { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr; gap: 30px; padding: 60px 80px 90px; font-size: 14px; } .t { color: #096a89; font-weight: 500; font-size: 16px; margin-bottom: 8px; }
  @media (max-width: 760px) { header { padding: 16px; } nav { display: none; } .tel { margin-left: auto; font-size: 13px; padding: 7px 10px; } .start { grid-template-columns: 1fr; padding: 90px 16px 0; border-radius: 0 0 0 80px; min-height: 0; } .portrait { height: 400px; margin-top: 20px; } .k { flex-wrap: wrap; } .wand, .vorteil, .leist, .branche, .wer, .ab, footer { padding: 50px 16px; } .wand ul { grid-template-columns: repeat(3, 1fr); gap: 20px 10px; font-size: 15px; } .vorteil ul, .leist > ul, .zeile, .wer, .g3, footer { grid-template-columns: 1fr; gap: 24px; } .leist li:nth-child(2) { margin-top: 0; } .branche, .ab { border-radius: 0 80px 0 0; } .zeile.um .r { order: 2; } .col .a { height: 280px; } .col .b, .col .c { height: 134px; } .col2 img { height: 150px; } .col2 .h { height: 312px; } .unter { margin-inline: -10px; } .schirm { height: 190px; } .ecke, .ecke2, .ecke3, .ab::before { display: none; } }
</style>
</body></html>
