---
/**
 * Vorlage "system", Aufbau nach comito.de.
 * Dunkles Foto ueber die volle Hoehe, Kopfzeile transparent darauf, Titel links in drei
 * Zeilen, Fliesstext, roter Knopf, unten links Glaskarten, unten rechts Zahlen. Rote
 * zentrierte Titel, vier Spalten, Film mit Play, Puzzle aus Fotos und roten Flaechen,
 * Leistungen als Karten auf Grau, Fallstudie, Stimme mit Halbkreis, vier Schritte,
 * Foto-Band, rote Karte. Telefon und Mail seitlich, Kontaktknopf schwebt unten rechts.
 * Unterseiten nutzen denselben Kopf mit halber Hoehe.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>netzhaus</title></head>
<body>
<div class="seite"><a href="#" aria-label="Anrufen">✆</a><a href="#" aria-label="E-Mail">✉</a></div><a class="schwebe" href="#">Jetzt Kontakt aufnehmen</a>
<header><a class="wm" href="#"><i></i>netzhaus.</a><nav><a class="an" href="#">Home</a><a href="#">IT-Services ⌄</a><a href="#">Cloud ⌄</a><a href="#">KI ⌄</a><a href="#">Fallstudien</a><a href="#">Über uns</a><a href="#">Karriere</a><a href="#">Blog</a></nav><a class="rot" href="#">Kontakt</a></header>
<main>
  <section class="auftakt"><img src={b('1')} alt="Person am Laptop" /><div class="in"><h1>netzhaus ist Ihr IT-Dienstleister in Köln: Systemhaus mit umfassendem IT-Service und Support</h1><p>netzhaus betreut mittelständische Unternehmen mit 100 bis 1000 Mitarbeitern in den Bereichen Managed Services, Cloud und IT-Sicherheit, mit persönlichem Ansprechpartner an Ihrer Seite.</p><a class="rot" href="#">Erstberatung erhalten</a>
    <div class="fuss"><ul>{['Partner Infrastruktur','Partner Sicherheit','Ausgezeichnet, 20+ Bewertungen'].map((t) => <li>{t}</li>)}</ul><dl><div><dd>500+</dd><dt>durchgeführte Projekte</dt></div><div><dd>15+</dd><dt>Jahre Erfahrung</dt></div></dl></div></div></section>
  <div class="logos">{['JACK','Fabrik','Hansa','els','Nordbau','Stern','Suretec'].map((l) => <span>{l}</span>)}</div>
  <section class="vor"><h2>Mit zuverlässigem IT-Support zur sicheren, effizienten und sorgenfreien IT</h2><p class="m">Unser IT-Support sorgt dafür, dass Ihre Systeme sicher und störungsfrei laufen. Ein festes Team übernimmt die laufende Betreuung Ihrer Infrastruktur.</p><ul>{['Planbare IT-Kosten durch Flatrates','Nachhaltige Fehlererkennung','Hohe Systemverfügbarkeit von 99,9 %','Schnelle Einführung neuer Technik'].map((t) => <li><i></i><h3>{t}</h3><p>Ohne böse Überraschungen dank flexibler Modelle und klarer Absprachen.</p></li>)}</ul></section>
  <section class="film"><div><img src={b('91')} alt="" loading="lazy" /><h2>Jetzt netzhaus<br />kennenlernen</h2><button aria-label="Film abspielen"></button></div><a class="rot" href="#">Jetzt Erstberatung erhalten</a><small>100 % kostenfrei und unverbindlich</small></section>
  <section class="puzzle"><h2>4 Gründe, die für netzhaus als IT-Dienstleister sprechen</h2><div class="p"><img class="a" src={b('1')} alt="" loading="lazy" /><div class="r b"><h3>Schneller Support</h3><p>Unser verlässliches IT-Team reagiert binnen Minuten auf Ihre Anfragen.</p></div><div class="r c"><h3>Geschulte Fachleute für alle Themen aus einer Hand</h3><p>Unser Team besteht aus zertifizierten Fachkräften mit jahrelangem Wissen in Cloud, Netzwerk und Sicherheit.</p></div><div class="r d"><h3>Lösungen statt nur Technik</h3><p>Unsere Leistung besteht nicht darin, Ihre Systeme am Laufen zu halten, sondern Ihr Geschäft voranzubringen.</p></div><img class="e" src={b('60')} alt="" loading="lazy" /><img class="f" src={b('180')} alt="" loading="lazy" /><div class="r g"><h3>Vermittler zwischen Technik und Organisation</h3><p>Wir verstehen die Abläufe in Ihrem Haus und fungieren als kompetente Vermittler.</p></div></div></section>
  <section class="grau"><h2>Unsere IT-Dienstleistungen für Ihren Erfolg</h2><p class="m">Vollumfängliche IT-Lösungen für mittelständische Unternehmen von 100 bis 1000 Mitarbeitern.</p>
    {[['Cloud-Lösungen',['Cloud-Beratung','Microsoft 365','Azure Migration']],['IT-Services',['Managed Services','IT-Sicherheit','IT-Beratung','IT-Outsourcing','IT-Carve-Out']]].map(([t, l]) => <div class="gr"><div class="k"><h3>{t}</h3><a href="#">Alle anzeigen →</a></div><ul>{(l as string[]).map((x) => <li><b>{x}</b><i>→</i><p>Wir begleiten Sie mit klarem Vorgehen von der Strategie bis in den Betrieb.</p></li>)}</ul></div>)}</section>
  <section class="fall"><img src={b('60')} alt="" loading="lazy" /><h2>Referenzen: maßgeschneiderte IT-Lösungen für Unternehmen</h2><p class="m">In über 500 Projekten durften wir Kunden begleiten.</p><div class="bild"><img src={b('180')} alt="" loading="lazy" /><b>MUSTER AG</b></div></section>
  <section class="stimme"><i>“</i><p>Durch das Outsourcing der IT für unsere 13 Standorte konnten wir die Digitalisierung stark erhöhen und uns deutlich verbessern.</p><img src={b('64')} alt="" loading="lazy" /><b>Sven Beispiel</b><small>Geschäftsführer, Musterfirma</small></section>
  <section class="schritte"><h2>Sie sind nicht ganz zufrieden und unsicher, ob sich ein Wechsel lohnt?</h2><p class="m">Viele Unternehmen sind nicht zufrieden mit ihrem aktuellen Dienstleister, doch der Wechsel wirkt riskant.</p><ol>{['Kostenfreie Erstberatung','Detaillierte Analyse','Sorgfältige Übernahme','Laufende Betreuung'].map((t) => <li><h3>{t}</h3><p>Wir hören Ihnen zu und verstehen Ihre aktuelle Lage.</p></li>)}</ol><a class="rot" href="#">Jetzt Erstberatung erhalten</a></section>
  <section class="foto"><img src={b('164')} alt="" loading="lazy" /></section>
  <section class="abschluss"><div class="r"><h2>Ihr professionelles IT-Systemhaus aus Köln</h2><dl><div><dd>500+</dd><dt>Projekte</dt></div><div><dd>15+</dd><dt>Jahre Erfahrung</dt></div></dl></div><div class="tx"><blockquote>„Wir begleiten Sie mit Fachkompetenz, um Ihre IT sicher, effizient und zukunftsfähig auszurichten.“</blockquote><p>In unserem IT-Systemhaus in Köln betreuen wir seit 15 Jahren Kunden erfolgreich in der IT.</p></div></section>
</main>
<footer><b class="wm"><i></i>netzhaus.</b><p>Impressum · Datenschutz · Beispielinhalt einer Vorlage</p></footer>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; color: #111; background: #fff; font-family: var(--font-body); font-size: 16px; line-height: 1.5; overflow-x: clip; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; font-weight: 500; } p { font-weight: 400; } ul { list-style: none; } a { color: inherit; text-decoration: none; }
  h2 { font-size: clamp(26px, 3.1vw, 45px); line-height: 1.2; font-weight: 600; color: #cf3d1e; } .m { max-width: 800px; margin: 22px auto 0; text-align: center; font-size: 15px; } .rot { display: inline-block; background: #cf3d1e; color: #fff; padding: 9px 18px; border-radius: 4px; font-size: 14px; font-weight: 500; }
  header { position: absolute; inset: 0 0 auto; z-index: 5; display: flex; align-items: center; gap: 40px; padding: 0 64px; height: 80px; color: #fff; border-bottom: 1px solid rgb(255 255 255 / .12); } .wm { font-size: 26px; font-weight: 600; display: inline-flex; gap: 8px; align-items: center; } .wm i { width: 22px; height: 22px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #cf3d1e 45%, #fff 46% 50%, #cf3d1e 51%); } nav { display: flex; gap: 26px; font-size: 13.5px; margin-right: auto; } .an { color: #cf3d1e; }
  .seite { position: fixed; right: 0; top: 44%; z-index: 20; display: grid; gap: 8px; } .seite a { background: #cf3d1e; color: #fff; width: 40px; height: 40px; border-radius: 10px 0 0 10px; display: grid; place-items: center; } .schwebe { position: fixed; right: 64px; bottom: 26px; z-index: 20; background: #cf3d1e; color: #fff; padding: 9px 20px; border-radius: 4px; font-size: 14px; font-weight: 500; }
  .auftakt { position: relative; height: 900px; color: #fff; background: #0e1420; } .auftakt > img { position: absolute; inset: 0; filter: brightness(.42); } .in { position: relative; height: 100%; padding: 170px 64px 40px; display: flex; flex-direction: column; align-items: flex-start; } h1 { font-size: clamp(32px, 4.2vw, 60px); line-height: 1.22; font-weight: 600; max-width: 1040px; } .in > p { max-width: 830px; margin: 24px 0; font-size: 15.5px; }
  .fuss { margin-top: auto; width: 100%; display: flex; justify-content: space-between; align-items: flex-end; } .fuss ul { display: flex; gap: 10px; } .fuss li { width: 200px; height: 120px; padding: 16px; border-radius: 7px; background: rgb(167 167 167 / .2); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); font-size: 14px; } dl { display: flex; gap: 60px; margin: 0; } dd { font-size: 54px; font-weight: 500; line-height: 1; } dt { font-size: 13px; margin-top: 6px; }
  .logos { display: flex; justify-content: space-between; padding: 40px 100px; font-weight: 700; color: #333; font-size: 20px; }
  .vor { padding: 80px 90px; text-align: center; } .vor ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px; text-align: left; margin-top: 60px; } .vor i { display: block; width: 54px; height: 54px; border: 1px solid #e0e0e0; border-radius: 4px; margin-bottom: 20px; } .vor h3 { font-size: 18px; font-weight: 600; line-height: 1.25; } .vor li p { font-size: 14px; margin-top: 12px; }
  .film { text-align: center; padding: 20px 90px 90px; } .film div { position: relative; max-width: 1000px; height: 560px; margin: 0 auto 28px; border-radius: 8px; overflow: hidden; color: #fff; } .film h2 { position: absolute; left: 36px; top: 30px; color: #fff; text-align: left; } .film button { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 90px; height: 90px; border-radius: 50%; border: 0; background: #cf3d1e; } .film button::after { content: ''; position: absolute; left: 36px; top: 28px; border-left: 26px solid #fff; border-block: 17px solid transparent; } .film small { display: block; margin-top: 10px; }
  .puzzle { background: #f2f3f5; padding: 110px 90px; } .puzzle > h2 { max-width: 640px; margin-bottom: 40px; } .p { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 240px; } .r { background: #cf3d1e; color: #fff; padding: 28px; display: flex; flex-direction: column; justify-content: flex-end; font-size: 14px; } .r h3 { font-size: 20px; font-weight: 600; margin-bottom: 8px; line-height: 1.2; } .a { grid-area: 1 / 1 / 3 / 3; } .b { grid-area: 2 / 2; background: #a93118; } .c { grid-area: 1 / 3 / 3 / 5; } .d { grid-area: 3 / 1 / 5 / 2; } .e { grid-area: 3 / 2 / 5 / 3; } .f { grid-area: 3 / 3 / 4 / 5; } .g { grid-area: 4 / 3 / 5 / 5; }
  .grau { background: #f2f3f5; padding: 40px 90px 110px; text-align: center; } .gr { text-align: left; margin-top: 70px; } .k { display: flex; justify-content: space-between; margin-bottom: 26px; } .k h3 { color: #cf3d1e; font-size: 28px; font-weight: 600; } .k a { color: #b23216; font-size: 13px; } .gr ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; } .gr li { position: relative; background: #fff; padding: 24px; min-height: 240px; border-radius: 4px; } .gr b { font-size: 19px; font-weight: 500; } .gr i { position: absolute; right: 22px; top: 22px; font-style: normal; color: #cf3d1e; background: #fdeee9; padding: 0 8px; border-radius: 4px; } .gr p { margin-top: 60px; font-size: 14px; }
  .fall { background: #f2f3f5; text-align: center; padding-bottom: 90px; } .fall > img { height: 500px; } .fall h2 { max-width: 640px; margin: 90px auto 0; } .bild { position: relative; max-width: 840px; height: 480px; margin: 40px auto 0; color: #fff; } .bild b { position: absolute; inset: 0; display: grid; place-items: center; font-size: 60px; }
  .stimme { text-align: center; padding: 90px 20px; position: relative; } .stimme i { display: grid; place-items: center; width: 70px; height: 70px; margin: 0 auto 90px; border-radius: 50%; background: #cf3d1e; color: #fff; font-size: 44px; font-style: normal; } .stimme p { font-size: 36px; line-height: 1.2; max-width: 880px; margin: 0 auto 50px; } .stimme img { width: 60px; height: 60px; border-radius: 50%; margin: 0 auto 8px; } .stimme small { display: block; }
  .schritte { background: #f2f3f5; text-align: center; padding: 110px 90px; } .schritte h2 { max-width: 640px; margin: auto; } ol { list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; margin: 60px 0 40px; } ol li { counter-increment: s; } ol li::before { content: counter(s); display: grid; place-items: center; width: 44px; height: 44px; margin: 0 auto 20px; border: 1px solid #ddd; background: #fff; border-radius: 4px; color: #cf3d1e; } ol h3 { font-size: 17px; font-weight: 600; } ol p { font-size: 14px; }
  .foto { height: 620px; } .abschluss { display: grid; grid-template-columns: 1fr 1.1fr; gap: 80px; padding: 0 90px 110px; align-items: start; } .abschluss .r { margin-top: -90px; position: relative; padding: 40px; border-radius: 4px; color: #fff; } .abschluss h2 { color: #fff; font-size: 34px; margin-bottom: 40px; } .abschluss dd { font-size: 44px; } blockquote { margin: 40px 0 24px; padding-left: 20px; border-left: 2px solid #ddd; font-weight: 600; font-size: 20px; } 
  footer { display: flex; justify-content: space-between; align-items: center; padding: 30px 90px; background: #111; color: #fff; font-size: 14px; }
  @media (max-width: 760px) { header { padding: 0 16px; } nav { display: none; } header .rot { margin-left: auto; } .auftakt { height: auto; min-height: 100svh; } .in { padding: 110px 16px 30px; } .fuss { flex-direction: column; align-items: flex-start; gap: 20px; } .fuss ul { flex-wrap: wrap; } .fuss li { width: 46%; height: 90px; } .schwebe { right: 12px; bottom: 12px; } .logos { flex-wrap: wrap; gap: 16px; padding-inline: 16px; } .vor, .film, .puzzle, .grau, .schritte, .abschluss, footer { padding-inline: 16px; } .vor ul, .gr ul, ol { grid-template-columns: 1fr; } .film div { height: 300px; } .p { grid-template-columns: 1fr; grid-auto-rows: auto; } .p > * { grid-area: auto; min-height: 220px; } .abschluss { grid-template-columns: 1fr; gap: 20px; } .stimme p { font-size: 26px; } }
</style>
</body></html>
