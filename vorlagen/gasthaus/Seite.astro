---
/**
 * Vorlage "gasthaus", Aufbau nach zum-hecht.de.
 * Schwarz und Weiss im harten Wechsel, die Bilder tragen. Hohe schwarze Kopfzeile mit
 * gebrochener Wortmarke in der Mitte, Foto mit dunklen Raendern, Text und Rundknopf darauf.
 * Wortmarke und Oeffnungszeiten nebeneinander, Bild zwischen weissen Flaechen,
 * Kachelreihe mit Namen im Bild, Saetze in Versalien, Titel mit gerahmter Unterzeile,
 * enges Galerieraster, dunkler Kontakt mit Karte, Umgebung.
 * Die Kopffarbe liegt in --kopf: Der Nutzer will sie je Betrieb wechseln koennen.
 * Der Abschnitt "Termine" des Originals fehlt mit Absicht, er gefaellt dem Nutzer nicht.
 * Karussellpfeile und Einwilligungsleiste sind ebenfalls entfallen.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const galerie = ['999','835','627','292','431','429','995','312','395','635','625','437','674','326','225','102'];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Landgasthaus Zur Krone – seit 1829</title></head>
<body style="--kopf:#111">
<header><a class="rund" href="#" aria-label="Startseite"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12 12 5l8 7M7 11v8h10v-8" /></svg></a><nav aria-label="Links"><a href="#haus">Über uns</a><a href="#kueche">Kulinarisches</a><a href="#galerie">Galerie</a></nav><a class="wm" href="#"><b>Zur Krone</b><small>LANDGASTHAUS · SEIT 1829</small></a><nav aria-label="Rechts"><a href="#kontakt">Kontakt</a><a href="#umgebung">Umgebung</a></nav><span class="fb" aria-hidden="true"></span></header>
<main>
  <section class="start"><div class="seite"></div><div class="foto"><img src={b('999')} alt="Gedeckter Tisch" /><div><h1>Herzlich willkommen</h1><p>Hauptstraße 59 | 79353 Musterdorf</p><p>T +49 (0) 7000 000 | gast@krone.example</p><a href="#haus" aria-label="Weiter nach unten"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" /><path d="m7 10 5 5 5-5" /></svg></a></div></div><div class="seite"></div></section>
  <section class="haus" id="haus"><div><p class="gross">Zur Krone</p><p class="klein">LANDGASTHAUS</p><p class="seit">– SEIT 1829 –</p><p class="t">Tradition und Herzlichkeit: In der siebten Generation kochen wir hier im Dorf, was die Gegend hergibt. Eine lebendige Vielfalt frischer Kleinigkeiten, regionale Gerichte und immer ein Stück vom hausgemachten Kuchen.</p><p class="t"><i>„Gemütlich, ehrlich und mit viel Liebe zur Sache.“</i></p></div><div class="zeit"><h2>Mittwoch<br />Ruhetag</h2><p>Küche Do, Fr, Sa, Mo und Di</p><p class="s">17:00 – 21:00 Uhr</p><p class="s">So. &amp; Feiertag<br />11:30 – 13:45 Uhr<br />17:00 – 20:00 Uhr</p></div></section>
  <section class="fest"><img src={b('835')} alt="" loading="lazy" /></section>
  <section class="haus zwei"><p class="t">Parkplätze befinden sich im Innenhof. Mitglied im Verein der historischen Gasthäuser der Region.</p><div class="zeit"><h2>Wir richten auch gerne eure (Familien-)Feier aus</h2><p class="s">Unabhängig von unseren Öffnungszeiten</p></div></section>
  <section class="kueche" id="kueche"><div class="breit"><img src={b('292')} alt="" loading="lazy" /><h2>Regional</h2></div><ul><li><a href="#"><img src={b('625')} alt="" loading="lazy" /><span>Garten</span></a></li><li><a href="#"><img src={b('635')} alt="" loading="lazy" /><span>Tradition</span></a></li><li><a href="#"><img src={b('674')} alt="" loading="lazy" /><span>Wein</span></a></li></ul></section>
  <section class="fest band"><img src={b('395')} alt="" loading="lazy" /><h2>Gemeinsam feiern und genießen</h2></section>
  <section class="galerie" id="galerie"><div class="titel"><h2>Galerie</h2><p>Lust auf mehr</p></div><ul>{galerie.map((n) => <li><img src={b(n)} alt="" loading="lazy" /></li>)}</ul></section>
  <section class="kontakt" id="kontakt"><div class="titel"><h2>Kontakt</h2><p>Wir freuen uns auf Sie</p></div><div class="zw"><svg viewBox="0 0 520 300" role="img" aria-label="Karte der Umgebung"><rect width="520" height="300" fill="#2d2d2d" /><path d="M-10 210C120 170 180 90 300 110S460 40 530 60M90 -10c30 90 10 200 60 320M330 -10c-20 120 40 200 10 320M-10 70c130 20 250 120 540 150" fill="none" stroke="#505050" stroke-width="5" /><path d="M260 92c-14 0-24 10-24 23 0 18 24 42 24 42s24-24 24-42c0-13-10-23-24-23z" fill="#fff" /><circle cx="260" cy="115" r="8" fill="#2d2d2d" /></svg><address>Landgasthaus Zur Krone<br />Hauptstraße 59<br />79353 Musterdorf<br /><br />T +49 (0) 7000 000<br /><a href="#">gast@krone.example</a></address></div></section>
  <section class="umgebung" id="umgebung"><div class="titel"><h2>Umgebung</h2><p>Wein, Sonne, Hügel</p></div><div class="paar"><img src={b('946')} alt="" loading="lazy" /><img src={b('107')} alt="" loading="lazy" /></div><div class="text"><div><h3>Das Städtchen</h3><p>Die historische Altstadt lädt mit ihren kleinen Gässchen zum Entdecken und gemütlichen Bummeln ein.</p></div><div><h3>Die Weinberge</h3><p>Vor unserer Tür beginnt eines der sonnenreichsten Gebiete des Landes, mit vielen Wegen durch die Reben.</p></div></div></section>
</main>
<footer><a href="#">Impressum</a><a href="#">Datenschutz</a><span>Beispielinhalte, der Betrieb ist erfunden.</span></footer>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; scroll-padding-top: 110px; scroll-behavior: smooth; } body { margin: 0; background: #fff; color: #111; font-family: var(--font-body); font-size: 15px; line-height: 1.55; letter-spacing: .02em; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul { margin: 0; padding: 0; font-weight: 400; } ul { list-style: none; } a { color: inherit; text-decoration: none; } address { font-style: normal; }
  header { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: 40px 1fr auto 1fr 40px; align-items: center; gap: 30px; height: 132px; padding: 0 22px; background: var(--kopf); color: #fff; } .rund { width: 28px; height: 28px; border-radius: 50%; background: #fff; display: grid; place-content: center; } .rund svg { width: 18px; fill: none; stroke: var(--kopf); stroke-width: 2; } .fb { width: 28px; } nav { display: flex; gap: 36px; font-size: 13px; letter-spacing: .03em; } nav:last-of-type { justify-content: flex-end; } nav a:hover { text-decoration: underline; text-underline-offset: 5px; } .wm { display: grid; justify-items: center; line-height: 1; } .wm b { font-family: var(--font-mono); font-size: 54px; font-weight: 400; } .wm small { font-size: 10px; letter-spacing: .2em; margin-top: 6px; }
  .start { display: grid; grid-template-columns: 34px 1fr 34px; height: calc(100vh - 132px); min-height: 520px; background: #111; } .seite { background: #1f1f1f; } .foto { position: relative; overflow: hidden; color: #fff; text-align: center; } .foto img { filter: brightness(.72); } .foto > div { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; padding: 20px; } h1 { font-family: var(--font-display); font-size: clamp(32px, 4.2vw, 56px); font-weight: 700; line-height: 1.15; letter-spacing: .12em; text-transform: uppercase; max-width: 560px; margin-bottom: 18px; } .foto p { font-size: 20px; line-height: 1.45; } .foto a { margin-top: 18px; } .foto svg { display: block; width: 44px; fill: none; stroke: #fff; stroke-width: 1.4; }
  .haus { display: grid; grid-template-columns: 1.3fr 1fr; gap: 80px; max-width: 1200px; margin: 0 auto; padding: 90px 50px; } .gross { font-family: var(--font-mono); font-size: clamp(70px, 9vw, 130px); line-height: 1; text-align: center; } .klein { text-align: center; font-family: Georgia, serif; font-size: 30px; letter-spacing: .14em; margin-top: 10px; } .seit { text-align: center; font-size: 15px; letter-spacing: .1em; margin-bottom: 34px; } .t { font-size: 14px; color: #595959; margin-bottom: 14px; }
  .zeit { text-align: center; font-size: 15px; } h2 { font-family: var(--font-display); font-weight: 700; } .zeit h2 { font-family: var(--font-body); font-size: 32px; line-height: 1.5; text-transform: uppercase; letter-spacing: .02em; margin-bottom: 16px; } .zeit p { margin-bottom: 14px; text-transform: uppercase; } .zeit .s { font-size: 24px; line-height: 1.35; font-weight: 700; text-transform: none; }
  .fest { position: relative; height: 420px; } .fest > img { position: absolute; inset: 0; } .zwei { padding-block: 60px; align-items: center; } .zwei .zeit h2 { font-size: 28px; }
  .kueche ul { display: grid; grid-template-columns: repeat(3, 1fr); } .breit { position: relative; height: 640px; } .breit img, .kueche li img { filter: brightness(.55); transition: filter .3s, scale .6s; } .breit h2, .kueche span, .band h2 { position: absolute; color: #fff; text-transform: uppercase; } .breit h2 { left: 0; right: 0; top: 44%; text-align: center; font-family: var(--font-body); font-size: 26px; font-weight: 400; letter-spacing: .1em; } .kueche a { position: relative; display: grid; height: 320px; place-content: center; overflow: hidden; } .kueche li img { position: absolute; inset: 0; } .kueche a:hover img { filter: brightness(.7); scale: 1.04; } .kueche span { position: relative; font-size: 24px; letter-spacing: .1em; }
  .band { height: 370px; } .band > img { filter: brightness(.55); } .band h2 { inset: 45% 20px auto; text-align: center; font-family: var(--font-body); font-size: 28px; font-weight: 400; letter-spacing: .02em; }
  .titel { text-align: center; padding: 70px 20px 44px; } .titel h2 { font-size: clamp(32px, 3.5vw, 50px); line-height: 1.2; letter-spacing: .1em; text-transform: uppercase; } .titel p { display: inline-block; margin-top: 10px; padding: 3px 24px; font-size: 11px; letter-spacing: .3em; text-transform: uppercase; border-top: 1px solid currentColor; border-bottom: 1px solid currentColor; }
  .galerie ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; max-width: 1140px; margin: 0 auto; padding: 0 20px 90px; } .galerie li { aspect-ratio: 1; overflow: hidden; } .galerie img { transition: scale .5s; } .galerie li:hover img { scale: 1.05; }
  .kontakt { background: var(--kopf); color: #fff; padding-bottom: 90px; } .zw { display: grid; grid-template-columns: 1.5fr 1fr; gap: 60px; align-items: center; max-width: 1140px; margin: 0 auto; padding: 0 20px; font-size: 18px; } .zw svg { display: block; width: 100%; }
  .umgebung { padding-bottom: 80px; } .paar { display: grid; grid-template-columns: 1fr 2fr; gap: 12px; max-width: 1140px; margin: 0 auto; padding: 0 20px; height: 340px; } .text { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; max-width: 900px; margin: 44px auto 0; padding: 0 20px; text-align: center; } h3 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; } .text p { color: #595959; }
  footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 30px; padding: 24px; background: var(--kopf); color: #fff; font-size: 13px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; } @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { transition: none !important; } }
  @media (max-width: 860px) { header { grid-template-columns: 1fr; justify-items: center; height: auto; padding: 12px 16px; gap: 8px; position: static; } header nav:first-of-type, header nav:last-of-type { gap: 14px; justify-content: center; font-size: 12px; } .rund, .fb { display: none; } .wm b { font-size: 38px; } .wm { order: -1; } .start { grid-template-columns: 1fr; height: 76vh; } .seite { display: none; } .foto p { font-size: 16px; } .haus { grid-template-columns: 1fr; gap: 40px; padding: 50px 20px; } .fest { height: 260px; } .breit { height: 340px; } .kueche ul { grid-template-columns: 1fr; } .kueche a { height: 200px; } .band { height: 260px; } .galerie ul { grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 0 16px 60px; } .zw { grid-template-columns: 1fr; gap: 26px; } .paar { grid-template-columns: 1fr; height: auto; } .paar img { height: 220px; } .text { grid-template-columns: 1fr; gap: 26px; } }
</style>
</body></html>
