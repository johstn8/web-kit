---
/**
 * Vorlage "kurs", Aufbau nach scaly.com.
 * Weiss, Pfirsichflaechen mit kleinem Radius, Schwarz als Aktion, Orange als Marke.
 * Auftakt als abgesetzte Pfirsichkarte mit Person vor Orangebalken und schwebenden
 * Stichworten, darunter drei Nachweise. Foto im Kreis neben 2x2 Punkten und Haken,
 * schwarze Karte im Bild, organisch geformtes Foto, Pfirsichband mit Vorteilen, Reiter
 * fuer Bereiche, Kursdetails in vier Spalten, Werkzeugkacheln, Stimmen, gestaffeltes Team,
 * Fragen, orange-schwarzer Abschluss. Die Dachzeilen des Originals entfallen.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const bereiche = [
  ['Assistenten', 'Assistenten, die nicht nur antworten, sondern handeln', 'Teilnehmende bauen Helfer, die recherchieren, Wettbewerber analysieren und Berichte liefern.', '180'],
  ['Kundenservice', 'Anfragen, die sich zum großen Teil selbst beantworten', 'Häufige Fragen werden erkannt und vorbereitet, bevor jemand sie bearbeiten muss.', '3'],
  ['Automatisierung', 'Abläufe, die ohne Handarbeit durchlaufen', 'Wiederkehrende Aufgaben werden einmal gebaut und laufen danach von allein.', '60'],
  ['Marketing', 'Inhalte und Auswertungen in einem Bruchteil der Zeit', 'Von der Idee bis zum Bericht entsteht ein Ablauf, der zum Team passt.', '1'],
];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Lernwerk Akademie</title></head>
<body>
<header><a class="wm" href="#"><i></i><span>LERNWERK<small>AKADEMIE</small></span></a><nav><a href="#">Kurse ⌄</a><a href="#">Förderung ⌄</a><a href="#">Erfahrungen</a><a href="#">Über uns ⌄</a></nav><a class="rahmen" href="#">Beratung buchen</a></header>
<a class="chat" href="#" aria-label="Chat öffnen">?</a>
<main>
  <section class="start"><div class="text"><h1>Werde Daten-Spezialist, bis zu 100 % förderfähig und zertifiziert.</h1><p>Egal, ob du einen neuen Job anstrebst oder dein Team fit für die Zukunft machen willst: mit Lernwerk bekommst du praxisnahe Weiterbildung, gefördert über Bildungsgutschein.</p><a class="schwarz" href="#">Beratung vereinbaren</a></div>
    <div class="person"><span class="s1"></span><span class="s2"></span><span class="s3"></span><img src={b('64')} alt="Teilnehmerin" /><em class="c1">Karriere-Coaching</em><em class="c2">Automatisierung</em><em class="c3">Datenanalyse</em><em class="c4">Datenschutz</em></div></section>
  <ul class="beleg"><li><b>Zugelassen</b><span>Träger und Maßnahme</span></li><li><b>★★★★★ 4,8</b><span>Beispielwert aus Bewertungen</span></li><li><b>100 %</b><span>Förderfähig über Bildungsgutschein</span></li></ul>
  <section class="vier"><div class="kreis"><img src={b('64')} alt="" loading="lazy" /></div><div><h2>Mehr als ein Kurs</h2><ul class="punkte">{[['Automatisierung','Kein Theorieseminar: Du baust im Kurs echte Abläufe.'],['Werkzeuge','Du arbeitest mit den Programmen, die die Praxis nutzt.'],['Gemeinschaft','Lerne nicht allein, sondern in einer aktiven Gruppe.'],['Zertifikat','Anerkanntes Zertifikat, das deine Kenntnisse bestätigt.']].map(([t, x]) => <li><h3>{t}</h3><p>{x}</p></li>)}</ul><ul class="haken"><li>Wissen, das heute relevant ist</li><li>Du lernst, wie es in echten Firmen eingesetzt wird</li><li>Lernplattform, die überall läuft</li></ul></div></section>
  <section class="schwarzkarte"><img src={b('3')} alt="" loading="lazy" /><div><h2>Deine Weiterbildung.<br />Bis zu 100 % förderfähig.</h2><ul class="haken w"><li>Arbeitssuchend: bis zu 100 % Kursförderung</li><li>Angestellt: bis zu 75 % Kursförderung</li><li>Kostenfreie Förderberatung</li></ul></div><a class="weiss" href="#">Beratung vereinbaren</a></section>
  <section class="blob"><div><h2>Echtes Wissen.<br />Direkt aus der Industrie.</h2><p>Unser Praxispartner bringt Erfahrung aus großen Projekten mit. Unsere Inhalte entstehen nicht am Reißbrett, sondern gemeinsam mit Unternehmen.</p><ul class="haken"><li>Schulungsinhalte aus realen Projekten</li><li>Zugang zu aktuellen Trends</li></ul></div><div class="form"><img src={b('158')} alt="" loading="lazy" /></div></section>
  <section class="pfirsich"><h2>Was dir die Weiterbildung bringt</h2><ul>{['Jobcoaching bis in den neuen Job','Bis zu 100 % gefördert','In drei bis sechs Monaten fit','Gefragte Fähigkeiten, live gelernt'].map((t) => <li><i></i><h3>{t}</h3><p>Dein Jobcoach hilft dir im Einzelgespräch bei Lebenslauf, Bewerbung und Vorstellung.</p></li>)}</ul></section>
  <section class="bereiche"><h2>In diesen Bereichen erstellen unsere Teilnehmer Lösungen</h2><div class="reiter" data-reiter>{bereiche.map(([t], i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}><i></i>{t}</button>)}</div>{bereiche.map(([, h, x, n], i) => <div class="panel" data-panel={i} hidden={i !== 0}><img src={b(n)} alt="" loading="lazy" /><div><h3>{h}</h3><p>{x}</p></div></div>)}</section>
  <section class="erst"><h2>Kostenfreie Erstberatung vereinbaren</h2><p>Wir bieten dir eine kostenfreie Beratung zu deinem Förderbedarf und geben dir Einblicke in die Weiterbildung.</p><a class="schwarz" href="#">Jetzt Beratung vereinbaren</a></section>
  <section class="details"><h2>Dein Weg zum Spezialisten</h2><ul>{['Kursdetails','Was du lernst','Was du bekommst','Ideal für'].map((t) => <li><h3>{t}</h3><ul class="dot"><li>3 bis 6 Monate</li><li>In Vollzeit</li><li>Bis zu 100 % förderfähig</li><li>Abschlusszertifikat</li></ul></li>)}</ul></section>
  <section class="tools"><div><h2>Arbeiten mit führenden Werkzeugen</h2><p>In unserer Weiterbildung lernst du die Programme, die Unternehmen wirklich einsetzen.</p></div><ul>{['Werkzeug A','Werkzeug B','Werkzeug C','Werkzeug D','Werkzeug E','Werkzeug F','Werkzeug G','Werkzeug H'].map((t) => <li>{t}</li>)}</ul></section>
  <section class="stimmen"><h2>Das sagen Geschäftsführer und Teilnehmer</h2><ul>{[['91','Ich wollte, dass mein Team nicht hinterherläuft.'],['64','Unternehmen müssen heute ganz vorne mit dabei sein.']].map(([n, t]) => <li><div><img src={b(n)} alt="" loading="lazy" /><button aria-label="Film abspielen">▶</button></div><p>„{t}“</p><small>Beispielname, Geschäftsführung</small></li>)}</ul></section>
  <section class="team"><h2>Fachwissen von echten Experten</h2><ul>{[['91','Max Beispiel','Gründer'],['64','Lena Muster','Dozentin'],['177','Tom Probe','Dozent']].map(([n, t, r]) => <li><img src={b(n)} alt="" loading="lazy" /><b>{t}</b><small>{r}</small><p>Verfügt über zehn Jahre Erfahrung in der Beratung mit Schwerpunkt Daten.</p></li>)}</ul></section>
  <section class="fragen"><h2>Du hast noch offene Fragen?</h2>{['Ist die Weiterbildung wirklich kostenlos?','Ist die Beantragung kompliziert?','Wann starten die Kurse?','Ist mein Unternehmen förderfähig?'].map((f) => <details><summary>{f}<i>+</i></summary><p>Das klären wir im Erstgespräch für deine Lage.</p></details>)}<a class="schwarz" href="#">Jetzt Beratung vereinbaren</a></section>
  <section class="ende"><div><h2>Sichere dir jetzt deine kostenfreie Erstberatung</h2><a class="schwarz" href="#">Jetzt Beratung vereinbaren</a></div></section>
</main>
<footer><div><a class="wm" href="#"><i></i><span>LERNWERK<small>AKADEMIE</small></span></a><p>Dein Partner für praxisnahe Weiterbildung.</p></div>{['Angebot','Förderung','Ratgeber','Lernwerk'].map((t) => <ul><li class="t">{t}</li><li>Für Suchende</li><li>Für Unternehmen</li><li>Blog</li><li>Kontakt</li></ul>)}<p class="kl">Beispielinhalt einer Vorlage · Impressum · Datenschutz</p></footer>
<script is:inline>
(() => {
  const knoepfe = [...document.querySelectorAll('[data-reiter] button')], felder = [...document.querySelectorAll('[data-panel]')];
  knoepfe.forEach((k, i) => k.addEventListener('click', () => {
    knoepfe.forEach((x, j) => x.setAttribute('aria-pressed', String(i === j)));
    felder.forEach((f, j) => { f.hidden = i !== j; });
  }));
})();
</script>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; } body { margin: 0; background: #fff; color: #111; font-family: var(--font-body); font-size: 15px; line-height: 1.55; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul { margin: 0; padding: 0; font-weight: 400; } ul { list-style: none; } a { color: inherit; text-decoration: none; } h1, h2, h3, .wm, nav { font-family: var(--font-display); } h1, h2 { font-weight: 600; line-height: 1.2; letter-spacing: -.01em; } h2 { font-size: clamp(28px, 3.1vw, 45px); } h3 { font-weight: 500; }
  .schwarz, .weiss, .rahmen { display: inline-block; padding: 10px 20px; border-radius: 3px; font-family: var(--font-display); font-weight: 600; font-size: 14px; } .schwarz { background: #000; color: #fff; } .weiss { background: #fff; color: #000; } .rahmen { box-shadow: inset 0 0 0 1px #000; }
  header { display: flex; align-items: center; height: 100px; padding: 0 20px; } .wm { display: inline-flex; gap: 8px; align-items: center; font-weight: 600; letter-spacing: .14em; font-size: 20px; line-height: 1; } .wm small { display: block; font-size: 8px; letter-spacing: .3em; } .wm i { width: 22px; height: 34px; background: linear-gradient(160deg, #f26a21 50%, #f7b733 50%); clip-path: polygon(30% 0, 100% 0, 60% 45%, 100% 45%, 10% 100%, 35% 55%, 0 55%); } nav { display: flex; gap: 40px; margin: 0 auto 0 200px; font-size: 14px; font-weight: 500; } 
  .chat { position: fixed; right: 24px; bottom: 24px; z-index: 20; width: 48px; height: 48px; border-radius: 14px; background: #f26a21; color: #111; display: grid; place-items: center; font: 700 20px var(--font-display); }
  .start { position: relative; display: grid; grid-template-columns: 1.15fr 1fr; margin: 0 20px; min-height: 610px; background: #fff4e7; border-radius: 4px; overflow: hidden; } .text { padding: 70px 0 60px 66px; } h1 { font-size: clamp(32px, 3.4vw, 49px); max-width: 560px; } .text p { max-width: 640px; margin: 22px 0 28px; } .person { position: relative; } .person img { position: absolute; left: 22%; bottom: 0; width: 56%; height: 86%; border-radius: 300px 300px 0 0; object-position: 50% 20%; } .person span { position: absolute; bottom: 0; background: #f6935a; } .s1 { left: 2%; width: 13%; height: 34%; } .s2 { left: 74%; width: 14%; height: 72%; } .s3 { left: 88%; width: 8%; height: 58%; background: #f7c2a0 !important; } .person em { position: absolute; font-style: normal; background: #fff; padding: 4px 12px; border-radius: 4px; font: 500 13px var(--font-display); box-shadow: 0 4px 14px rgb(0 0 0 / .08); } .c1 { left: 56%; top: 8%; } .c2 { left: 2%; top: 22%; } .c3 { left: 0; top: 58%; } .c4 { right: 6%; top: 40%; }
  .beleg { display: flex; justify-content: center; gap: 80px; padding: 36px 20px 70px; } .beleg b { display: block; font-family: var(--font-display); font-size: 15px; } .beleg span { font-size: 13px; color: #555; }
  .vier { display: grid; grid-template-columns: 1fr 1.25fr; gap: 80px; padding: 40px 100px 90px; align-items: center; } .kreis { position: relative; aspect-ratio: 1; border-radius: 50%; background: #fbd9c1; overflow: hidden; } .punkte { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 40px; margin: 26px 0; } .punkte h3 { font-size: 22px; } .punkte p { font-size: 14px; color: #555; } .haken li { padding-left: 24px; position: relative; margin-bottom: 6px; } .haken li::before { content: '✓'; position: absolute; left: 0; color: #c2500f; font-weight: 700; } .haken.w li::before { color: #f6935a; }
  .schwarzkarte { position: relative; margin: 0 100px; min-height: 380px; border-radius: 4px; overflow: hidden; color: #fff; padding: 60px 50px; } .schwarzkarte img { position: absolute; inset: 0; filter: brightness(.3); } .schwarzkarte > div { position: relative; } .schwarzkarte ul { margin-top: 20px; } .weiss { position: absolute; right: 40px; bottom: 40px; }
  .blob { display: grid; grid-template-columns: 1.1fr 1fr; gap: 60px; align-items: center; padding: 110px 100px; } .blob p { margin: 20px 0; color: #555; } .form { height: 420px; clip-path: path('M60 150 C120 40 320 -10 470 20 C560 40 600 200 560 320 C520 410 360 430 230 410 C110 390 10 270 60 150Z'); }
  .pfirsich { background: #fff4e7; padding: 90px 100px; } .pfirsich ul { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; } .pfirsich li { background: #fff9f2; padding: 34px; border-radius: 4px; } .pfirsich i { display: block; width: 44px; height: 44px; border-radius: 50%; background: #fbd9c1; margin-bottom: 40px; } .pfirsich h3 { font-size: 24px; margin-bottom: 8px; }
  .bereiche { text-align: center; padding: 90px 100px; } .bereiche h2 { max-width: 720px; margin: auto; } .reiter { display: flex; justify-content: center; gap: 60px; margin: 40px 0; font: 500 14px var(--font-display); color: #6a6a6a; } .reiter button { background: none; border: 0; border-bottom: 2px solid transparent; padding: 0 0 8px; font: inherit; color: inherit; cursor: pointer; } .reiter i { display: block; width: 44px; height: 44px; margin: 0 auto 10px; background: #fbe6d5; border-radius: 10px; } .reiter [aria-pressed='true'] { color: #111; border-bottom-color: #111; } .panel[hidden] { display: none; } .panel { display: grid; grid-template-columns: 1fr 1.2fr; gap: 50px; align-items: center; text-align: left; background: #fff; border-radius: 6px; box-shadow: 0 0 0 1px #f4e7da; overflow: hidden; } .panel img { height: 300px; } .panel h3 { font-size: 26px; font-weight: 600; max-width: 420px; }
  .erst { text-align: center; padding: 70px 20px; } .erst p { max-width: 640px; margin: 18px auto 24px; }
  .details { padding: 60px 100px; } .details > ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 40px; } .details h3 { font-weight: 600; font-size: 15px; margin-bottom: 8px; } .dot li::before { content: '• '; color: #c2500f; }
  .tools { display: grid; grid-template-columns: 1fr 1.4fr; gap: 50px; padding: 90px 100px; } .tools p { margin-top: 18px; color: #555; } .tools ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; } .tools li { height: 100px; display: grid; place-items: center; background: #fff; box-shadow: 0 0 0 1px #eee; border-radius: 4px; font: 600 15px var(--font-display); }
  .stimmen { text-align: center; padding: 60px 100px; } .stimmen h2 { max-width: 520px; margin: auto; } .stimmen ul { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; text-align: left; } .stimmen li { padding: 22px; box-shadow: 0 0 0 1px #eee; border-radius: 4px; } .stimmen li > div { position: relative; height: 330px; margin-bottom: 18px; } .stimmen button { position: absolute; left: 16px; bottom: 16px; width: 54px; height: 54px; border-radius: 50%; border: 0; background: #f26a21; color: #111; font-size: 16px; } .stimmen li p { font-style: italic; }
  .team { background: #fff4e7; text-align: center; padding: 100px; } .team > ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px; margin-top: 50px; text-align: left; } .team li:nth-child(2) { margin-top: -30px; } .team img { height: 360px; margin-bottom: 14px; } .team b { display: block; font-family: var(--font-display); font-weight: 500; } .team small { color: #555; } .team li p { margin-top: 10px; font-size: 14px; }
  .fragen { max-width: 960px; margin: auto; text-align: center; padding: 110px 20px; } details { border-bottom: 1px solid #eee; padding: 18px 8px; text-align: left; } summary { display: flex; justify-content: space-between; list-style: none; cursor: pointer; font: 600 15px var(--font-display); } summary i { color: #c2500f; font-style: normal; } .fragen h2 { margin-bottom: 30px; } .fragen .schwarz { margin-top: 40px; }
  .ende { margin: 0 100px 60px; min-height: 340px; padding: 60px 50px; border-radius: 4px; background: linear-gradient(112deg, #f0651f 0 62%, #f7b733 62% 72%, #000 72%); color: #111; } .ende h2 { max-width: 480px; margin-bottom: 26px; }
  footer { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 30px; padding: 40px 100px 50px; font-size: 13px; } footer p { max-width: 280px; margin-top: 10px; } .t { color: #b5430a; margin-bottom: 8px; font-weight: 600; } .kl { grid-column: 1 / -1; max-width: none; }
  @media (max-width: 760px) { nav { display: none; } header { height: 76px; justify-content: space-between; padding: 0 16px; } .start { grid-template-columns: 1fr; margin: 0 12px; } .text { padding: 34px 22px; } .person { height: 340px; } .c2, .c3 { display: none; } .beleg { flex-direction: column; gap: 14px; padding: 28px 22px; } .vier, .blob, .panel, .tools, .stimmen ul, .team > ul, .pfirsich ul, .details > ul, footer { grid-template-columns: 1fr; } .vier, .blob, .pfirsich, .bereiche, .details, .tools, .stimmen, .team, footer { padding: 50px 16px; gap: 24px; } .punkte { grid-template-columns: 1fr; } .schwarzkarte, .ende { margin: 0 12px; padding: 34px 22px 90px; } .form { height: 300px; clip-path: none; border-radius: 40% 60% 55% 45%; overflow: hidden; } .reiter { flex-wrap: wrap; gap: 18px; } .tools ul { grid-template-columns: 1fr 1fr; } .team li:nth-child(2) { margin-top: 0; } .ende { margin-bottom: 30px; } }
</style>
</body></html>
