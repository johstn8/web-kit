---
/**
 * Vorlage "raster", Aufbau nach fokus.so/planer.
 * Weiss mit feinem Raster im Grund, das der Nutzer ausdruecklich gut fand. Zentrierter
 * Auftakt mit Knopf, Gesichterreihe und Bewertungszeile, danach Problemkarten, Ergebnisse,
 * Funktionen in einem Zweierraster mit Bildschirmausschnitten, Abschluss, Bewertungen
 * als Karten, zwei Pakete, der Entwickler mit Reichweite, Fragen.
 * Nicht uebernommen: die KI-erzeugten Bilder (hier Fotos als ehrliche Platzhalter), die
 * Rabatt-Pille ueber der H1 und das farbige Wort darin.
 * Das Original hat je Kategorie eine eigene Landingpage; diese Vorlage zeigt die erste.
 * Bildschirme sind CSS-Attrappen und werden im Projekt durch echte Screenshots ersetzt.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const Schirm = ['Wochenplan', 'Aufgaben', 'Gewohnheiten', 'Notizen'];
const stimmen = [['Jana Muster','Ein starkes, flexibles Werkzeug. Ich behalte endlich den Überblick über alle Abgaben.'],['Nico Beispiel','Gute Vorlage, sehr durchdacht. Hat mir den Start ins Semester viel leichter gemacht.'],['Mo Probe','Am Anfang braucht es etwas Zeit, danach will ich nicht mehr ohne arbeiten.'],['Alex Vorlage','Richtig durchdachtes System, das mir hilft, meine Ziele zu erreichen.'],['Lu Exempel','Endlich weiß ich morgens, was zuerst dran ist.'],['Kim Platz','Der Planer für Prüfungen ist allein schon den Preis wert.'],['Ida Muster','Klar aufgebaut und schnell eingerichtet.'],['Sam Beispiel','Seit Wochen täglich im Einsatz, ohne Durcheinander.']];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Takt – Planer für das Studium</title></head>
<body>
<header><a class="wm" href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 22 12 12 22 2 12z" /><path d="M12 7l5 5-5 5-5-5z" /></svg>Takt</a><nav aria-label="Hauptnavigation"><a href="#funktionen">Funktionen</a><a href="#stimmen">Bewertungen</a><a href="#preise">Preise</a><a href="#ich">Über mich</a></nav><a class="k leer" href="#">Anmelden</a><a class="k" href="#preise">Jetzt kaufen</a></header>
<main>
  <section class="start"><h1>Das Planungssystem, mit dem du dein Studium im Griff hast</h1><p>Steigere deine Konzentration beim Lernen, bleib organisiert und behalte den Überblick über Übungsblätter, Abgaben und Prüfungen.</p><a class="k" href="#funktionen">Mehr erfahren</a><p class="gs"><span>{['1027','1005','832','823','856'].map((n) => <img src={b(n)} alt="" />)}</span>Bereits mehr als 6.000 aktive Nutzer</p><p class="bw"><b>Ausgezeichnet</b><span aria-label="fünf Sterne">★★★★★</span>4,9 aus 170 Bewertungen bei <b class="g">Google</b></p></section>
  <section class="probleme"><h2>Kennst du das?</h2><ul class="vier">{[['1011','Du versuchst, Studium, Nebenjob und Freizeit unter einen Hut zu bringen.'],['338','Du bist überwältigt vom Lernstoff und weißt nicht, wo du anfangen sollst.'],['669','Du schiebst das meiste Lernen bis kurz vor die Prüfung.'],['823','Du musst ständig neue Themen lernen und kommst nicht zur Ruhe.']].map(([n, t]) => <li><img src={b(n)} alt="" loading="lazy" /><p>{t}</p></li>)}</ul></section>
  <section class="ergebnis"><h2>Fühlt sich das wie ein Traum an?</h2><ul class="vier">{[['1005','Du hast den Überblick über dein Studium und deine Ziele.'],['1027','Du weißt immer genau, was als Nächstes dran ist.'],['832','Du lernst rechtzeitig und bist auf Prüfungen vorbereitet.'],['856','Du schreibst gute Noten und hast trotzdem Freizeit.']].map(([n, t]) => <li><img src={b(n)} alt="" loading="lazy" /><p>{t}</p></li>)}</ul></section>
  <section class="funktionen" id="funktionen"><h2>Das Takt-System</h2><div class="zwei">{[['Modulares Dashboard','Alle Ziele, Aufgaben und Termine auf einen Blick, organisiert in deinem Tagesablauf.'],['Ziele in Schritten','Die Methode hilft dir, Ziele zu setzen und Schritt für Schritt umzusetzen.'],['Gewohnheiten','Steigere deine Selbstdisziplin und ersetze schlechte Gewohnheiten durch gute.'],['Morgen und Abend','Starte jeden Tag mit klarem Fokus und beende ihn mit einer ruhigen Routine.'],['Wissen sammeln','Ideen und Notizen sicher ablegen und jederzeit wiederfinden.'],['Kurs mit drei Stunden','Kurze Videos mit Tipps, wie du deinen Tag planst.']].map(([t, p], i) => <article><h3>{t}</h3><p>{p}</p><div class="schirm" aria-hidden="true"><div class="leiste"><i></i><i></i><i></i></div><aside>{Schirm.map((s, k) => <span class={k === i % 4 ? 'an' : ''}>{s}</span>)}</aside><div class="inhalt"><b></b>{[0,1,2,3,4].map((z) => <em style={`width:${88 - ((z * 17 + i * 11) % 40)}%`}></em>)}<div class="tabelle">{[0,1,2,3,4,5,6,7,8].map(() => <i></i>)}</div></div></div></article>)}</div></section>
  <section class="cta"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 22 12 12 22 2 12z" /><path d="M12 7l5 5-5 5-5-5z" /></svg><h2>Bereit für ein Semester mit Plan und Ruhe?</h2><a class="k" href="#preise">Ja, ich bin dabei</a></section>
  <section class="stimmen" id="stimmen"><h2>Mehr als 5.000 zufriedene Nutzer</h2><p class="u">Lies die Bewertungen und sieh, welche Erfahrungen andere gemacht haben.</p><p class="bw"><b>Ausgezeichnet</b><span aria-label="fünf Sterne">★★★★★</span>4,9 aus 170 Bewertungen bei <b class="g">Google</b></p>
    <ul>{stimmen.map(([n, t], i) => <li><p class="kopf"><span class="av" aria-hidden="true">{n[0]}</span><b>{n}</b><small>{`${(i % 9) + 3}. Oktober`}</small><span class="gl" aria-label="Google">G</span></p><p class="st" aria-label="fünf Sterne">★★★★★</p><p>{t}</p></li>)}</ul></section>
  <section class="preise" id="preise"><h2>Sichere dir das passende Paket</h2><p class="u">Alle Pakete enthalten die Vorlagen, Videoanleitungen und Zugang zum Support.</p><div class="paar">{[['Takt','Das flexible System, um deine Ziele schneller zu erreichen.',['Dashboard','Ziele in Schritten','Gewohnheiten','Morgen und Abend','Wissen sammeln','Videokurs'],'159','135',false],['Takt mit Studienplaner','Das ganze Paket für Studium, Abgaben und Prüfungen.',['Alles aus Takt','Termine und Prüfungen','Übungsblätter','Wiederholung in Abständen','Module und Punkte'],'199','169',true]].map(([t, p, l, alt, neu, beliebt]) => <article class={beliebt ? 'an' : ''}>{beliebt && <small class="bel">Beliebt</small>}<h3>{t}</h3><p>{p}</p><ul>{(l as string[]).map((x) => <li>{x}</li>)}</ul><p class="pr"><s>{alt} €</s><b>{neu} €</b></p><a class="k" href="#">{t} kaufen</a></article>)}</div></section>
  <section class="ich" id="ich"><img src={b('1005')} alt="Ben Muster" loading="lazy" /><div><h2>Hallo, ich bin Ben</h2><p>Nach dem Studium habe ich ein paar Jahre als Entwickler gearbeitet und nebenher einen Kanal über Planung aufgebaut. Takt ist das System, nach dem ich selbst seit Jahren arbeite.</p><ul class="reich"><li><b>252.000+</b>Video</li><li><b>35.200+</b>Bild</li><li><b>30.400+</b>Kurzvideo</li></ul></div></section>
  <section class="fragen"><h2>Häufige Fragen</h2><p class="u">Hier findest du Antworten auf die wichtigsten Fragen.</p>{[['Ist Takt für Studierende geeignet?','Ja, besonders mit dem Studienplaner.'],['Muss ich ein Abo abschließen?','Nein, du zahlst einmal.'],['Brauche ich Vorkenntnisse?','Nein, die Videos führen durch alles.'],['Kann ich in Raten zahlen?','Ja, an der Kasse.']].map(([f, a], i) => <details open={i === 0}><summary>{f}</summary><p>{a}</p></details>)}</section>
</main>
<footer><a class="wm" href="#"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 22 12 12 22 2 12z" /><path d="M12 7l5 5-5 5-5-5z" /></svg>Takt</a><p><a href="#">Impressum</a> · <a href="#">Datenschutz</a> · <a href="#">AGB</a></p><small>Beispielinhalte, das Produkt ist erfunden.</small></footer>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; } body { margin: 0; color: #16181d; font-family: var(--font-body); font-size: 16px; line-height: 1.55; background: #fff linear-gradient(#e9ecf1 1px, transparent 1px) 0 0 / 64px 64px, #fff linear-gradient(90deg, #e9ecf1 1px, transparent 1px) 0 0 / 64px 64px; background-blend-mode: multiply; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul { margin: 0; padding: 0; } ul { list-style: none; } a { color: inherit; text-decoration: none; }
  h1, h2 { font-family: var(--font-display); font-weight: 700; letter-spacing: -.02em; line-height: 1.12; } h2 { font-size: clamp(30px, 3.4vw, 50px); } h3 { font-size: 19px; font-weight: 700; } .u { color: #4b5260; margin-top: 10px; }
  .k { display: inline-block; padding: 14px 20px; border-radius: 8px; background: #2a72bb; color: #fff; font-weight: 600; border: 1px solid #2a72bb; transition: background .2s, translate .2s; } .k:hover { background: #2368b0; translate: 0 -1px; } .k.leer { background: #fff; color: #2368b0; }
  header { display: flex; align-items: center; gap: 14px; padding: 22px 4%; background: rgb(255 255 255 / .9); } .wm { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; font-size: 20px; margin-right: auto; } .wm svg, .cta svg { width: 30px; fill: #8bbbe8; stroke: #2a72bb; stroke-width: 1.3; } header nav { display: flex; gap: 30px; margin-right: auto; font-size: 15px; } header nav a:first-child { color: #2368b0; }
  .start { text-align: center; padding: 90px 24px 110px; } h1 { font-size: clamp(38px, 4.4vw, 62px); max-width: 860px; margin: 0 auto 26px; } .start > p:first-of-type { max-width: 640px; margin: 0 auto 30px; color: #4b5260; } .gs { margin: 30px 0 22px; font-size: 13px; color: #4b5260; } .gs span { display: flex; justify-content: center; margin-bottom: 8px; } .gs img { width: 36px; height: 36px; border-radius: 50%; border: 2px solid #fff; margin-left: -10px; } .gs img:first-child { margin: 0; } .bw { display: flex; justify-content: center; align-items: center; gap: 10px; font-size: 15px; } .bw b:first-child { text-transform: uppercase; letter-spacing: .04em; } .bw span { color: #f5b301; font-size: 20px; letter-spacing: 1px; } .g { color: #2a72bb; font-size: 20px; }
  .probleme, .ergebnis, .funktionen, .stimmen, .preise { padding: 90px 6%; } .ergebnis { background: rgb(248 249 250 / .85); } .vier { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 36px; } .vier li { background: #fff; border: 1px solid #e4e7ec; border-radius: 10px; overflow: hidden; } .vier img { height: 200px; } .vier p { padding: 18px; font-weight: 600; font-size: 15px; }
  .zwei { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; } .zwei article, .vier li, .inhalt, .stimmen li { min-width: 0; } .zwei article { background: #fff; border: 1px solid #e4e7ec; border-radius: 10px; padding: 30px 30px 0; text-align: center; overflow: hidden; } .zwei p { color: #4b5260; font-size: 14px; max-width: 420px; margin: 8px auto 26px; }
  .schirm { display: grid; grid-template-columns: 120px 1fr; grid-template-rows: 22px 1fr; height: 230px; border: 1px solid #dfe3ea; border-bottom: 0; border-radius: 8px 8px 0 0; background: #fff; text-align: left; box-shadow: 0 -6px 24px rgb(16 24 40 / .05); } .leiste { grid-column: 1 / -1; display: flex; gap: 5px; padding: 7px 10px; border-bottom: 1px solid #eef0f4; } .leiste i { width: 8px; height: 8px; border-radius: 50%; background: #dfe3ea; } .schirm aside { display: grid; align-content: start; gap: 6px; padding: 12px 10px; border-right: 1px solid #eef0f4; font-size: 11px; color: #5d6470; } .schirm aside .an { color: #16181d; font-weight: 700; } .inhalt { padding: 14px; display: grid; align-content: start; gap: 8px; } .inhalt b { width: 40%; height: 10px; border-radius: 3px; background: #16181d; } .inhalt em { height: 6px; border-radius: 3px; background: #e4e7ec; } .tabelle { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 6px; } .tabelle i { height: 26px; border-radius: 4px; background: #f1f4f8; border: 1px solid #e8ebf0; } .tabelle i:nth-child(5) { background: #e3eefa; border-color: #b9d3ee; }
  .cta { text-align: center; padding: 110px 24px; } .cta svg { width: 52px; margin: 0 auto 24px; display: block; } .cta h2 { max-width: 720px; margin: 0 auto 30px; }
  .stimmen { text-align: center; } .stimmen .bw { margin: 30px 0 34px; } .stimmen ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; text-align: left; } .stimmen li { background: #fff; border: 1px solid #e4e7ec; border-radius: 10px; padding: 18px; font-size: 14px; } .kopf { display: grid; grid-template-columns: 34px 1fr auto; column-gap: 10px; align-items: center; } .av { grid-row: span 2; width: 34px; height: 34px; border-radius: 50%; background: #2a72bb; color: #fff; display: grid; place-content: center; font-weight: 700; } .kopf small { color: #5d6470; } .gl { grid-row: 1; grid-column: 3; font-weight: 700; color: #2a72bb; } .st { color: #f5b301; margin: 8px 0 6px; }
  .preise { text-align: left; } .preise .paar { margin-left: 0; } .paar { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 980px; margin: 40px auto 0; text-align: left; } .paar article { background: #fff; border: 1px solid #e4e7ec; border-radius: 10px; padding: 30px; display: flex; flex-direction: column; } .paar article.an { border: 2px solid #2a72bb; } .bel { align-self: flex-start; margin-bottom: 10px; padding: 2px 8px; border-radius: 4px; background: #e3eefa; color: #2368b0; font-size: 12px; } .paar > article > p { color: #4b5260; font-size: 14px; margin: 8px 0 18px; } .paar ul { display: grid; gap: 8px; font-size: 14px; margin-bottom: 26px; } .paar li::before { content: '✓'; color: #2a72bb; margin-right: 10px; } .pr { margin-top: auto; display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; } .pr s { color: #b42318; font-size: 24px; } .pr b { font-size: 32px; } .paar .k { text-align: center; }
  .ich { display: grid; grid-template-columns: 380px 1fr; gap: 60px; align-items: center; padding: 90px 10%; } .ich img { height: 440px; border-radius: 10px; } .ich p { color: #4b5260; margin: 20px 0 30px; max-width: 620px; } .ich > div { min-width: 0; } .reich { display: flex; gap: 14px; } .reich li { min-width: 0; } .reich li { flex: 1; max-width: 170px; background: #fff; border: 1px solid #e4e7ec; border-radius: 10px; padding: 16px; font-size: 13px; color: #5d6470; } .reich b { display: block; font-size: 22px; color: #16181d; }
  .fragen { max-width: 860px; margin: 0 auto; padding: 60px 24px 110px; text-align: center; } details { text-align: left; border-bottom: 1px solid #e4e7ec; } details:first-of-type { margin-top: 30px; } summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; padding: 16px 0; font-size: 15px; } summary::-webkit-details-marker { display: none; } summary::after { content: '+'; } details[open] summary::after { content: '–'; } details p { padding-bottom: 16px; color: #4b5260; }
  footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; padding: 30px 4%; background: #fff; border-top: 1px solid #e4e7ec; font-size: 14px; } footer small { width: 100%; color: #5d6470; }
  a:focus-visible, summary:focus-visible { outline: 2px solid #2a72bb; outline-offset: 3px; } @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  @media (max-width: 860px) { header nav, .k.leer { display: none; } header { padding: 16px; } .start { padding: 60px 20px 70px; } .probleme, .ergebnis, .funktionen, .stimmen, .preise { padding: 60px 16px; } .vier { grid-template-columns: 1fr 1fr; gap: 10px; } .vier img { height: 140px; } .vier p { padding: 12px; font-size: 13px; } .zwei, .paar, .ich { grid-template-columns: 1fr; } .zwei article { padding: 22px 16px 0; } .schirm { grid-template-columns: 90px 1fr; } .stimmen ul { grid-template-columns: 1fr; } .bw { flex-wrap: wrap; } .ich { padding: 60px 20px; gap: 26px; } .ich img { height: 340px; } .reich { gap: 8px; } .reich li { padding: 12px 10px; } .reich b { font-size: 18px; } }
</style>
</body></html>
