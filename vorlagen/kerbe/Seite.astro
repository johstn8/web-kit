  .hell2 { background: #f2f6fb; text-align: center; padding: 20px 7% 120px; } .hell2 svg { display: block; width: min(820px, 100%); margin: 50px auto 0; } .tr path, .tr ellipse { fill: #f2f6fb; stroke: #6ea7dc; stroke-width: 1.2; } .s2 { fill: #46586b; font-size: 12px; }
