  .hell { background: #f2f6fb; text-align: center; padding: 100px 7% 120px; } .f { font-size: 19px; font-weight: 600; max-width: 620px; margin: 24px auto 16px; } .d { max-width: 760px; margin: 0 auto 50px; font-size: 14px; color: #46586b; } .drei { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 44px; text-align: left; } .drei li { background: #e4edf7; border-radius: 20px; padding: 26px; } .drei svg { width: 100%; height: 120px; margin-bottom: 24px; fill: none; stroke: #8fb4d9; stroke-width: 1.4; } .drei .b { stroke: #c6d8ea; } .drei p { font-size: 14px; color: #3f5367; margin-top: 12px; }
