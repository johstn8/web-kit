  .start { background: linear-gradient(170deg, #111728 10%, #0b2747 55%, #064276 100%); text-align: center; padding: 76px 24px 26px; } .start > * { position: relative; } .start .kerbe { position: absolute; } .start .ringe { position: absolute; } h1 { font-size: clamp(36px, 5vw, 72px); line-height: 1.1; letter-spacing: -.04em; font-weight: 500; max-width: 980px; margin: 0 auto 26px; text-wrap: balance; } .u { font-size: 20px; margin-bottom: 26px; } .k { max-width: 760px; margin: 0 auto 26px; font-size: 14px; color: #d7e4f1; } .marken { display: flex; justify-content: center; flex-wrap: wrap; gap: 26px; margin: 34px 0 26px; } .marken li { padding: 10px 18px; border-radius: 8px; background: #fff; color: #0c2d4d; font-size: 13px; font-weight: 700; } .g { font-size: 13px; color: #e8f0f8; } .g span { color: #fbbf24; margin: 0 6px; letter-spacing: 1px; }
