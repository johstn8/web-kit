---
/**
 * Vorlage "kerbe", Aufbau nach inno-one.de.
 * Eine Form zieht sich durch die Seite: gerundete dunkle Tafeln mit ausgeschnittener Kerbe
 * oben in der Mitte, wie die Kamerakerbe eines Laptops. Manrope leicht und eng gesetzt,
 * Blau auf Hellblau, feine Liniendiagramme statt Fotos: Kreise um eine Mitte, zwei
 * Trichter, Ringe. Bewertungszeile im Auftakt, Logos, Vergleich als versetzte Karten.
 * Kerbe: .kerbe liegt in jeder Tafel, Farbe aus --um (Grund darueber).
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const knoten = [[70,70,'Zielkunden'],[30,175,'Anfragen'],[70,285,'Marke'],[470,70,'Inhalte'],[520,175,'Vertrieb'],[470,285,'Abläufe']];
const W = [118, 100, 82, 64, 48, 34];
const schicht = (cx: number, y: number, a: number, c: number) => `M${cx - a} ${y}L${cx - c} ${y + 38}A${c} 11 0 0 0 ${cx + c} ${y + 38}L${cx + a} ${y}`;
const stufen = [0, 1, 2, 3, 4];
const faelle = [['Von zehn Anfragen zu planbarem Auftragseingang','Ein Softwarehaus lebte von Empfehlungen und hatte keinen eigenen Zugang zu Neukunden.','Gezielte Anzeigen und Inhalte für drei Entscheiderrollen, dazu ein klarer Ablauf im Vertrieb.','Neun von zehn Anfragen passen heute zum Wunschprofil.','MUSTERSOFT','42'],['Vom Empfehlungsgeschäft zur stabilen Pipeline','Ein Großhändler wollte unabhängig von wenigen Stammkunden werden.','Eigene Landingpages je Branche und eine Anzeigenstrecke über sechs Monate.','Der Vertrieb plant jetzt mit festen Zahlen statt mit Hoffnung.','Beispiel AG','180']];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>KURSACHT – Agentur für B2B-Anfragen</title></head>
<body>
<header><nav aria-label="Links"><a href="#leistung">Leistungen</a><a href="#faelle">Fallstudien</a><a href="#vergleich">Über uns</a></nav><a class="wm" href="#">KURS<b>ACHT</b></a><nav aria-label="Rechts"><a href="#">Karriere</a><a href="#">Wissen</a><a href="#kontakt">Kontakt</a><span class="sp">DE | EN</span></nav></header>
<main>
  <section class="tafel start" style="--um:#fff"><i class="kerbe"></i><div class="ringe" aria-hidden="true"></div><h1>Mehr kaufbereite Anfragen für B2B-Software und IT</h1><p class="u">Mit Anzeigen, Inhalten und einem klaren Weg vom ersten Klick zum Auftrag.</p><p class="k">Wir steigern die Nachfrage nach deinem Angebot, machen dich im Markt sichtbar und füllen deine Pipeline.</p><a class="p" href="#kontakt">Kostenlose Analyse vereinbaren <span aria-hidden="true">↗</span></a>
    <ul class="marken"><li>Anzeigen-Partner</li><li>Such-Partner</li><li>CRM-Partner</li></ul><p class="g"><b>Google</b> 4,9 <span aria-label="fünf Sterne">★★★★★</span> 117 Bewertungen</p></section>
  <section class="logos" aria-label="Kunden"><ul>{['mustersoft','HAUPT','Wandel','integral','NORDLICHT','OPUS','REGA','vanta','Frankfurt Data','beispiel'].map((n) => <li>{n}</li>)}</ul></section>
  <section class="hell" id="leistung"><h2>Warum das Wachstum im B2B stockt</h2><p class="f">Lange Verkaufszyklen, steigende Kosten und unpassende Anfragen bremsen dich.</p><p class="d">Viele Technikfirmen kämpfen mit Marketing, das weder Anfragen bringt noch die Bekanntheit steigert. Wir kennen diese Hürden und bieten eine Strategie, die Pipeline und Kunden bringt.</p>
    <ul class="drei">
      <li><svg viewBox="0 0 240 90" aria-hidden="true"><path d="M6 60 60 44l44 16 44-40 44 30 46 8" /><path d="M6 72h228" class="b" /></svg><h3>Endloses Warten auf Abschlüsse?</h3><p>Lange Wege bis zur Unterschrift binden Zeit. Wir verkürzen sie, indem Entscheider früh wissen, wer du bist.</p></li>
      <li><svg viewBox="0 0 240 90" aria-hidden="true">{[0,1,2,3,4].map((i) => <rect x={10 + i * 46} y="10" width="36" height="70" rx="8" opacity={1 - i * .17} />)}</svg><h3>Die Botschaft trifft nicht?</h3><p>Allgemeine Ansprache verpufft. Wir entwickeln Inhalte für die Probleme deiner Zielgruppe.</p></li>
      <li><svg viewBox="0 0 240 90" aria-hidden="true">{[0,1,2,3,4].map((i) => <path d={`M10 ${14 + i * 15}h${220 - i * 36}`} />)}</svg><h3>Viele Anfragen, wenig Ergebnis?</h3><p>Es geht nicht um Masse. Wir bringen dir die Firmen, die wirklich kaufen wollen.</p></li></ul><a class="p" href="#kontakt">Kostenlose Analyse vereinbaren <span aria-hidden="true">↗</span></a></section>
  <section class="tafel nacht" style="--um:#f2f6fb"><i class="kerbe"></i><div><h2>Alles, was dein Wachstum braucht</h2><h3>Ein System statt einzelner Kampagnen</h3><p>Wir verbinden Nachfrage, Zielkundenansprache und Inhalte so, dass aus Interesse Gespräche und aus Gesprächen Aufträge werden.</p></div>
    <svg class="netz" viewBox="0 0 600 360" role="img" aria-label="Schema: sechs Bausteine laufen in einer Mitte zusammen">{[60,100,140].map((r) => <circle cx="300" cy="178" r={r} class="r" />)}{knoten.map(([x, y]) => <path d={`M${x} ${y} C${(Number(x) + 300) / 2} ${y} ${(Number(x) + 300) / 2} 178 300 178`} class="l" />)}<circle cx="300" cy="178" r="36" class="m" /><text x="300" y="183" text-anchor="middle" class="t">ACHT</text>{knoten.map(([x, y, t]) => <g><circle cx={x} cy={y} r="9" class="n" /><text x={Number(x) < 300 ? Number(x) - 16 : Number(x) + 16} y={Number(y) + 5} text-anchor={Number(x) < 300 ? 'end' : 'start'} class="s">{t}</text></g>)}</svg></section>
  <section class="liste"><div><h2>Nachfrage schaffen</h2><h3>Eine Pipeline, die zu mehr Wachstum führt</h3></div><ol data-leiste>{[['Qualität statt Masse','Uns geht es nicht um möglichst viele Kontakte, sondern um kaufbereite Firmen.'],['Messbarer Ertrag','Jede Maßnahme zahlt auf ein Ziel ein, das du in Euro nachrechnen kannst.'],['Kürzere Verkaufswege','Dein Vertrieb spricht mit Leuten, die schon wissen, was du tust.'],['Persönliche Betreuung','Wir begleiten nur eine Firma je Branche und kennen dein Geschäft.']].map(([t, p]) => <li><h4>{t}</h4><p>{p}</p></li>)}</ol></section>
  <section class="vergleich hell2"><h2>Klassischer Trichter gegen gezielte Ansprache</h2><svg viewBox="0 0 720 340" role="img" aria-label="Zwei Trichter: links schmal zulaufend, rechts von wenigen Firmen zu mehr Abschlüssen">{stufen.map((i) => <g class="tr"><path d={schicht(205, 24 + i * 60, W[i], W[i + 1])} /><ellipse cx="205" cy={24 + i * 60} rx={W[i]} ry="11" /></g>)}{stufen.map((i) => <g class="tr"><path d={schicht(515, 24 + i * 60, W[5 - i], W[4 - i])} /><ellipse cx="515" cy={24 + i * 60} rx={W[5 - i]} ry="11" /></g>)}{['Zielgruppe','Interesse','Pflege','Anfrage','Abschluss'].map((t, i) => <text x="12" y={50 + i * 60} class="s2">{t}</text>)}{['Auswahl','Kontakt','Pflege','Gespräch','Abschluss'].map((t, i) => <text x="708" y={50 + i * 60} text-anchor="end" class="s2">{t}</text>)}</svg></section>
  <section class="tafel blau" style="--um:#f2f6fb"><i class="kerbe"></i><div class="ringe" aria-hidden="true"></div><h2>Zeit, dass deine Pipeline Überstunden macht</h2><p>Bereit, die Nachfrage nach deinem Angebot deutlich zu erhöhen? Dann vereinbare jetzt deine kostenlose Analyse.</p><a class="p" href="#kontakt">Kostenlose Analyse vereinbaren <span aria-hidden="true">↗</span></a></section>
  <section class="kreis"><div><h2>Gezielte Ansprache mit größter Wirkung</h2><p>Dein Markt ist überschaubar. Wir erreichen die Menschen, die entscheiden, dort, wo sie arbeiten.</p><ul class="punkte"><li><b>Präzise Auswahl:</b> deine Wunschkunden im Blick</li><li><b>Persönliche Ansprache:</b> weniger Streuverlust</li></ul></div>
    <svg viewBox="0 0 460 400" role="img" aria-label="Ringe um die Mitte mit zwei Hinweisen">{[70,120,170].map((r, i) => <circle cx="230" cy="200" r={r} class="r2" stroke-dasharray={i === 2 ? '3 7' : 'none'} />)}<text x="230" y="212" text-anchor="middle" class="t2">ACHT</text><g class="chip"><rect x="240" y="20" width="200" height="50" rx="14" /><circle cx="262" cy="45" r="8" /><text x="282" y="50">Präzise Auswahl</text></g><g class="chip"><rect x="10" y="240" width="210" height="50" rx="14" /><circle cx="32" cy="265" r="8" /><text x="52" y="270">Persönliche Ansprache</text></g></svg></section>
  <section class="weg"><h2>Dein Weg zur starken Marke.<br />Nachhaltig und messbar</h2><ul>{[['Nachfrage schaffen','Wir wecken Interesse und sorgen für Bindung, bevor gekauft wird.'],['Automatisch nachfassen','Abläufe führen Interessenten durch die ganze Reise.'],['Anfragen, die kaufen','Wer sich meldet, passt zu deinem Angebot.'],['Inhalte, die binden','Beiträge und Fallstudien sprechen die Sorgen deiner Kunden an.'],['Präsenz im Markt','Du wirst zur Marke, die man in deiner Nische kennt.'],['Bleibender Erfolg','Kundenbindung sorgt für dauerhaften Umsatz.']].map(([t, p], i) => <li><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="15" /><path d={i % 2 ? 'M12 26 18 18l5 4 6-9' : 'M20 8v24M8 20h24'} /></svg><h3>{t}</h3><p>{p}</p></li>)}</ul></section>
  <section class="vs" id="vergleich"><h2>KURSACHT: die erste Wahl für B2B-Software und IT</h2><p>Maßgeschneidert und messbar zu mehr Umsatz.</p><div class="paar"><article class="a"><h3>Andere Anbieter</h3><ul>{['Bieten von allem ein bisschen','Arbeiten mit Standardlösungen','Liefern Berichte statt Ergebnisse','Kennen deine Branche nur oberflächlich'].map((t) => <li>{t}</li>)}</ul></article><article class="w"><h3>Wir</h3><ul>{['Spezialisiert auf B2B-Software und IT','Kampagnen, die für dich gebaut sind','Ausgerichtet auf Umsatz und Abschlüsse','Wir sprechen die Sprache deiner Kunden'].map((t) => <li>{t}</li>)}</ul></article></div></section>
  <section class="faelle" id="faelle"><h2>Erfolg, der überzeugt:<br />unsere Fallstudien</h2>{faelle.map(([t, a, b2, c, l, n]) => <article><div><h3>{t}</h3><h4>Herausforderung</h4><p>{a}</p><h4>Lösung</h4><p>{b2}</p><h4>Ergebnis</h4><p>{c}</p></div><figure><img src={`./bilder/${n}.webp`} alt="" loading="lazy" /><figcaption>{l}</figcaption></figure></article>)}</section>
  <section class="tafel nacht schluss" id="kontakt" style="--um:#f2f6fb"><i class="kerbe"></i><h2>Lerne die Methode kennen, die dich zur ersten Wahl macht</h2><a class="p" href="#">Kostenlose Analyse vereinbaren <span aria-hidden="true">↗</span></a></section>
</main>
<footer><a class="wm" href="#">KURS<b>ACHT</b></a><p>Musterstraße 10, 20095 Hamburg</p><p><a href="#">Impressum</a> · <a href="#">Datenschutz</a></p><small>Beispielinhalte, die Firma ist erfunden.</small></footer>
<script is:inline>
(() => {
  const f = document.querySelector('[data-leiste]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const z = () => { const r = f.getBoundingClientRect(); f.style.setProperty('--p', Math.min(1, Math.max(0, (innerHeight * .7 - r.top) / r.height))); };
  addEventListener('scroll', z, { passive: true }); z();
})();
</script>
