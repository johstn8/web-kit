---
/**
 * Vorlage "kongress", Aufbau nach ko-mon.de.
 * Pfirsichgrund, Glaspille als Kopfzeile ueber dem Foto, Titel unten links auf dem Bild.
 * Zentrierter Satz faerbt sich beim Scrollen ein, Bild waechst, vier Zahlen mit
 * Trennlinien, Titel mit einem Wort in Orange, vier Spalten mit Foto, Vollbild mit Knopf
 * oben, grosser Titel links und Aufklapper, klebende Vollbilder, Ticketkarte, gestaffelte
 * Stimmen, Preisblock, Ort, Teilnehmerzahlen, blauer Fuss.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const satz = 'Der Fachtag ist der Kongress für alle, die Betriebe am Laufen halten. Hier treffen sich Fachleute aus Planung, Technik und Anwendung zum Austausch von Wissen und Erfahrung.'.split(' ');
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Fachtag Leitstand</title></head>
<body>
<header class="kopf"><a class="logo" href="#">fach:tag</a><nav><a href="#">Start</a><a href="#">Agenda</a><a href="#">Aussteller</a><a href="#">Über uns</a><a href="#">Rückblicke</a></nav><a class="r" href="#">Kontakt</a><a class="t" href="#">Tickets</a></header>
<main>
  <section class="start"><img src={b('158')} alt="Bühne mit Scheinwerfern" /><div><h1>Kongress für Technik<br />und gute Leitstände</h1><p>Fachtag Leitstand · Mittwoch, 22. bis Donnerstag, 23. September in Bremen</p><p class="k"><a class="o" href="#">Ticket sichern</a><a class="g" href="#">Mehr erfahren</a></p></div></section>
  <section class="licht" data-licht><p>{satz.map((w) => <><span>{w}</span> </>)}</p></section>
  <div class="wachsen"><img src={b('192')} alt="" /></div>
  <ul class="zahlen"><li><b>3.600+</b>Teilnehmer</li><li><b>260+</b>Vorträge</li><li><b>45+</b>Top-Speaker</li><li><b>18+</b>Jahre Fachtag</li></ul>
  <section class="nutzen"><h2>Davon <em>profitierst</em> du</h2><p class="m">Beim Fachtag erwartet dich mehr als nur ein Kongress. Hier bekommst du die Chance, dich weiterzuentwickeln.</p>
    <ul>{[['Erhalte Einblicke in Trends und neue Technik','91'],['Finde praktische Lösungen für den Alltag','60'],['Steigere Effizienz und Wissen','3'],['Knüpfe wertvolle Kontakte','42']].map(([t, n]) => <li><h3>{t}</h3><img src={b(n)} alt="" loading="lazy" /><p>Du erhältst konkrete Lösungen, die du direkt im Arbeitsalltag umsetzen kannst.</p></li>)}</ul></section>
  <section class="band"><img src={b('158')} alt="" /><a class="o" href="#">Jetzt Ticket sichern</a></section>
  <section class="themen"><div class="kopfz"><h2>Inhalte <em>&amp;</em> Themen<br />des Fachtags</h2><p>Hier bekommst du einen Überblick, welche Themen dich erwarten und was die Branche aktuell bewegt.</p></div>
    {[['Planung & Konzeption','Der Weg zur perfekten Anlage'],['Sicherheit & Abwehr','Fachleute warnen vor Gefahren'],['Technik & Betrieb','Arbeit im Alltag komfortabel gestalten'],['Trends & Visionen','Was hält die Zukunft bereit?']].map(([t, x]) => <details><summary><b>{t}</b><small>{x}</small><i>+</i></summary><p>Vorträge, Workshops und Gespräche zu diesem Thema.</p></details>)}</section>
  <section class="klebe">
    {[['Fachvorträge von Keynote-Speakern','158'],['Fachausstellung mit neuer Technik','60'],['Vernetzung mit Fachleuten','192']].map(([t, n]) => <div><img src={b(n)} alt="" loading="lazy" /><h2>{t}</h2><p>Freu dich auf spannende Einblicke direkt aus der Praxis.</p></div>)}
  </section>
  <section class="ticket"><img src={b('192')} alt="" /><h2>Tickets <em>jetzt</em> verfügbar</h2><p>Aufgrund der Raumkapazität gibt es nur 250 Plätze.</p><div><span>September</span><b>22.–23.</b><a class="o" href="#">Ticket sichern</a><b>2027</b><span>Bremen</span></div></section>
  <section class="stimmen"><h2>Teilnehmer <em>Feedback</em></h2><div class="cols">{Array.from({ length: 9 }).map((_, i) => <article style={`--l:${[3, 2, 4, 2, 5, 3, 3, 2, 4][i]}`}><span>★★★★★</span><p>{'Eine rundum gelungene Veranstaltung in entspannter Atmosphäre. '.repeat(Math.ceil([3, 2, 4, 2, 5, 3, 3, 2, 4][i] / 2))}</p><b>Beispielname</b><small>Beispielfirma GmbH</small></article>)}</div></section>
  <section class="preis"><h2>Sichere dir deine Teilnahme aus<br /><em>nur 250 verfügbaren Tickets</em></h2><div class="pk"><small>Essential Pass</small><b>590 €</b><a class="o" href="#">Jetzt Ticket kaufen</a><ul><li>Alle Fachvorträge erleben</li><li>Zutritt zur Fachausstellung</li><li>Abendveranstaltung inklusive</li></ul></div></section>
</main>
<footer><b class="logo">fach:tag</b><ul><li>Start</li><li>Agenda</li><li>Über uns</li></ul><ul><li>Impressum</li><li>Datenschutz</li></ul><ul><li>Beispielstraße 1</li><li>hallo@beispiel.de</li></ul></footer>
<script is:inline>
(() => {
  // Gemessen an ko-mon.de (gsap): je Zeile ein Farbverlauf, der von links nach rechts
  // laeuft, 2,9 s je Zeile, 0,4 s Versatz, an den Scroll gebunden von "Oberkante bei
  // 70 % der Hoehe" bis "Unterkante bei 60 %", mit Nachlauf (scrub 2).
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const felder = [...document.querySelectorAll('[data-licht] p')];
  if (!felder.length) return;
  document.documentElement.classList.add('licht-an');
  const zeilen = (f) => { const w = [...f.querySelectorAll('span')], z = []; let oben = null; for (const s of w) { const t = s.offsetTop; if (oben === null || Math.abs(t - oben) > 4) { z.push([]); oben = t; } z[z.length - 1].push(s); } return z.map((ws) => ({ ws, links: ws[0].offsetLeft, breite: ws[ws.length - 1].offsetLeft + ws[ws.length - 1].offsetWidth - ws[0].offsetLeft })); };
  const daten = felder.map((f) => ({ f, z: zeilen(f), jetzt: 0 }));
  addEventListener('resize', () => daten.forEach((d) => { d.z = zeilen(d.f); }));
  const ziel = (f) => { const r = f.getBoundingClientRect(), h = innerHeight; return Math.min(1, Math.max(0, (h * .7 - r.top) / (h * .1 + r.height))); };
  const schritt = () => {
    for (const d of daten) {
      d.jetzt += (ziel(d.f) - d.jetzt) * .06;
      const n = d.z.length, gesamt = 2.9 + .4 * (n - 1), t = d.jetzt * gesamt;
      d.z.forEach((z, i) => { const p = Math.min(1, Math.max(0, (t - .4 * i) / 2.9)), x = z.links + p * z.breite; for (const s of z.ws) s.style.setProperty('--f', String(Math.min(1, Math.max(0, (x - s.offsetLeft) / s.offsetWidth)))); });
    }
    requestAnimationFrame(schritt);
  };
  schritt();
})();
(() => {
  // Kopfzeile: verschwindet beim Abwaertsscrollen (gemessen: translateY -110 px in den ersten 600 px), kommt beim Hochscrollen zurueck.
  const k = document.querySelector('.kopf'); let vor = scrollY;
  addEventListener('scroll', () => { const y = scrollY; k.classList.toggle('weg', y > 120 && y > vor); vor = y; }, { passive: true });
})();
</script>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; background: #fef5f1; color: #111; font-family: var(--font-body); font-size: 17px; line-height: 1.45; overflow-x: clip; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul { margin: 0; padding: 0; font-weight: 500; } ul { list-style: none; } a { color: inherit; text-decoration: none; } em { font-style: normal; color: #d9571f; }
  h2 { font-size: clamp(38px, 5vw, 72px); line-height: 1.12; letter-spacing: .01em; } .o { display: inline-block; background: #ed6c34; color: #111; padding: 10px 22px; border-radius: 40px; font-weight: 500; font-size: 15px; }
  .kopf { position: fixed; top: 24px; left: 50%; translate: -50% 0; z-index: 30; transition: translate .4s ease; } .kopf.weg { translate: -50% calc(-100% - 40px); } .kopf nav a { display: inline-block; transition: transform .4s; } .kopf nav a:hover { transform: scale(1.2); } .kopf .r { transition: background .3s, color .3s; } .kopf .r:hover { background: #143c8c; color: #fff; } .kopf { width: min(1350px, calc(100% - 90px)); display: flex; align-items: center; gap: 12px; padding: 10px 14px 10px 22px; border-radius: 40px; background: rgb(250 250 250 / .62); -webkit-backdrop-filter: blur(35px); backdrop-filter: blur(35px); } .logo { font-size: 26px; font-weight: 600; color: #1a46a0; } nav { display: flex; gap: 22px; margin: 0 auto 0 40px; font-size: 14px; color: #1a46a0; } .r { padding: 8px 20px; border: 1px solid #1a46a0; color: #1a46a0; border-radius: 40px; font-size: 14px; } .t { background: #ed6c34; padding: 9px 20px; border-radius: 40px; font-size: 14px; }
  .start { position: relative; height: 100vh; } .start img { filter: brightness(.62); } .start div { position: absolute; left: 66px; bottom: 50px; color: #fff; } h1 { font-size: clamp(38px, 6.25vw, 90px); line-height: 1.12; letter-spacing: .01em; } .start p { font-size: 16px; font-weight: 400; margin-top: 12px; } .k { display: flex; gap: 14px; margin-top: 20px !important; } .g { padding: 10px 22px; border: 1px solid #fff; border-radius: 40px; font-size: 15px; }
  .licht { padding: 200px 20px 60px; } .licht p { max-width: 960px; margin: auto; text-align: center; font-size: clamp(26px, 3.4vw, 46px); font-weight: 600; line-height: 1.3; } .licht-an .licht span { color: transparent; background: linear-gradient(90deg, #111 calc(var(--f, 0) * 100%), #94847e calc(var(--f, 0) * 100%)); -webkit-background-clip: text; background-clip: text; } .x-alt { color: #111; }
  .wachsen { width: 76%; margin: 60px auto 0; height: 540px; border-radius: 16px; overflow: hidden; animation: gross linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; } @keyframes gross { from { transform: scale(.82); } to { transform: none; } }
  .zahlen { display: grid; grid-template-columns: repeat(4, 1fr); max-width: 1130px; margin: 80px auto; } .zahlen li { padding: 8px 40px; border-left: 1px solid #e0d2cb; font-size: 17px; } .zahlen b { display: block; font-size: 44px; font-weight: 600; }
  .nutzen { text-align: center; padding: 60px 66px; } .m { max-width: 640px; margin: 18px auto 70px; font-size: 16px; font-weight: 400; } .nutzen ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: left; } .nutzen h3 { font-size: 20px; border-top: 1px solid #e0d2cb; padding-top: 16px; min-height: 90px; line-height: 1.2; font-weight: 600; } .nutzen img { aspect-ratio: 1.1; border-radius: 4px; } .nutzen li p { font-weight: 400; font-size: 15px; margin-top: 14px; }
  .band { position: relative; height: 760px; margin-top: 100px; } .band a { position: absolute; top: 60px; left: 50%; translate: -50% 0; }
  .themen { padding: 170px 66px; } .kopfz { display: grid; grid-template-columns: 1fr 1fr; align-items: end; margin-bottom: 70px; } .kopfz p { font-weight: 400; font-size: 16px; max-width: 460px; justify-self: end; } details { border-top: 1px solid #e0d2cb; padding: 22px 8px; } summary { display: grid; grid-template-columns: 1fr auto; list-style: none; cursor: pointer; } summary b { font-size: 24px; font-weight: 600; } summary small { grid-row: 2; font-size: 15px; } summary i { grid-row: 1 / 3; align-self: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid #ed6c34; color: #ed6c34; display: grid; place-items: center; font-style: normal; }
  .klebe > div { position: sticky; top: 0; height: 100vh; color: #fff; display: grid; place-content: center; text-align: center; padding: 20px; } .klebe img { position: absolute; inset: 0; filter: brightness(.68); } .klebe h2, .klebe p { position: relative; max-width: 680px; margin: 6px auto; } .klebe p { font-size: 17px; font-weight: 400; }
  .ticket { position: relative; margin: 150px 66px; height: 560px; border-radius: 12px; overflow: hidden; color: #fff; display: grid; place-content: center; text-align: center; } .ticket img { position: absolute; inset: 0; filter: brightness(.55); } .ticket > *:not(img) { position: relative; } .ticket p { font-weight: 400; } .ticket div { position: absolute !important; left: 40px; right: 40px; bottom: 30px; display: flex; justify-content: space-between; align-items: center; } .ticket div b { font-size: 60px; font-weight: 500; }
  .stimmen { text-align: center; padding: 0 66px; } .cols { columns: 3; column-gap: 20px; margin-top: 60px; text-align: left; } article { break-inside: avoid; background: #fff; border-radius: 8px; padding: 26px; margin-bottom: 20px; font-size: 16px; } article span { color: #f5b301; font-size: 22px; letter-spacing: .08em; } article p { font-weight: 400; margin: 10px 0 20px; } article b { display: block; font-weight: 600; } article small { font-size: 13px; }
  .preis { text-align: center; padding: 200px 66px; } .pk { max-width: 1040px; margin: 80px auto 0; background: #fff; border-radius: 12px; padding: 36px; text-align: left; } .pk b { display: block; font-size: 60px; font-weight: 600; } .pk .o { display: block; text-align: center; margin: 20px 0; } .pk li { font-weight: 400; padding: 5px 0 5px 22px; position: relative; } .pk li::before { content: ''; position: absolute; left: 0; top: 13px; width: 10px; height: 10px; border-radius: 50%; background: #ed6c34; }
  footer { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 30px; background: #1a46a0; color: #fff; padding: 90px 66px 120px; font-size: 15px; } footer .logo { color: #fff; }
  @media (max-width: 760px) { .kopf { width: calc(100% - 24px); } nav, .r { display: none; } .t { margin-left: auto; } .start div { left: 20px; right: 20px; } .wachsen { width: calc(100% - 32px); height: 300px; } .zahlen, .nutzen ul, .kopfz { grid-template-columns: 1fr 1fr; } .nutzen, .themen, .stimmen, .preis { padding-inline: 20px; } .ticket { margin-inline: 16px; } .ticket div { flex-wrap: wrap; justify-content: center; gap: 10px; } .ticket div b { font-size: 34px; } .cols { columns: 1; } footer { grid-template-columns: 1fr; padding: 50px 20px; } .band { height: 340px; } .kopfz p { grid-column: 1 / -1; justify-self: start; margin-top: 16px; } }
  @media (prefers-reduced-motion: reduce) { .wachsen { animation: none; } }
</style>
</body></html>
