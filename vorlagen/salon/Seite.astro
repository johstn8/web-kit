---
/**
 * Vorlage "salon", Aufbau nach minerestaurant.de.
 * Papierweiss, Cardo kursiv fuer alles Grosse, Humanist fuer den Rest. Tuerkisband oben,
 * weisse Kopfzeile mit Wortmarke, zwei Rechteckknoepfen und Sprachwahl. Am unteren Rand
 * steht immer ein dunkles Band mit Zeiten, Adresse und Gutschein. Foto ueber die volle
 * Hoehe, kursiver Satz in der Mitte, runder Aufkleber links unten. Danach ruhig zentrierter
 * Absatz, Text neben Bildreihe, kursiver Titel mit zwei Spalten, Bild neben dunkler Flaeche,
 * Verbaende, Pressestimmen, Karte, Vollbild, Fuss.
 * Das Original traegt dort eine Plakette des Guide Michelin. Hier steht bewusst nichts,
 * das eine Auszeichnung behauptet.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>LUNA Restaurant</title></head>
<body>
<div class="kopf">
  <p class="band">Eine Reise in sechs Gängen durch unsere Lieblingsgerichte, perfekt für den ersten Besuch.</p>
  <header><a class="wm" href="#"><b>LUNA</b><small>RESTAURANT</small></a><nav><a href="#">Speisekarte</a><a href="#">Über uns</a><a href="#">Unsere Räume</a><a href="#">Kontakt</a></nav><a class="k leer" href="#">Event buchen</a><a class="k" href="#">Tisch reservieren</a><span class="sp">EN | <b>DE</b></span></header>
</div>
<a class="siegel" href="#">Gutschein<br />verschenken</a>
<aside class="fuss"><p>Montag bis Sonntag<br />17:30 – 22:00 Uhr</p><p>Letzte Bestellung<br />21:30 Uhr</p><p><u>Musterstraße 10</u><br /><u>10719 Berlin</u></p><a href="#">Geschenkkarte</a></aside>
<main>
  <section class="start"><img src={b('192')} alt="Gäste im Gastraum" /><h1>Feine Küche in Charlottenburg</h1><i aria-hidden="true">↓</i></section>
  <section class="absatz"><p>Empfohlen von Stammgästen und bekannt für unsere Weinkarte verwandelt LUNA Abende in unvergessliche Erinnerungen, in einem eleganten, einladenden Ambiente im Westen Berlins.</p><a href="#">Über uns →</a></section>
  <section class="reihe"><div><h2>KÜCHENPHILOSOPHIE</h2><p>Wir haben unser Konzept entwickelt, um der italienischen Tradition mit den besten Zutaten und handverlesenen Rezepten neues Leben einzuhauchen.</p><a href="#">Speisekarte →</a></div>
    <ul tabindex="0" aria-label="Gerichte, waagerecht scrollbar">{[['102','ROTE BEEREN MIT SAHNE'],['225','HAUSTEE MIT FRISCHEN BLÜTEN'],['63','ESPRESSO AUS EIGENER RÖSTUNG'],['42','DER TISCH AM FENSTER']].map(([n, t]) => <li><img src={b(n)} alt="" loading="lazy" /><p>{t}</p></li>)}</ul></section>
  <section class="kursiv"><h2>LUNA ist ein Restaurant in Berlin-Charlottenburg, wenige Schritte vom Kurfürstendamm.</h2><div><p>Unsere Küche ist italienische Tradition mit den besten Zutaten: hausgemachte Pasta, Fleisch und Fisch vom Grill, saisonales Gemüse. Die Weinkarte umfasst rund 120 Positionen.</p><p>Nebenan liegt unsere kleine Weinbar für den Aperitif vor dem Essen oder ein Glas danach. Für Feiern und Geschäftsessen bieten wir ein Séparée.</p></div><a href="#">Über uns →</a></section>
  <section class="teil"><img src={b('102')} alt="" loading="lazy" /><div><h2>Ein Abend nur für Sie in Charlottenburg</h2><p>Feiern Sie in unserem exklusiven Ziel für feine Küche, ausgewählte Weine und besondere Momente.</p><p>Von intimen Zusammenkünften im Séparée bis zu exklusiven Soirées in der Weinbar wird jedes Detail mit Sorgfalt gestaltet.</p><a href="#">Planen Sie Ihren Moment →</a></div></section>
  <section class="verband"><h2>UNSERE PARTNER FÜR WEIN UND GASTRONOMIE</h2><ul><li class="rund"></li><li>Winzerhof</li><li class="eck"></li><li class="weit">WEINHAUS</li><li>Kellerei</li></ul><p>Seit Jahren arbeiten wir mit denselben Winzern und Erzeugern, viele davon kennen wir persönlich.</p><a href="#">Unsere Partner →</a></section>
  <section class="presse"><p>„Ein italienisches Restaurant in einer Hauptstadt, die ohnehin reich an italienischen Restaurants ist.“</p><p>„Es ist vielleicht das weltoffenste Restaurant der Stadt.“</p><b>Beispielzeitung</b><a href="#">Presse und Rezensionen →</a></section>
  <section class="ort"><div><h2><u>Musterstraße 10,</u></h2><p class="g">10719 Berlin</p><p>TÄGLICH GEÖFFNET<br />17:30 – 23:00</p><a href="#">Kontakt →</a></div><svg viewBox="0 0 900 420" aria-hidden="true"><rect width="900" height="420" fill="#e6e8e3" /><path d="M-20 300 930 150M120 -10 260 430M500 -10 620 430M-10 90 920 330" stroke="#fff" stroke-width="20" fill="none" /><path d="M-20 200 930 40" stroke="#c8cdd2" stroke-width="30" fill="none" /><circle cx="470" cy="170" r="12" fill="#c8102e" /></svg></section>
  <section class="voll"><img src={b('63')} alt="" loading="lazy" /></section>
</main>
<footer><div class="wm"><b>LUNA</b><small>RESTAURANT</small></div><p>Montag bis Sonntag<br />17:30 – 23:00 Uhr<br />Die Küche schließt<br />um 22:30 Uhr</p><p><u>Musterstraße 10</u><br /><u>10719 Berlin</u></p><p><u>Über uns</u><br /><u>Unsere Räume</u><br /><u>Presse</u><br /><u>Kontakt</u></p><p><u>Karriere</u><br /><u>Impressum</u><br /><u>Datenschutz</u></p><small class="r">Beispielinhalt einer Vorlage</small></footer>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; } body { margin: 0; background: #fffaf6; color: #22292f; font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding-bottom: 66px; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, p, ul { margin: 0; padding: 0; font-weight: 400; } ul { list-style: none; } a { color: inherit; }
  .kopf { position: fixed; inset: 0 0 auto; z-index: 30; } .band { background: #0b6f7f; color: #fff; text-align: center; font-size: 13px; padding: 3px 12px; } header { display: flex; align-items: center; gap: 22px; height: 76px; padding: 0 84px; background: #fffaf6; } .wm { display: grid; justify-items: center; text-decoration: none; line-height: 1.1; } .wm b { font-weight: 500; letter-spacing: .28em; font-size: 20px; } .wm small { font-size: 9px; letter-spacing: .3em; } nav { display: flex; gap: 30px; margin-left: 150px; margin-right: auto; font-size: 14px; } nav a, .k { text-decoration: none; } .k { background: #22292f; color: #fff; padding: 9px 26px; font-size: 14px; } .k.leer { background: none; color: #22292f; box-shadow: inset 0 0 0 1px #22292f; } .sp { font-size: 13px; margin-left: 20px; }
  .siegel { position: fixed; left: 34px; bottom: 76px; z-index: 25; width: 132px; height: 132px; border-radius: 50%; background: #a8123a; color: #fff; display: grid; place-content: center; text-align: center; font-size: 15px; line-height: 1.25; text-decoration: none; box-shadow: inset 0 0 0 4px #a8123a, inset 0 0 0 5px rgb(255 255 255 / .6); }
  .fuss { position: fixed; inset: auto 0 0; z-index: 30; height: 66px; display: flex; align-items: center; gap: 72px; padding: 0 84px; background: #22292f; color: #fff; font-size: 14px; line-height: 1.3; } .fuss a { margin-left: auto; box-shadow: inset 0 0 0 1px #fff; padding: 8px 28px; text-decoration: none; font-weight: 700; }
  h1, .kursiv h2, .teil h2, .presse p { font-family: var(--font-display); font-style: italic; }
  .start { position: relative; height: 100vh; color: #fff; } .start img { filter: sepia(.75) saturate(1.5) brightness(.5); } h1 { position: absolute; inset: 46% 8% auto; text-align: center; font-size: clamp(38px, 5vw, 72px); line-height: 1.1; text-wrap: balance; } .start i { position: absolute; left: 50%; top: 66%; font-style: normal; font-size: 26px; }
  .absatz { text-align: center; padding: 110px 24px 90px; } .absatz p { max-width: 830px; margin: 0 auto 40px; font-size: 24px; line-height: 1.65; } .absatz a, .reihe a, .kursiv a, .teil a, .verband a, .presse a, .ort a { color: #0b6f7f; text-decoration: none; }
  h2 { font-weight: 700; font-size: 14px; letter-spacing: .08em; }
  .reihe { display: grid; grid-template-columns: 340px 1fr; gap: 40px; padding: 0 0 80px 84px; } .reihe div p { margin: 16px 0; font-size: 16px; } .reihe ul { display: flex; gap: 22px; overflow-x: auto; scrollbar-width: none; } .reihe li { flex: 0 0 370px; } .reihe img { height: 400px; } .reihe li p { font-size: 13px; margin-top: 10px; }
  .kursiv { text-align: center; padding: 90px 84px; } .kursiv h2 { font-size: clamp(30px, 3.4vw, 48px); font-weight: 400; letter-spacing: 0; line-height: 1.2; max-width: 1200px; margin: auto; } .kursiv div { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; text-align: left; max-width: 1240px; margin: 50px auto 40px; font-size: 18px; }
  .teil { display: grid; grid-template-columns: 1fr 1fr; min-height: 900px; } .teil div { background: #22292f; color: #fff; padding: 110px 60px; font-size: 16px; } .teil h2 { font-size: 44px; font-weight: 400; letter-spacing: 0; line-height: 1.25; max-width: 460px; margin-bottom: 40px; } .teil p { max-width: 560px; margin-bottom: 26px; } .teil a { display: inline-block; margin-top: 90px; color: #6fd3e2; }
  .verband { text-align: center; padding: 110px 84px; } .verband ul { display: flex; justify-content: center; align-items: center; gap: 70px; margin: 50px 0; font-family: var(--font-display); font-size: 46px; color: #6d6f70; } .rund { width: 90px; height: 90px; border-radius: 50%; background: #b9b9b9; } .eck { width: 44px; height: 84px; background: #b9b9b9; } .weit { letter-spacing: .1em; font-size: 40px; } .verband p { max-width: 640px; margin: 0 auto 40px; font-size: 21px; }
  .presse { background: #f7f1ea; text-align: center; padding: 110px 24px; } .presse p { font-size: 34px; line-height: 1.3; max-width: 760px; margin: 0 auto 34px; } .presse b { display: block; font-size: 42px; margin-bottom: 30px; }
  .ort { display: grid; grid-template-columns: 26% 1fr; gap: 20px; padding: 60px 0 60px 56px; } .ort h2 { font-family: var(--font-body); font-size: 26px; font-weight: 400; letter-spacing: 0; color: #0b6f7f; } .g { font-size: 26px; margin-bottom: 26px; } .ort p:not(.g) { font-size: 16px; margin-bottom: 30px; } .ort svg { width: 100%; height: 460px; }
  .voll { height: 480px; } footer { display: grid; grid-template-columns: 1fr 1.2fr 1.4fr 1.2fr 1fr; gap: 30px; padding: 40px 84px 60px; font-size: 15px; align-items: start; } .r { grid-column: 5; }
  @media (max-width: 760px) { body { padding-bottom: 0; } .band { display: none; } header { height: 64px; padding: 0 12px; gap: 8px; } nav, .k.leer, .sp { display: none; } .wm { margin-right: auto; } .k { padding: 8px 12px; } .siegel { display: none; } .fuss { position: static; flex-wrap: wrap; height: auto; padding: 16px; gap: 14px; } .fuss a { margin-left: 0; } .reihe { grid-template-columns: 1fr; padding: 0 0 50px 16px; } .reihe li { flex-basis: 76vw; } .reihe img { height: 300px; } .kursiv { padding: 50px 16px; } .kursiv div, .teil, .ort, footer { grid-template-columns: 1fr; gap: 20px; } .teil img { height: 320px; } .teil div { padding: 50px 20px; } .teil a { margin-top: 20px; } .verband { padding: 60px 16px; } .verband ul { flex-wrap: wrap; gap: 24px; font-size: 30px; } .ort { padding: 40px 16px; } .ort svg { height: 260px; } footer { padding: 30px 16px; } .r { grid-column: 1; } }
</style>
</body></html>
