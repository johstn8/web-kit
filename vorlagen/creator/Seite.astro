/**
 * Vorlage "creator", Aufbau nach espmedia.de.
 * Vom Nutzer gelobt: Scrollanimationen, die dunklen Kacheln weiter unten, Personenbilder
 * mit Zahlen im Overlay, eingebundene Teambilder, die schraeg liegenden Handys am Ende,
 * der Fuss, im Auftakt Bewertung, uebereinanderliegende Bilder und Partner unter dem Knopf.
 * Nicht uebernommen: der Wechsel zu kursiven Woertern in Ueberschriften, den der Nutzer
 * ablehnt, und der klassische Verlaufsauftakt; der Auftakt steht ruhig auf Dunkelblau.
 * Die Zahlen im Overlay sind Beispiele und lassen sich durch jede andere Angabe ersetzen.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const leute = [['1005','Jonas Beispiel','Handwerk erklärt',['84.000','31.000','12.400']],['1027','Lena Muster','Küche und Alltag',['126.000','58.000','40.100']],['832','Mira Probe','Recht einfach',['47.300','22.900','9.800']],['856','Tom Vorlage','Geld verstehen',['212.000','71.000','33.500']],['823','Pia Exempel','Fotografie',['39.000','88.200','15.600']],['669','Ben Platzhalter','Outdoor',['91.400','27.300','52.000']]] as const;
const team = [['1005','Max Muster','Gründer'],['1027','Anna Beispiel','Creator-Betreuung'],['856','Tim Probe','Partnerschaften'],['832','Sara Vorlage','Inhalte und Schnitt'],['669','Leo Exempel','Kampagnen'],['823','Mia Platz','Büro']];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>WELLE Media – Agentur für Wissens-Creator</title></head>
<body>
<header><a class="wm" href="#"><i aria-hidden="true"></i>WELLE Media</a><nav aria-label="Hauptnavigation"><a href="#leistung">Beratung</a><a href="#creator">Creator</a><a href="#marken">Für Marken</a><a href="#team">Team</a><a href="#fragen">Fragen</a></nav><a class="k" href="#kontakt">Kontakt</a></header>
<main>
  <section class="start"><div class="text"><p class="bew"><span class="gesichter">{['1005','1027','832','856'].map((n) => <img src={b(n)} alt="" />)}</span><b>★★★★★</b> 4,9 von 180 Creatorn und Marken</p><h1>Die Agentur für Creator, die Wissen teilen, und die Marken dahinter</h1><a class="k" href="#kontakt">Kennenlerngespräch vereinbaren</a><ul class="partner" aria-label="Partner"><li>Gründerpreis</li><li>Medienverband</li><li>Plattform-Partner</li><li>Akademie</li></ul></div>
    <div class="stapel" aria-hidden="true">{['1027','1005','832'].map((n, i) => <img src={b(n)} alt="" style={`--i:${i}`} />)}</div></section>
  <section class="logos" aria-label="Kunden"><ul>{['NORDWERK','kontor','Beispiel AG','MUSTER','fluss','Vorlage'].map((n) => <li>{n}</li>)}</ul></section>
  <section class="intro" data-zeig><h2>WELLE Media ist die Agentur für Menschen, die mit ihrem Wissen ein Publikum aufbauen</h2><p>Wissens-Creator erklären, was sie können, und erreichen damit Hunderttausende. Wir kümmern uns um alles, was dabei liegen bleibt: Verhandlungen, Kooperationen, Planung, Abrechnung. Das Ergebnis ist ein Creator-Geschäft, das planbar trägt, unabhängig von einzelnen Plattformen und Partnern.</p></section>
  <section class="leistung" id="leistung"><h2 data-zeig>Unsere Leistungen für Creator und Marken</h2><p class="u">Was wir jeden Tag für unsere Partner erledigen.</p>
    <div class="vier">{[['1011','Creator-Beratung','Gemeinsam schärfen wir Positionierung, Angebot und Plan.'],['395','Creator-Management','Von der ersten Anfrage bis zum unterschriebenen Vertrag.'],['445','Marketing für Marken','Kampagnen mit Creatorn, die zu Ihrem Produkt passen.'],['338','Karriere','Wir suchen Menschen, die mit uns wachsen wollen.']].map(([n, t, p], i) => <article data-zeig style={`--v:${i % 2 ? 60 : 0}px`}><img src={b(n)} alt="" loading="lazy" /><h3>{t}</h3><p>{p}</p><a href="#">Mehr erfahren →</a></article>)}</div></section>
  <section class="dunkel" id="marken"><h2 data-zeig>Kampagnen, die zwischen Creatorn und Marken entstanden sind</h2>
    <ul class="kampagnen" tabindex="0" aria-label="Kampagnen, waagerecht scrollbar">{[['Kontor × Jonas','Für die Serie „Werkstatt am Abend" war Kontor ein Jahr lang Partner.','1005'],['Nordwerk × Lena','Mit Nordwerk entstanden zwölf Rezepte mit eigenem Werkzeug.','1027'],['Fluss × Tom','Fluss begleitet die Reihe „Geld in fünf Minuten".','856']].map(([t, p, n]) => <li data-zeig><h3>{t}</h3><p>{p}</p><figure><img src={b(n)} alt="" loading="lazy" /><span aria-hidden="true">▶</span></figure></li>)}</ul>
    <h2 id="creator" data-zeig>Kleine und große Wissens-Creator vertrauen uns</h2><p class="u">Eine Auswahl der Creator, die wir betreuen oder beraten haben.</p>
    <ul class="leute">{leute.map(([n, name, thema, z]) => <li data-zeig><img src={b(n)} alt={`${name}, ${thema}`} loading="lazy" /><span class="name">{name}</span><dl class="werte"><div><dt>Video</dt><dd>{z[0]}</dd></div><div><dt>Bild</dt><dd>{z[1]}</dd></div><div><dt>Kurzvideo</dt><dd>{z[2]}</dd></div></dl></li>)}</ul>
    <p class="mehr"><b data-zahl="350">350</b> weitere Creator vertrauen WELLE Media</p>
    <div class="band" data-zeig><h2>Einfach unverbindlich kennenlernen</h2><p>Im Gespräch lernen wir uns kennen und besprechen, wo Sie gerade stehen und was wir tun können.</p><a class="k hell" href="#kontakt">Gespräch vereinbaren</a></div></section>
  <section class="anders"><h2 data-zeig>Was uns von anderen Agenturen unterscheidet</h2><div class="drei">{[['Spezialisiert auf Wissen','Wir betreuen nur Creator, die etwas erklären. Dadurch kennen wir Publikum und Partner genau.'],['Partner nach Daten','Wer zu welchem Creator passt, entscheiden Zahlen zur Zielgruppe, nicht die Größe des Kanals.'],['Langfristig statt einmalig','Wir bauen Partnerschaften über Jahre, keine einzelnen Beiträge.']].map(([t, p]) => <article data-zeig><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /></svg><h3>{t}</h3><p>{p}</p></article>)}</div><a class="k" href="#kontakt">Kennenlerngespräch vereinbaren</a></section>
  <section class="zahlen"><h2 data-zeig>Die Arbeit von WELLE Media in Zahlen</h2><p class="u">Wir messen unseren Erfolg an Creatorn, die heute planbarer arbeiten als vor der Zusammenarbeit.</p>
    <ul class="saeulen">{[['2.000+','Kooperationen abgeschlossen','445'],['1.000+','Marken in unserer Kartei','395'],['350+','Creator beraten','1011']].map(([w, t, n], i) => <li data-zeig style={`--h:${[100, 78, 58][i]}%`}><img src={b(n)} alt="" loading="lazy" /><b>{w}</b><span>{t}</span></li>)}</ul></section>
  <section class="team" id="team"><h2 data-zeig>Ein verlässliches Team an Ihrer Seite</h2><ul>{team.map(([n, name, rolle]) => <li data-zeig><img src={b(n)} alt="" loading="lazy" /><h3>{name}</h3><p>{rolle}</p></li>)}</ul></section>
  <section class="fragen" id="fragen"><h2>Häufige Fragen zu unserer Agentur</h2>{[['Warum gehört Beratung immer zum Management?','Weil Verträge erst dann gut werden, wenn Angebot und Plan stimmen.'],['Ich bin noch nicht sehr bekannt. Kann ich mich trotzdem melden?','Ja. Entscheidend ist, ob Ihr Publikum Ihnen zuhört, nicht seine Größe.'],['Bin ich lange gebunden?','Nein, wir arbeiten mit kurzen Kündigungsfristen.'],['Arbeiten Sie auch mit kleinen Budgets?','Ja, wir finden für jedes Budget passende Creator.']].map(([f, a], i) => <details open={i === 0}><summary>{f}</summary><p>{a}</p></details>)}</section>
  <section class="ende" id="kontakt"><div class="handys" aria-hidden="true"><div class="tel a"><img src={b('1027')} alt="" loading="lazy" /></div><div class="tel b"><img src={b('1005')} alt="" loading="lazy" /></div></div><div><h2 data-zeig>Bringen Sie Ihr Creator-Geschäft auf die nächste Stufe</h2><ul class="haken"><li>Mehr als 200 zufriedene Creator</li><li>Beratung aus langer eigener Erfahrung</li><li>Für alle Fragen die passende Lösung</li></ul><a class="k" href="#">Kennenlerngespräch vereinbaren</a></div></section>
</main>
<footer><div><a class="wm" href="#"><i aria-hidden="true"></i>WELLE Media</a><p>Mehr als 350 Creator vertrauen uns.</p></div><div><h2>Seiten</h2><ul><li><a href="#">Start</a></li><li><a href="#leistung">Beratung</a></li><li><a href="#creator">Creator</a></li><li><a href="#team">Team</a></li></ul></div><div><h2>Rechtliches</h2><ul><li><a href="#">Impressum</a></li><li><a href="#">Datenschutz</a></li></ul></div><div><h2>Kontakt</h2><p>WELLE Media GmbH<br />Musterstraße 10, 50667 Köln<br />hallo@welle.example</p></div><ul class="siegel" aria-label="Partner"><li>Gründerpreis</li><li>Medienverband</li><li>Akademie</li><li>Plattform-Partner</li></ul><small>Beispielinhalte, die Firma und die Personen sind erfunden.</small></footer>
<script is:inline>
(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.documentElement.classList.add('js');
  const zeig = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; e.target.classList.add('da'); zeig.unobserve(e.target); const z = e.target.querySelector?.('[data-zahl]'); }), { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('[data-zeig]').forEach((s) => zeig.observe(s));
  const st = document.querySelector('.stapel');
  addEventListener('scroll', () => { const p = Math.min(1, scrollY / innerHeight); st.style.setProperty('--p', p); }, { passive: true });
})();
</script>
<style is:global>
  * { box-sizing: border-box; } html { overflow-x: clip; scroll-padding-top: 20px; } body { margin: 0; background: #fff; color: #111; font-family: var(--font-body); font-size: 17px; line-height: 1.55; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p, ul, dl, dd, figure { margin: 0; padding: 0; } ul { list-style: none; } a { color: inherit; text-decoration: none; }
  h1, h2 { font-family: var(--font-display); font-weight: 600; letter-spacing: -.02em; line-height: 1.12; } h2 { font-size: clamp(30px, 3.6vw, 52px); } h3 { font-size: 21px; font-weight: 600; letter-spacing: -.01em; } .u { color: #4a4a4a; margin-top: 10px; }
  .k { display: inline-block; background: #1f6fe5; color: #fff; padding: 15px 28px; border-radius: 4px; font-size: 14px; font-weight: 600; transition: background .2s, translate .2s; } .k:hover { background: #1558bd; translate: 0 -2px; } .k.hell { background: #fff; color: #0c1a3a; }
  html.js [data-zeig] { opacity: 0; translate: 0 34px; transition: opacity .8s ease-out, translate .9s cubic-bezier(.2,.7,.2,1); } html.js [data-zeig].da { opacity: 1; translate: 0 0; }
  header { position: absolute; z-index: 10; top: 16px; left: 4%; right: 4%; display: flex; align-items: center; gap: 40px; padding: 14px 18px 14px 24px; border-radius: 6px; background: rgb(12 22 48 / .86); color: #fff; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); } .wm { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 19px; } .wm i { width: 22px; height: 14px; border-radius: 3px; background: #1f6fe5; box-shadow: 6px 6px 0 #8fb6f5; } header nav { display: flex; gap: 30px; font-size: 14px; margin-right: auto; } header nav a:hover { color: #9cc0ff; }
  .start { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; min-height: 820px; padding: 150px 6% 70px; background: #0c1630; color: #fff; overflow: hidden; } .bew { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #d5ddef; margin-bottom: 26px; } .gesichter { display: flex; } .gesichter img { width: 34px; height: 34px; border-radius: 50%; border: 2px solid #0c1630; margin-left: -10px; } .gesichter img:first-child { margin-left: 0; } .bew b { color: #fbbf24; letter-spacing: 1px; } h1 { font-size: clamp(38px, 4.4vw, 64px); margin-bottom: 34px; max-width: 700px; } .partner { display: flex; flex-wrap: wrap; gap: 14px 30px; margin-top: 40px; font-size: 13px; font-weight: 600; color: #b9c4dc; letter-spacing: .04em; }
  .stapel { position: relative; height: 560px; --p: 0; } .stapel img { position: absolute; width: 54%; height: 76%; border-radius: 6px; box-shadow: 0 30px 60px rgb(0 0 0 / .4); } .stapel img:nth-child(1) { left: 0; top: 12%; transform: rotate(-4deg) translateY(calc(var(--p) * -40px)); } .stapel img:nth-child(2) { left: 24%; top: 0; z-index: 1; transform: translateY(calc(var(--p) * -80px)); } .stapel img:nth-child(3) { right: 0; top: 22%; z-index: 2; transform: rotate(4deg) translateY(calc(var(--p) * -20px)); }
  .logos ul { display: flex; flex-wrap: wrap; justify-content: space-around; gap: 20px; padding: 34px 6%; background: #0c1630; color: #c3cde3; font-size: 22px; font-weight: 700; letter-spacing: .06em; border-top: 1px solid #22305a; }
  .intro { max-width: 1000px; margin: 0 auto; padding: 110px 24px 90px; text-align: center; } .intro p { margin-top: 30px; color: #3e3e3e; text-align: left; }
  .leistung { padding: 30px 8% 120px; } .vier { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 70px; margin-top: 60px; } .vier article { translate: 0 var(--v); } html.js .vier article[data-zeig] { translate: 0 calc(var(--v) + 34px); } html.js .vier article[data-zeig].da { translate: 0 var(--v); } .vier img { height: 360px; border-radius: 5px; margin-bottom: 22px; } .vier p { color: #4a4a4a; margin: 8px 0 14px; max-width: 520px; } .vier a { font-size: 14px; font-weight: 600; }
  .dunkel { background: #050505; color: #fff; padding: 110px 6%; } .dunkel > h2 { text-align: center; max-width: 820px; margin: 0 auto 60px; } .dunkel .u { color: #c7c7c7; margin-bottom: 50px; } .dunkel #creator { text-align: left; margin: 120px 0 0; } .kampagnen { display: flex; gap: 22px; overflow-x: auto; scrollbar-width: none; padding-bottom: 6px; } .kampagnen li { flex: 0 0 min(560px, 86vw); background: #171717; border-radius: 6px; padding: 30px; } .kampagnen p { color: #cfcfcf; font-size: 15px; margin: 12px 0 22px; } .kampagnen figure { position: relative; height: 270px; border-radius: 4px; overflow: hidden; } .kampagnen span { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 64px; height: 46px; border-radius: 12px; background: #e02424; display: grid; place-content: center; font-size: 18px; }
  .leute { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; } .leute li { position: relative; height: 460px; border-radius: 6px; overflow: hidden; } .leute img { transition: scale .8s cubic-bezier(.2,.7,.2,1); } .leute li:hover img { scale: 1.05; } .name { position: absolute; left: 16px; top: 16px; padding: 6px 14px; border-radius: 6px; background: rgb(30 30 30 / .72); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); font-weight: 600; font-size: 15px; } .werte { position: absolute; left: 16px; right: 16px; bottom: 18px; display: flex; justify-content: space-between; padding: 12px 16px; border-radius: 6px; background: rgb(30 30 30 / .72); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); font-size: 15px; } .werte div { display: flex; flex-direction: column-reverse; } .werte dt { font-size: 11px; color: #d0d0d0; } .werte dd { font-weight: 600; }
  .mehr { text-align: center; margin: 50px 0 90px; font-size: 18px; } .mehr b { font-size: 34px; font-family: var(--font-display); margin-right: 10px; }
  .band { display: grid; grid-template-columns: 1fr 1.2fr auto; gap: 40px; align-items: center; padding: 50px; border-radius: 6px; background: #1f6fe5; } .band h2 { font-size: clamp(28px, 3vw, 44px); } .band p { color: #e8f0ff; }
  .anders { text-align: center; padding: 110px 8%; } .anders h2 { max-width: 820px; margin: 0 auto; } .drei { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin: 60px 0 50px; text-align: left; } .drei svg { width: 34px; height: 34px; padding: 6px; border-radius: 8px; background: #eef4ff; fill: none; stroke: #1f6fe5; stroke-width: 1.8; margin-bottom: 18px; } .drei p { color: #4a4a4a; font-size: 15px; margin-top: 10px; }
  .zahlen { background: #050505; color: #fff; padding: 110px 6%; text-align: center; } .zahlen .u { color: #c7c7c7; max-width: 640px; margin: 14px auto 70px; } .saeulen { display: flex; align-items: flex-end; justify-content: center; gap: 22px; height: 520px; } .saeulen li { position: relative; flex: 0 1 380px; height: var(--h); border-radius: 6px; overflow: hidden; text-align: left; padding: 30px; display: flex; flex-direction: column; justify-content: flex-start; } .saeulen img { position: absolute; inset: 0; filter: brightness(.38) saturate(.6) hue-rotate(190deg); } .saeulen li::after { content: ''; position: absolute; inset: 0; border: 1px solid rgb(140 180 255 / .5); border-radius: 6px; } .saeulen b, .saeulen span { position: relative; } .saeulen b { font-family: var(--font-display); font-size: clamp(40px, 4vw, 60px); font-weight: 600; } .saeulen span { color: #dbe5ff; font-size: 15px; max-width: 180px; } html.js .saeulen li[data-zeig] { translate: 0 120px; } html.js .saeulen li[data-zeig].da { translate: 0 0; transition-delay: calc(var(--h) * 0s); }
  .team { padding: 110px 6%; } .team ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px 22px; margin-top: 50px; } .team img { height: 380px; border-radius: 5px; margin-bottom: 14px; filter: grayscale(.2); } .team p { color: #4a4a4a; font-size: 14px; }
  .fragen { max-width: 900px; margin: 0 auto; padding: 60px 24px 110px; } .fragen h2 { text-align: center; margin-bottom: 40px; } details { border-bottom: 1px solid #e3e3e3; } summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; font-weight: 600; } summary::-webkit-details-marker { display: none; } summary::after { content: '+'; font-size: 22px; line-height: 1; } details[open] summary::after { content: '–'; } details p { padding-bottom: 20px; color: #4a4a4a; }
  .ende { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; padding: 100px 8% 90px; background: #050505; color: #fff; overflow: hidden; } .handys { position: relative; height: 480px; } .tel { position: absolute; width: 220px; height: 450px; border-radius: 34px; border: 9px solid #1d1d1f; overflow: hidden; box-shadow: 0 40px 70px rgb(0 0 0 / .6), inset 0 0 0 1px #444; background: #111; } .tel.a { left: 8%; top: 30px; transform: rotate(-16deg); } .tel.b { left: 42%; top: 0; transform: rotate(10deg); } .haken { margin: 26px 0 34px; display: grid; gap: 12px; color: #d8d8d8; font-size: 15px; } .haken li::before { content: '✓'; color: #6aa2ff; margin-right: 12px; }
  footer { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.3fr; gap: 40px; padding: 70px 8% 40px; background: #050505; color: #fff; font-size: 14px; border-top: 1px solid #222; } footer h2 { font-size: 13px; font-weight: 600; letter-spacing: .04em; margin-bottom: 14px; } footer li { margin-bottom: 8px; } footer p { color: #cfcfcf; margin-top: 10px; } .siegel { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; padding: 30px 0; border-top: 1px solid #222; color: #bdbdbd; font-weight: 600; letter-spacing: .04em; } footer small { grid-column: 1 / -1; color: #bdbdbd; }
  a:focus-visible, summary:focus-visible, [tabindex]:focus-visible { outline: 2px solid #6aa2ff; outline-offset: 3px; } @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
  @media (max-width: 860px) { header { left: 12px; right: 12px; gap: 12px; padding: 10px 12px; } header nav { display: none; } header .k { margin-left: auto; padding: 10px 14px; } .start { grid-template-columns: 1fr; padding: 110px 20px 50px; min-height: 0; } .stapel { height: 340px; } .logos ul { font-size: 16px; padding: 24px 16px; } .intro { padding: 70px 20px 50px; } .leistung, .anders, .team { padding: 60px 20px; } .vier, .drei, .band, .ende, footer { grid-template-columns: 1fr; } .vier article, html.js .vier article[data-zeig].da { translate: 0 0; } .vier img { height: 260px; } .dunkel, .zahlen { padding: 70px 16px; } .leute { grid-template-columns: 1fr 1fr; gap: 10px; } .leute li { height: 300px; } .werte { flex-direction: column; gap: 2px; left: 8px; right: 8px; bottom: 8px; padding: 8px 10px; font-size: 13px; } .werte div { flex-direction: row-reverse; justify-content: space-between; } .name { left: 8px; top: 8px; font-size: 13px; } .band { padding: 30px 22px; gap: 18px; } .saeulen { height: 380px; gap: 8px; } .saeulen li { padding: 14px; } .saeulen span { font-size: 12px; } .team ul { grid-template-columns: 1fr 1fr; gap: 20px 12px; } .team img { height: 220px; } .ende { padding: 60px 20px; gap: 20px; } .handys { height: 380px; order: 2; } .tel { width: 170px; height: 350px; } footer { padding: 50px 20px 30px; gap: 26px; } }
</style>
</body></html>
