---
/**
 * Vorlage "rund", Aufbau nach jovoco.io.
 * Heller Blauverlauf, schlichte Kopfzeile mit Wortmarke und Punkt, Sprachwahl, blaue Pille.
 * Auftakt links Text, Bewertung als Zeile, rechts Motiv ohne Rahmen, Logos laufen durch.
 * Blaue Karte links neben sechs Vorteilen, dunkles Band mit grossen Karten, Faelle,
 * Stimmen, Mosaik aus Bildern und Zahlen, Branchen als Zeilen mit Linie, Vollbild-Zitat,
 * Karte mit Standorten, Fragen in Kaesten, blaue Abschlusskarte, dunkler Fuss.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>systemwerk</title></head>
<body>
<header><a class="wm" href="#">systemwerk<i>.</i></a><nav><a href="#">Home</a><a class="an" href="#">Leistungen ⌄</a><a href="#">Fallstudien</a><a href="#">Über uns ⌄</a><a href="#">Fachwissen</a><a href="#">Karriere</a></nav><span class="sp">DE ⌄</span><a class="kn" href="#">Kontakt</a></header>
<main>
  <section class="auftakt"><div><h1>Wir lösen knifflige<br />IT-Probleme</h1><p>Als IT-Dienstleister sorgen wir dafür, dass Ihre IT zuverlässig läuft, von der Sicherheit bis zur Software nach Maß.</p><p class="mission">Unsere Mission: <b>Einfach IT.</b></p><p class="ak"><a class="kn" href="#">Erstgespräch vereinbaren</a><a class="zw" href="#">Leistungen entdecken</a></p><p class="bew"><b class="g">G</b><span>★★★★★</span> 5,0 <b>Hervorragend</b> · 30+ Bewertungen</p></div><img src={b('60')} alt="Arbeitsplatz von oben" /></section>
  <section class="logos"><p>Unternehmen jeder Größe vertrauen uns. Sind Sie die Nächsten?</p><div>{['nordwerk','HALLMANN','Lumen','SAGO','IQ-Mitte','Norda','ITMA','Stadtwerk'].map((l) => <span>{l}</span>)}</div></section>
  <section class="warum"><div class="blau"><h2>Was uns als IT-Dienstleister ausmacht</h2><p>Wir stehen für mehr als IT. Wir schaffen Fortschritt, Effizienz und messbare Ergebnisse, mit Fokus auf das, was zählt.</p><a href="#">Erstgespräch vereinbaren</a></div>
    <ul>{[['Ergebnisse statt Versprechen','Wir liefern konkrete Resultate, schnell und nachvollziehbar.'],['Technik als Mittel zum Zweck','Lösungen sind auf Ihr Wachstum ausgerichtet.'],['Komplexes verständlich','Wir übersetzen Technik in klare Entscheidungen.'],['Partnerschaft auf Augenhöhe','Gemeinsam erreichen wir mehr, durch Offenheit.'],['Neugier mit Substanz','Neue Technik trifft auf Pragmatismus.'],['Verlässlich in jeder Phase','Von der ersten Idee bis zur Umsetzung.']].map(([t, x]) => <li><i></i><h3>{t}</h3><p>{x}</p></li>)}</ul></section>
  <section class="dunkel"><h2>Unsere Leistungen in dem, was<br />wir als IT-Dienstleister bieten</h2><p class="m">Mit unseren Lösungen digitalisieren wir Prozesse, vereinfachen Komplexität und schaffen Mehrwert.</p>
    <div class="zwei">{[['IT-Sicherheit','158'],['KI-Lösungen','180'],['Automatisierung','60'],['Datenanalyse','0']].map(([t, n]) => <article><img src={b(n)} alt="" loading="lazy" /><h3>{t}</h3><p>Schwachstellen erkennen, Risiken bewerten, Systeme absichern, mit pragmatischen Maßnahmen.</p><ul><li>Beratung</li><li>Umsetzung</li><li>Schulung</li><li>Betrieb</li></ul><a href="#">Mehr erfahren →</a></article>)}</div></section>
  <section class="faelle"><div class="k"><h2>Erfolgreiche Ergebnisse für unsere Kunden</h2><a href="#">Alle ansehen</a></div><ul>{[['1','Daten zentral und firmenweit verwalten'],['180','Rollout für globale Kommunikation'],['3','Integration von Daten ins Lager']].map(([n, t]) => <li><img src={b(n)} alt="" loading="lazy" /><small>Fallstudie</small><h3>{t}</h3><p>Wie wir mit einem klaren Vorgehen gemeinsam ans Ziel kamen.</p><a href="#">Fallstudie lesen →</a></li>)}</ul></section>
  <section class="mosaik"><div><h2>Wer wir sind und was wir machen</h2><a href="#">Mehr über uns</a></div><img src={b('3')} alt="" loading="lazy" /><p class="z"><b>+60 %</b>jährlicher Mitarbeiterzuwachs</p><img src={b('1')} alt="" loading="lazy" /><p class="z"><b>6</b>Standorte</p><img src={b('64')} alt="" loading="lazy" /><p class="z"><b>25+</b>Mitarbeitende</p><img src={b('180')} alt="" loading="lazy" /><p class="z"><b>200+</b>Experten im Verbund</p></section>
  <section class="zeilen">{['Maschinenbau','Finanzen','Automotive','Energie','Logistik','Medizin & Pharma'].map((t) => <div><b>{t}</b><p>Wir unterstützen Unternehmen dabei, ihre Prozesse zu vernetzen und Daten zukunftssicher zu nutzen.</p></div>)}</section>
  <section class="zitat"><img src={b('91')} alt="" loading="lazy" /><div><h2>Einfach führt zum Erfolg</h2><p>„Komplexe Themen erfordern klare Prozesse. Wir bringen Struktur in digitale Projekte.“</p><small><b>Max Beispiel</b>, Geschäftsführer</small></div></section>
  <section class="fragen"><h2>Häufige Fragen und Antworten</h2>{['Was beinhaltet eine IT-Dienstleistung konkret?','Können bestehende Systeme integriert werden?','Wie läuft die Automatisierung ab?','Welche Rolle spielt IT-Sicherheit?'].map((f) => <details><summary>{f}<i>+</i></summary><p>Wir klären das im ersten Gespräch für Ihre Lage.</p></details>)}</section>
  <section class="ende"><div><h2>Sichern Sie sich jetzt Ihr kostenfreies Erstgespräch</h2><ul><li>Unsere Einschätzung zu Ihrer Herausforderung</li><li>Erste konkrete Lösungsansätze</li><li>Orientierung zu Budget und Zeit</li></ul><a href="#">Jetzt Termin auswählen</a></div><img src={b('64')} alt="" loading="lazy" /></section>
</main>
<footer><div><b class="wm">systemwerk<i>.</i></b><p class="box"><span>★★★★★</span><br />Hervorragend</p></div>{['Navigation','Leistungen','Rechtliches','Kontakt'].map((t) => <ul><li class="t">{t}</li><li>Start</li><li>Fallstudien</li><li>Über uns</li><li>Kontakt</li></ul>)}</footer>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; background: #f8faff; color: #14161c; font-family: var(--font-body); font-size: 16px; line-height: 1.5; overflow-x: clip; } img { display: block; width: 100%; object-fit: cover; } h1, h2, h3, p, ul { margin: 0; padding: 0; font-weight: 500; } ul { list-style: none; } a { color: inherit; text-decoration: none; } p { font-weight: 400; }
  h2 { font-size: clamp(30px, 3.5vw, 50px); line-height: 1.16; letter-spacing: -.025em; }
  header { position: absolute; inset: 0 0 auto; z-index: 5; display: flex; align-items: center; gap: 48px; padding: 24px 90px; } .wm { font-size: 28px; font-weight: 500; letter-spacing: -.03em; } .wm i { color: #3764eb; font-style: normal; } nav { display: flex; gap: 32px; font-size: 14px; margin-right: auto; } .an { color: #3764eb; } .sp { font-size: 13px; } .kn { background: #3764eb; color: #fff; padding: 10px 22px; border-radius: 86px; font-size: 14px; }
  .auftakt { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 40px; min-height: 690px; padding: 110px 90px 40px; background: linear-gradient(180deg, #dfe7ff 0, #f8faff 62%); } h1 { font-size: 60px; line-height: 1.12; letter-spacing: -.03em; } .auftakt p { max-width: 520px; margin-top: 16px; } .mission { font-size: 15px; } .ak { display: flex; gap: 12px; margin-top: 26px !important; } .zw { background: #fff; padding: 10px 22px; border-radius: 86px; border: 1px solid #dfe3ee; font-size: 14px; } .bew { display: flex; gap: 8px; align-items: center; font-size: 14px; } .bew span { color: #f5a800; letter-spacing: .1em; } .g { color: #4285f4; font-weight: 700; } .auftakt img { height: 460px; border-radius: 14px; }
  .logos { text-align: center; padding: 30px 0 90px; overflow: hidden; } .logos div { display: flex; gap: 90px; justify-content: center; margin-top: 30px; font-size: 22px; font-weight: 600; white-space: nowrap; opacity: .85; }
  .warum { display: grid; grid-template-columns: 40% 1fr; gap: 50px; padding: 40px 90px 120px; } .blau { position: sticky; top: 30px; align-self: start; background: linear-gradient(180deg, #3764eb 0, #1c2f8c 100%); color: #fff; padding: 34px; border-radius: 10px; min-height: 560px; display: flex; flex-direction: column; gap: 20px; } .blau a { background: #fff; color: #14161c; padding: 9px 20px; border-radius: 86px; align-self: flex-start; font-size: 14px; margin-top: auto; }
  .warum ul { display: grid; grid-template-columns: 1fr 1fr; gap: 54px 40px; } .warum i { display: block; width: 34px; height: 34px; border-radius: 8px; background: #e6ecff; } .warum h3 { font-size: 20px; margin: 14px 0 6px; letter-spacing: -.01em; } .warum li p { font-size: 15px; color: #4a4f5c; }
  .dunkel { background: #2b2b2b; color: #fff; padding: 110px 90px; text-align: center; } .m { max-width: 640px; margin: 18px auto 60px; } .zwei { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; text-align: left; } article { background: #343434; border-radius: 10px; padding: 28px; } article img { height: 220px; border-radius: 8px; opacity: .8; } article h3 { font-size: 30px; margin: 20px 0 10px; letter-spacing: -.02em; } article ul { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 18px 0; font-size: 14px; } article li::before { content: '●'; color: #3764eb; margin-right: 8px; } article a { display: inline-block; border: 1px solid #666; padding: 8px 18px; border-radius: 86px; font-size: 14px; }
  .faelle, .fragen { padding: 110px 90px; } .k { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; } .k a { border: 1px solid #dfe3ee; padding: 8px 18px; border-radius: 86px; font-size: 14px; } .faelle ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; } .faelle img { height: 250px; border-radius: 4px; } .faelle small { display: inline-block; margin: 14px 0 6px; padding: 2px 10px; border: 1px solid #dfe3ee; border-radius: 4px; } .faelle h3 { font-size: 22px; line-height: 1.25; letter-spacing: -.01em; } .faelle p { font-size: 14px; margin: 8px 0; color: #4a4f5c; } .faelle a { color: #3764eb; font-size: 14px; }
  .mosaik { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 40px 90px; grid-auto-rows: 280px; } .mosaik img { height: 100%; border-radius: 4px; } .mosaik > div a { display: inline-block; margin-top: 24px; background: #000; color: #fff; padding: 9px 20px; border-radius: 86px; font-size: 14px; } .z { background: #fff; border-radius: 6px; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #4a4f5c; font-size: 15px; } .z b { font-size: 64px; font-weight: 400; color: #14161c; letter-spacing: -.03em; line-height: 1.1; }
  .zeilen { padding: 70px 90px; } .zeilen div { display: grid; grid-template-columns: 34% 1fr; padding: 40px 28px; border-bottom: 1px solid #e0e4ee; } .zeilen b { font-size: 21px; font-weight: 500; } .zeilen p { font-size: 15px; color: #4a4f5c; }
  .zitat { position: relative; height: 640px; color: #fff; } .zitat img { height: 100%; filter: brightness(.6); } .zitat div { position: absolute; left: 90px; top: 50%; translate: 0 -50%; max-width: 620px; } .zitat p { font-size: 24px; margin: 22px 0; }
  .fragen { text-align: center; } .fragen h2 { margin-bottom: 40px; } details { max-width: 880px; margin: 0 auto 14px; background: #fff; border: 1px solid #dfe3ee; border-radius: 4px; padding: 16px 22px; text-align: left; } summary { display: flex; justify-content: space-between; list-style: none; cursor: pointer; font-weight: 500; } summary i { color: #3764eb; font-style: normal; }
  .ende { display: grid; grid-template-columns: 1.3fr 1fr; margin: 0 90px 110px; background: #3764eb; color: #fff; border-radius: 10px; overflow: hidden; } .ende div { padding: 50px; } .ende ul { margin: 20px 0; } .ende li { font-weight: 400; padding: 3px 0; } .ende li::before { content: '✓ '; } .ende a { background: #fff; color: #14161c; padding: 10px 22px; border-radius: 86px; font-size: 14px; display: inline-block; } .ende img { height: 100%; }
  footer { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: 30px; background: #2b2b2b; color: #fff; padding: 70px 90px; font-size: 14px; } .box { background: #444; padding: 14px; border-radius: 6px; margin-top: 20px; max-width: 170px; } .box span { color: #f5a800; } .t { color: #7f9cff; font-size: 12px; margin-bottom: 10px; }
  @media (max-width: 760px) { header { padding: 16px; gap: 12px; } nav, .sp { display: none; } .kn { margin-left: auto; } .auftakt, .warum, .zwei, .faelle ul, .ende, footer { grid-template-columns: 1fr; padding-inline: 16px; } .auftakt { padding-top: 90px; } h1 { font-size: 38px; } .ak { flex-wrap: wrap; } .auftakt img { height: 260px; } .warum ul { grid-template-columns: 1fr; } .blau { position: static; min-height: 0; } .dunkel, .faelle, .fragen, .zeilen { padding-inline: 16px; } .mosaik { grid-template-columns: 1fr 1fr; padding-inline: 16px; grid-auto-rows: 200px; } .mosaik > div { grid-column: 1 / -1; } .z b { font-size: 42px; } .zeilen div { grid-template-columns: 1fr; gap: 6px; padding: 20px 0; } .zitat div { left: 16px; right: 16px; } .ende { margin-inline: 16px; padding: 0; } .logos div { justify-content: flex-start; gap: 40px; } }
</style>
</body></html>
