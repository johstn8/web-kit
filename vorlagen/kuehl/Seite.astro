---
/**
 * Vorlage "kuehl", Aufbau nach mercury.com.
 * Schmale Inhaltsspalte von 860 px, Baender wechseln Blauschwarz, Sand, Weiss, Hellblau.
 * Kopfzeile durchscheinend ueber allem, Wortmarke in Sperrung. Auftakt: Foto ueber die
 * volle Hoehe, mittiger leichter Titel, E-Mail-Feld und zwei Pillen im Glas. Beim
 * Scrollen steigt das Geraet ins Foto. Zentrierte Statements, Kundenreihe, Stimme mit
 * Portraet, Kacheln im Raster mit Text darunter, versetzte Paare, drei hohe Kacheln,
 * Spotlight-Karten, breiter Fuss.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Kontor Geschäftskonto</title></head>
<body>
<header><a class="wort" href="#"><i></i>KONTOR</a><nav><a href="#">Produkte ⌄</a><a href="#">Lösungen ⌄</a><a href="#">Wissen ⌄</a><a href="#">Über uns ⌄</a><a href="#">Preise</a></nav><a class="login" href="#">Anmelden</a><a class="auf" href="#">Konto eröffnen</a></header>
<main>
  <section class="auftakt">
    <div class="klebt">
      <img src={b('229')} alt="Nebel über einem Wald" />
      <div class="txt"><h1>Radikal anders wirtschaften</h1><p>Eröffnen Sie in zehn Minuten ein Konto, wie Sie es noch nicht hatten.</p>
        <form><input aria-label="E-Mail" placeholder="Ihre E-Mail" /><button type="button">Konto eröffnen</button><a href="#">Demo ansehen</a></form></div>
      <p class="fein">Kontor ist ein Beispielangebot, kein Kreditinstitut. Vorlage mit Musterinhalt.</p>
      <div class="geraet" aria-hidden="true"><div><aside>{Array.from({ length: 7 }).map(() => <i></i>)}</aside><section><b>Guten Morgen, Jana</b><strong>58.293,47 €</strong><svg viewBox="0 0 300 70"><path d="M0 60 40 48 80 52 120 30 160 36 200 18 240 24 300 6" fill="none" stroke="#7f8cff" stroke-width="2" /></svg><span></span><span></span></section></div></div>
    </div>
  </section>

  <section class="dunkel mitte"><h2>Geschätzt von 4.500 der ehrgeizigsten Unternehmen im Land</h2><ul class="logos"><li>Nordwerk</li><li>Lumen</li><li>Partia</li><li>Elfwerk</li><li>Fennek</li></ul></section>

  <section class="dunkel spalte">
    <figure class="stimme"><img src={b('91')} alt="" /><blockquote>„Bei den meisten Banken dauert alles Tage. Hier läuft fast alles in Minuten aus der App.“<footer>Karin Sommer<br /><small>Gründerin, Lumen</small></footer></blockquote></figure>
    <div class="linie"></div>
    <h3 class="links">Banking war lästig. Jetzt ist es Ihr Vorsprung.</h3>
  </section>

  <section class="sand spalte"><ul class="vier">
    {[['Karten in wenigen Klicks', 'Virtuelle Karten für jeden Zweck, sofort, in jeder Anzahl.', 'karte'], ['Rechnungen zahlen sich selbst', 'Belege werden gelesen und Empfänger erkannt.', 'beleg'], ['Bezahlt werden ohne Flickwerk', 'Rechnungen schreiben, Zahlungen verfolgen, Kunden erinnern.', 'form'], ['Belege ohne Hinterherlaufen', 'Fotos hochladen, Zuordnung läuft von allein.', 'haken']].map(([t, x, a]) => <li><div class:list={['muster', a]}></div><h4>{t}</h4><p>{x}</p></li>)}
  </ul></section>

  <section class="weiss spalte">
    <p class="zitat">„Kontor hat verändert, was ich von einer Bank erwarte. Die Sorgfalt im Produkt ist etwas anderes.“</p><p class="wer">Paul Brandt<br /><small>Gründer, Partia</small></p>
    <div class="paar"><h3>Schnell starten. Nie anhalten.</h3><div class="tief"><i></i></div></div>
    <ul class="zeilen"><li><b>• Online in zehn Minuten</b><span>Giro und Tagesgeld ohne Filialbesuch und Papierkram.</span></li><li>Kreditkarte sofort</li><li>Alle Bankaufgaben in Sekunden</li></ul>
    <div class="paar um"><div class="kugel"></div><div><h3>Hören Sie auf, Geld an Gebühren zu verlieren.</h3><ul class="zeilen"><li><b>• Überweisen ohne Gebühr</b><span>0 € für Inlandszahlungen und Lastschrift.</span></li><li>1,5 % zurück auf Kartenumsätze</li></ul></div></div>
  </section>

  <section class="hell spalte"><h3 class="links">Führen Sie Ihr Geschäft wie ein Profi</h3><ul class="vier">
    {[['Volle Übersicht', 'Alle Konten und Mittel an einem Ort.', 'ringe'], ['Automatik', 'Regeln verschieben, zahlen und ordnen für Sie.', 'regel'], ['Teamverwaltung', 'Limits, Rechte und Freigaben je Person.', 'team'], ['Begleitung', 'Persönliche Betreuung, wenn Sie sie brauchen.', 'punkte']].map(([t, x, a]) => <li><div class:list={['muster', a]}></div><h4>{t}</h4><p>{x}</p></li>)}
  </ul></section>

  <section class="dunkel mitte hoch"><h2>Sie bauen etwas, das bleibt.<br />Wir auch.</h2></section>
  <section class="dunkel spalte"><h3 class="links linie-o">Normaler Schutz reicht nicht. Wir gehen weiter.</h3><ul class="drei">
    {[['Zwanzigfacher Schutz', 'Bis zu fünf Millionen Einlagen über Partnerbanken abgesichert.'], ['Mehr Sicherheit', 'Betrugserkennung, Passkeys und Warnungen im Dunkeln.'], ['Alles in der Hand', 'Sperren, Limits, Freigaben: Sie entscheiden.']].map(([t, x], i) => <li><div class:list={['hochk', `h${i}`]}></div><h4>{t}</h4><p>{x}</p></li>)}
  </ul></section>
  <section class="dunkel spalte"><h3 class="links">Kontor im Gespräch</h3><ul class="drei presse">{[['Handelsblatt-Muster', 'Eine Milliarde Umsatz im Jahr'], ['Fachblatt', 'Banking für die Zeit der Agenten'], ['Wirtschaftsradio', 'Bewertung erreicht neuen Wert']].map(([n, t]) => <li><div>{n}</div><h4>{t}</h4><i>→</i></li>)}</ul></section>
</main>
<footer class="fuss spalte"><div>{['Banking', 'Plattform', 'Wissen', 'Finanzen'].map((t) => <ul><li>{t}</li><li>Konto</li><li>Karten</li><li>Zahlungen</li><li>Kredit</li></ul>)}</div></footer>
<style is:global>
  * { box-sizing: border-box; } html { background: #171721; } body { margin: 0; font-family: var(--font-body); color: #f3f3f7; letter-spacing: .005em; line-height: 1.45; font-size: 16px; overflow-x: clip; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, h4, p, ul, figure, blockquote { margin: 0; padding: 0; font-weight: 400; } ul { list-style: none; } a { color: inherit; text-decoration: none; }
  header { position: fixed; inset: 0 0 auto; z-index: 30; height: 72px; display: flex; align-items: center; gap: 22px; padding: 0 32px; background: rgb(23 23 33 / .44); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); font-size: 15px; }
  .wort { letter-spacing: .24em; font-size: 14px; display: flex; gap: 10px; align-items: center; } .wort i { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid currentColor; }
  nav { display: flex; gap: 34px; margin: 0 auto; } .auf { background: #4a5de0; color: #fff; padding: 8px 18px; border-radius: 32px; font-weight: 500; }
  .auftakt { height: 250vh; } .klebt { position: sticky; top: 0; height: 100vh; overflow: hidden; } .klebt > img { position: absolute; inset: 0; }
  .txt { position: relative; text-align: center; padding-top: 19vh; max-width: 660px; margin: auto; animation: weg linear both; animation-timeline: scroll(root); animation-range: 0 60vh; }
  h1 { font-size: 49px; line-height: 1.15; font-family: var(--font-display); } .txt p { margin: 12px auto 0; max-width: 460px; }
  form { display: flex; gap: 8px; justify-content: center; margin-top: 34px; } input { width: 230px; border: 0; padding: 11px 20px; border-radius: 40px; background: rgb(255 255 255 / .16); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: #fff; font: inherit; } input::placeholder { color: rgb(255 255 255 / .85); }
  form button { border: 0; background: #4a5de0; color: #fff; padding: 11px 22px; border-radius: 40px; font: inherit; font-weight: 500; } form a { padding: 11px 22px; border-radius: 40px; background: rgb(175 178 206 / .3); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .fein { position: absolute; left: 50%; translate: -50% 0; bottom: 26px; font-size: 13px; padding: 6px 20px; border-radius: 30px; background: rgb(0 0 0 / .32); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); white-space: nowrap; }
  .geraet { position: absolute; left: 50%; bottom: -70vh; width: 780px; height: 70vh; translate: -50% 0; background: #2a2a34; border-radius: 22px 22px 0 0; padding: 14px; box-shadow: 0 -30px 80px rgb(0 0 0 / .4); animation: rauf linear both; animation-timeline: scroll(root); animation-range: 30vh 130vh; }
  .geraet > div { display: flex; height: 100%; background: #14141c; border-radius: 10px; } .geraet aside { width: 150px; padding: 24px 16px; display: grid; align-content: start; gap: 14px; border-right: 1px solid #2a2a36; } .geraet aside i { height: 8px; border-radius: 4px; background: #2d2d3a; }
  .geraet section { flex: 1; padding: 26px; display: grid; gap: 12px; align-content: start; } .geraet strong { font-size: 30px; font-weight: 500; } .geraet span { height: 46px; border-radius: 8px; background: #1e1e29; }
  @keyframes rauf { to { transform: translateY(-74vh); } } @keyframes weg { to { opacity: 0; transform: translateY(-40px); } }
  .dunkel { background: #171721; } .sand { background: #efeee9; color: #1c1c24; } .weiss { background: #fbfcfd; color: #1c1c24; } .hell { background: #f4f7fb; color: #1c1c24; }
  .spalte { padding: 60px max(24px, calc(50% - 430px)); } .mitte { text-align: center; padding: 170px 24px 60px; } .hoch { padding-block: 200px 120px; }
  h2 { font-size: 42px; line-height: 1.2; max-width: 640px; margin: auto; font-family: var(--font-display); } .logos { display: flex; justify-content: center; gap: 56px; margin-top: 70px; font-size: 24px; font-weight: 500; }
  .stimme { display: grid; grid-template-columns: 1fr 1fr; background: #20202c; border-radius: 12px; overflow: hidden; height: 400px; } .stimme img { order: 2; } blockquote { padding: 60px 30px; align-self: center; font-size: 19px; } blockquote footer { margin-top: 24px; font-size: 15px; }
  .linie { height: 1px; background: #33333f; margin: 90px 0 40px; } h3.links { font-size: 28px; line-height: 1.25; max-width: 420px; padding-bottom: 40px; font-family: var(--font-display); }
  .vier { display: grid; grid-template-columns: 1fr 1fr; gap: 56px 26px; } h4 { font-size: 16px; font-weight: 600; margin: 16px 0 4px; } .vier p, .drei p { font-size: 15px; opacity: .78; }
  .muster { height: 320px; border-radius: 12px; background: #e3e1da; position: relative; overflow: hidden; } .hell .muster { background: #dbe6ef; } .karte::after { content: 'Aktiv'; position: absolute; inset: 40px 70px 30px; background: linear-gradient(160deg, #4a4a5a, #2c2c38); border-radius: 12px; color: #fff; padding: 16px; font-size: 13px; box-shadow: 0 20px 40px rgb(0 0 0 / .3); }
  .beleg::after { content: 'Rechnung'; position: absolute; inset: 40px 50px 0; background: #fff; border-radius: 10px 10px 0 0; padding: 20px; font-size: 28px; color: #aaa; } .form::after { content: '1. Mai 2026'; position: absolute; inset: 40px 60px 0; background: #fff; border-radius: 10px 10px 0 0; padding: 26px; color: #555; } .haken::after { content: '✓  Hochgeladen 3/3'; position: absolute; inset: 45% 40px auto; padding: 18px 24px; background: #fff; border-radius: 14px; color: #555; font-size: 20px; box-shadow: 0 10px 30px rgb(0 0 0 / .08); }
  .ringe { background: radial-gradient(circle at 35% 50%, transparent 30%, #62677a 31%, #2c2f3c 62%), #2c2f3c !important; } .regel::after, .team::after { content: ''; position: absolute; inset: 40px 60px 0; background: #fff; border-radius: 12px 12px 0 0; } .punkte { background: radial-gradient(circle at 50% 50%, #2a2c38 18%, #474a58 19%, #2a2c38 46%) !important; }
  .zitat { text-align: center; font-size: 24px; max-width: 640px; margin: 60px auto 20px; } .wer { text-align: center; margin-bottom: 110px; } .paar { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: start; } .paar h3 { font-size: 22px; } .tief { height: 420px; background: linear-gradient(180deg, #454860, #2e3040); border-radius: 12px; display: grid; place-items: center; } .tief i { width: 90px; height: 90px; border-radius: 50%; border: 3px double #fff; }
  .zeilen { max-width: 400px; margin-top: 30px; border-top: 1px solid #ddd; } .zeilen li { padding: 14px 0; border-bottom: 1px solid #ddd; font-size: 15px; } .zeilen b { font-weight: 500; display: block; } .zeilen span { opacity: .7; } .um { margin-top: 100px; } .kugel { height: 380px; border-radius: 12px; background: radial-gradient(circle, #fff 26%, #e9e9e4 27%, #f5f5f1 60%); }
  .drei { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; } .hochk { height: 300px; border-radius: 12px; background: #2a2a3a; } .h0 { background: linear-gradient(90deg, #2a2a3a 20%, #e9e9f1 21%, #e9e9f1 62%, #2a2a3a 63%); } .h1 { background: repeating-radial-gradient(circle, #2a2a3a 0 10px, #454556 11px 13px); } .h2 { background: linear-gradient(0deg, #e9e9f1 18%, #2a2a3a 19%); }
  .presse li { background: #20202c; border-radius: 12px; padding: 16px; min-height: 280px; display: grid; align-content: start; gap: 18px; } .presse div { height: 100px; border-radius: 8px; background: #2a2a38; display: grid; place-items: center; font-size: 15px; } .presse h4 { font-size: 20px; font-weight: 500; margin: 0; } .presse i { font-style: normal; }
  .fuss { background: #171721; padding-block: 90px 60px; } .fuss div { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; font-size: 14px; } .fuss li:first-child { opacity: .6; margin-bottom: 8px; }
  @media (max-width: 760px) { nav, .login { display: none; } .auf { margin-left: auto; } form { flex-wrap: wrap; } h1 { font-size: 36px; padding-inline: 16px; } .geraet { width: 92vw; } .geraet aside { display: none; } .stimme, .vier, .paar, .drei { grid-template-columns: 1fr; height: auto; } .stimme img { height: 300px; } .logos { flex-wrap: wrap; gap: 24px; } h2 { font-size: 32px; } .fein { white-space: normal; width: 90%; text-align: center; border-radius: 12px; } .fuss div { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { .txt, .geraet { animation: none; } }
</style>
</body></html>
