---
/**
 * Vorlage "gericht", Aufbau nach lagalante-restaurant.de/nuovo.
 * Reinweiss. Gerichte ohne Rahmen an den Rand geschnitten, Gross-Zeile bricht links
 * aus dem Satzspiegel, blasses Wort im Hintergrund, senkrechte Haarlinie als Ueberleitung,
 * riesiger Bildanschnitt, Text mit Gericht rechts, Rechteckfotos am Rand, Karte mittig
 * aus unterstrichenen Rubriken mit Plus, Tuerkisband, Reservierung zweispaltig,
 * dunkler Fuss. "Tisch buchen" schwebt unten rechts.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Osteria Beispiel</title></head>
<body>
<header><a class="marke" href="#"><b>BEISPIEL</b><small>OSTERIA ITALIANA</small></a><nav><a href="#">HOME</a><a class="an" href="#">KARTE</a><a href="#">TISCHRESERVIERUNG</a></nav></header>
<a class="buch" href="#"><i></i>TISCH BUCHEN</a>
<main>
  <section class="start">
    <div class="teller t1"><img src={b('102')} alt="Früchte auf weißem Grund" /></div>
    <div class="teller t2"><img src={b('63')} alt="" /></div>
    <div class="geist g1" aria-hidden="true"></div>
    <div class="tx"><h1>OSTERIA<br />BEISPIEL</h1><p>Das Restaurant feiert die traditionelle Küche mit natürlichen, saisonalen Zutaten und verbindet alte Rezepte mit einem modernen Touch.</p></div>
  </section>
  <div class="linie"></div>
  <section class="anschnitt"><img src={b('225')} alt="" /></section>
  <div class="linie"></div>
  <section class="geschichte"><div><h2>OSTERIA<br />BEISPIEL</h2><p><i>Esskulturen erzählen ihre alte Geschichte.</i></p><p>Die Osteria nimmt Sie jeden Monat mit in eine neue Provinz Italiens, mit der Mission, den Ursprung der alten, einfachen Küche zu erhalten und mit einem Hauch von Moderne zu kombinieren.</p><p>Schätze der antiken Essenskulturen mit naturbelassenen Zutaten und die Entfaltung ihrer Aromen zu nutzen, das sind die Streichelverbindungen für Ihre Seele.</p></div><div class="teller t3"><img src={b('102')} alt="" /></div></section>
  <section class="karte">
    <div class="geist g2" aria-hidden="true"></div>
    <img class="koch" src={b('91')} alt="Koch bei der Arbeit" loading="lazy" />
    <div class="teller t4"><img src={b('63')} alt="" /></div>
    <img class="raum" src={b('42')} alt="Gastraum" loading="lazy" />
    <div class="liste"><h3>SNACK +</h3><p>Giardiniera<br /><i>Italienisches eingelegtes Gemüse</i><br /><b>€ 7,00</b></p><p>Olive Verdi<br /><i>Grüne Oliven</i><br /><b>€ 5,00</b></p>{['SALUMI','ANTIPASTI','PRIMI PIATTI','SECONDI PIATTI','CONTORNI','DESSERT'].map((t) => <details><summary>{t} +</summary><p>Wechselt mit der Saison. Sprechen Sie uns an.</p></details>)}</div>
  </section>
  <div class="tuerkis"></div>
  <section class="reserv"><div><h3>TISCH RESERVIEREN</h3><p><b>Telefon für Tischreservierung:</b><br /><a href="#">+49 030 00 00 00</a></p></div><div><p><b>ÖFFNUNGSZEITEN</b><br />Dienstag bis Sonntag<br />18.00 bis 23.00<br />Montag geschlossen</p><p class="adr">Musterstraße 82<br />10823 Berlin</p></div></section>
</main>
<footer><b class="fm">BEISPIEL</b><small>OSTERIA ITALIANA</small><div><p><u>ÖFFNUNGSZEITEN</u><br />Dienstag bis Sonntag<br />18.00 bis 23.00</p><p><u>ADRESSE</u><br />Musterstraße 82<br />10823 Berlin</p><p><u>FOLGEN</u><br />Instagram</p></div><p class="kl">Impressum · Datenschutz · Beispielinhalt einer Vorlage</p></footer>
<style is:global>
  * { box-sizing: border-box; } body { margin: 0; background: #fff; color: #1a1a1a; font-family: var(--font-body); font-size: 15px; line-height: 1.8; overflow-x: clip; } img { display: block; width: 100%; height: 100%; object-fit: cover; } h1, h2, h3, p { margin: 0; font-family: inherit; } a { color: inherit; } h1, h2, h3, .geist, .fm, summary { font-family: var(--font-display); font-weight: 400; }
  header { position: fixed; inset: 0 0 auto; z-index: 20; height: 90px; display: flex; justify-content: space-between; align-items: center; padding: 0 70px; background: #fff; } .marke { text-decoration: none; display: grid; line-height: 1.1; text-align: center; } .marke b { font: 400 30px var(--font-display); letter-spacing: .24em; } .marke small { font-size: 10px; letter-spacing: .36em; }
  nav { display: flex; font-size: 10.5px; letter-spacing: .14em; } nav a { text-decoration: none; padding: 0 26px; border-left: 1px solid #ccc; color: #666; } nav a:first-child { border: 0; } nav .an { color: #111; font-weight: 700; }
  .buch { position: fixed; right: 26px; bottom: 26px; z-index: 20; background: #fff; box-shadow: 0 2px 10px rgb(0 0 0 / .14); padding: 12px 24px; font-size: 11px; letter-spacing: .12em; font-weight: 700; text-decoration: none; color: #2a3a6a; } .buch i { position: absolute; right: 12px; top: -10px; width: 44px; height: 2px; background: #111; }
  .teller { border-radius: 50%; overflow: hidden; -webkit-mask-image: radial-gradient(circle, #000 66%, transparent 71%); mask-image: radial-gradient(circle, #000 66%, transparent 71%); }
  .start { position: relative; height: 100vh; min-height: 720px; overflow: hidden; } .t1 { position: absolute; right: 18%; top: 40px; width: 640px; height: 640px; } .t2 { position: absolute; right: -60px; bottom: 30px; width: 470px; height: 470px; } .geist { color: #f3f3f2; letter-spacing: .02em; line-height: 1; } .g1 { position: absolute; left: 3%; bottom: 8px; font-size: 90px; }
  .tx { position: absolute; left: 0; bottom: 18%; max-width: 480px; } h1 { font-size: 72px; line-height: 1.02; margin-left: -6px; } .tx p { margin: 16px 0 0 8px; color: #555; max-width: 400px; }
  .linie { width: 1px; height: 200px; background: #333; margin: 0 auto; } .anschnitt { height: 680px; }
  .geschichte { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: center; max-width: 1300px; margin: 60px auto 120px; padding: 0 70px; } h2 { font-size: 55px; line-height: 1; margin-bottom: 8px; } .geschichte p { color: #555; } .t3 { height: 340px; }
  .karte { position: relative; min-height: 1120px; text-align: center; padding-top: 170px; } .g1::before { content: 'CUCINA\A ITALIANA'; white-space: pre; } .g2::before { content: 'MENU'; } .g2 { position: absolute; left: 0; right: 0; top: 0; font-size: 130px; } .koch { position: absolute; left: 0; top: 0; width: 330px; height: 200px; } .t4 { position: absolute; left: -40px; top: 380px; width: 380px; height: 380px; } .raum { position: absolute; right: 30px; top: 130px; width: 420px; height: 530px; }
  .liste { max-width: 400px; margin: auto; position: relative; } h3 { font-size: 32px; text-decoration: underline; text-underline-offset: 6px; margin: 16px 0; font-weight: 400; } .liste p { font-size: 15px; color: #444; margin-bottom: 10px; line-height: 1.55; } details { margin: 12px 0; } summary { font-size: 32px; text-decoration: underline; text-underline-offset: 6px; cursor: pointer; list-style: none; line-height: 1.5; }
  .tuerkis { height: 76px; background: #008080; } .reserv { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 1000px; margin: 0 auto; padding: 60px 40px; text-align: center; } .reserv a { color: #008080; font-weight: 700; } .adr { color: #008080; font-weight: 700; margin-top: 20px; }
  footer { background: #1a1a1a; color: #fff; text-align: center; padding: 40px 40px 26px; } .fm { display: block; font-size: 40px; letter-spacing: .24em; } footer small { letter-spacing: .36em; font-size: 12px; } footer div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin: 30px auto; max-width: 1100px; font-size: 13px; } footer u { font: 400 26px var(--font-display); text-underline-offset: 5px; } .kl { font-size: 12px; opacity: .8; }
  @media (max-width: 760px) { header { padding: 0 16px; height: 70px; } nav { display: none; } .t1 { width: 90vw; height: 90vw; right: -10vw; top: 70px; } .t2 { width: 50vw; height: 50vw; right: -14vw; bottom: 10px; } .tx { bottom: 12%; left: 16px; right: 16px; } h1 { font-size: 52px; } .tx p { margin-left: 0; } .anschnitt { height: 320px; } .geschichte, .reserv, footer div { grid-template-columns: 1fr; padding-inline: 16px; } .karte { min-height: auto; padding-inline: 16px; } .koch, .t4, .raum { position: static; width: 100%; height: 220px; margin-bottom: 16px; } .t4 { width: 70vw; height: 70vw; } .g2 { font-size: 80px; } }
</style>
</body></html>
