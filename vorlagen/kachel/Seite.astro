/**
 * Vorlage "kachel", Aufbau nach dentalize.de.
 * Weiss, sehr ruhige Grotesk in Normalgewicht. Ueberschriften zweistimmig: die Rubrik in
 * Grau, die Aussage in Schwarz, beides ein Satzbild. Hochformatige Filmkacheln mit Radius
 * 13 bis 20 Pixel, Kopfzeile mit Navigationspille, Aktionen als Pillen in Petrol. Grosse
 * gerundete Filmflaeche, Zitat, Kartenreihe, Bento auf Hellgrau, gestapelte Filme,
 * Streubild um einen Satz, Ablauf mit klebendem Bild, Stimmen, Team, Zahlen, Fragen.
 * Das Original traegt in den Schritten ovale Stichwoerter, die keine Knoepfe sind. Der
 * Nutzer hat sie als KI-typisch benannt; hier steht stattdessen ein Satz.
 * In qa.sh --erlaubt teilauszeichnung setzen.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
const b = (n: string) => `./bilder/${n}.webp`;
const leute = [['1005','Malerbetrieb in Köpenick'],['1027','Tischlerei in Pankow'],['832','Büro und Disposition'],['1060','Café und Rösterei'],['856','Geschäftsführung'],['823','Ausbildung im zweiten Jahr'],['64','Kundenberatung'],['91','Meisterbetrieb in Spandau']];
const schritte = [['1. Plan','Im ersten Gespräch klären wir, wen ihr erreichen wollt: Kunden, Bewerber oder beide. Daraus entstehen Themen und kurze Drehbücher, die zu eurem Betrieb passen.','1059'],['2. Drehtag','Wir kommen an einem Tag zu euch und drehen zwischen den Aufträgen. Niemand muss etwas auswendig lernen, wir führen durch jedes Gespräch.','1060'],['3. Schnitt','Innerhalb von drei Wochen liegen die ersten Filme vor. Ihr gebt sie frei, wir ändern, was noch nicht stimmt.','60'],['4. Veröffentlichung','Wir stellen die Filme nach einem festen Plan ein und antworten auf Fragen, solange ihr das möchtet.','180'],['5. Auswertung','Einmal im Monat seht ihr, wie viele Anfragen und Bewerbungen aus den Filmen kommen.','42']];
---
<!doctype html>
<html lang="de"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>FILMBAR – Video für Handwerksbetriebe</title></head>
<body>
<header><a class="wm" href="#">FILMBAR</a><nav aria-label="Hauptnavigation"><a href="#vorteile">Vorteile</a><a href="#service">Service</a><a href="#ablauf">Ablauf</a><a href="#stimmen">Stimmen</a><a href="#team">Über uns</a><a href="#fragen">Fragen</a></nav><a class="p" href="#termin">Termin buchen</a></header>
<main>
  <section class="start"><h1 data-zeig>Ein Betrieb, über den die Stadt spricht, bevor jemand anruft.</h1><p data-zeig>Wir drehen echte Filme mit eurem Team und machen daraus eine Marke, die Kunden und Bewerber kennen. Sichtbar und glaubwürdig, mit einem Drehtag im Quartal.</p>
    <div class="band"><button class="pf l" type="button" aria-label="Zurück" data-band="-1">←</button><ul tabindex="0" aria-label="Filme, waagerecht scrollbar">{leute.map(([n, t]) => <li><img src={b(n)} alt={t} /><span aria-hidden="true">▶</span></li>)}</ul><button class="pf r" type="button" aria-label="Weiter" data-band="1">→</button></div></section>
  <section class="film" data-zeig><img src={b('1059')} alt="Drehtag in einer Werkstatt" loading="lazy" /><a href="#" aria-label="Film ansehen">▶</a></section>
  <section class="zitat"><blockquote data-zeig>„Seit den Filmen kennt uns <i>jeder im Bezirk</i>, und wir mussten <i>keine einzige Stelle</i> mehr ausschreiben.“</blockquote><p><img src={b('1005')} alt="" loading="lazy" />Jonas Beispiel, Malerbetrieb in Köpenick</p>
    <ul class="siegel"><li><b>5,0</b>Google</li><li><b>Sehr gut</b>Kundenportal</li></ul></section>
  <section class="marken" aria-label="Partner"><ul><li>Handwerkskammer</li><li>Innung Süd</li><li>BAUHOF</li><li>meisterwerk</li><li>Kreishandwerk</li></ul></section>
  <section class="vorteile" id="vorteile"><div class="kopf"><h2><span>Vorteile.</span><br />Davon profitiert ein bekannter Betrieb</h2><a class="p" href="#termin">Gespräch vereinbaren</a></div>
    <ul data-zeig tabindex="0" aria-label="Vorteile, waagerecht scrollbar">{[['1060','Passende Leute einstellen','Bewerber sehen, wie es bei euch zugeht, und melden sich von selbst.'],['823','Attraktiver Ausbildungsbetrieb','Azubis erzählen selbst, und das glaubt man ihnen.'],['1005','Neue Kunden gewinnen','Wer euch im Film gesehen hat, ruft mit einem klaren Auftrag an.'],['832','Weniger Rückfragen','Häufige Fragen sind im Film beantwortet, bevor das Telefon klingelt.']].map(([n, t, p]) => <li><img src={b(n)} alt="" loading="lazy" /><h3>{t}</h3><p>{p}</p></li>)}</ul></section>
  <section class="service" id="service"><h2><span>Service.</span><br />Alles aus einer Hand, ohne Aufwand für euch</h2>
    <div class="bento"><article class="g"><h3>Auf allen Kanälen sichtbar</h3><p>Ein Drehtag ergibt Filme für Instagram, TikTok, YouTube und eure Website.</p><div class="tel">{['1027','1060','1005','823'].map((n) => <img src={b(n)} alt="" loading="lazy" />)}</div></article>
      <article><h3>Unkomplizierte Umsetzung</h3><p>Erste Filme nach drei Wochen, dann ein fester Rhythmus.</p><ul class="zeilen"><li><i></i>Woche 1</li><li><i></i>Woche 2</li><li><i></i>Woche 3</li></ul></article>
      <article class="b"><div><h3>Planung, die den Betrieb nicht stört</h3><p>Der Drehplan richtet sich nach euren Aufträgen, nicht umgekehrt.</p></div><img src={b('60')} alt="" loading="lazy" /></article>
      <article class="c"><img src={b('0')} alt="" loading="lazy" /><div><h3>Jetzt Kennenlerngespräch buchen</h3><p>In 30 Minuten klären wir, ob es passt:</p><ul class="haken"><li>Wie eure Marke aussehen könnte</li><li>Was ein Drehtag bei euch bringt</li><li>Was es kostet</li></ul><a class="p" href="#termin">Gespräch vereinbaren</a></div></article></div></section>
  <section class="stapel"><h2><span>Ergebnisse.</span><br />Was Betriebe mit uns erreicht haben</h2>{[['1005','Malerbetrieb Beispiel'],['1027','Tischlerei in Pankow'],['1060','Rösterei am Markt']].map(([n, t], i) => <figure style={`top:${90 + i * 26}px`}><img src={b(n)} alt="" loading="lazy" /><figcaption>{t}</figcaption><a href="#" aria-label={`Film über ${t} ansehen`}>▶</a></figure>)}</section>
  <section class="streu" data-streu><div><h2>Jetzt eure Marke aufbauen.</h2><a class="p" href="#termin">Gespräch vereinbaren</a></div>{[['1027',4,12,150],['1060',80,6,170],['823',14,62,120],['856',74,60,110],['64',36,86,90],['91',92,40,120],['832',-2,70,110]].map(([n, x, y, w], i) => <img src={b(String(n))} alt="" loading="lazy" style={`left:${x}%;top:${y}%;width:${w}px`} data-tiefe={i % 3 + 1} />)}</section>
  <section class="ablauf" id="ablauf"><h2><span>Ablauf.</span><br />In fünf Schritten zur Marke</h2><div class="ab"><ol>{schritte.map(([t, p]) => <li data-schritt><h3>{t}</h3><p>{p}</p></li>)}</ol><div class="bild">{schritte.map(([, , n], i) => <img src={b(n)} alt="" loading="lazy" class={i === 0 ? 'an' : ''} />)}</div></div></section>
  <section class="stimmen" id="stimmen"><div class="kopf"><h2><span>Stimmen.</span><br />Vertrauensvolle Zusammenarbeit</h2><ul class="siegel"><li><b>5,0</b>Google</li><li><b>Sehr gut</b>Kundenportal</li></ul></div><div class="zwei">{[['1027','„Sie nehmen einem jede Scheu vor der Kamera.“','Lena Muster, Tischlerei'],['856','„Die Filme zeigen genau das, was wir unseren Kunden sagen wollten.“','Tom Probe, Dachdeckerei']].map(([n, t, w]) => <figure data-zeig><img src={b(n)} alt="" loading="lazy" /><blockquote>{t}</blockquote><figcaption>{w}</figcaption></figure>)}</div></section>
  <section class="breit" data-zeig><img src={b('1059')} alt="" loading="lazy" /><h2>Über uns</h2></section>
  <section class="team" id="team"><h2>FILMBAR baut die Marke von Handwerksbetrieben auf, langfristig.</h2><ul>{[['1005','Max Muster','Geschäftsführer'],['1027','Anna Beispiel','Geschäftsführerin']].map(([n, t, r]) => <li data-zeig><img src={b(n)} alt="" loading="lazy" /><h3>{t}</h3><p>{r}</p></li>)}</ul></section>
  <section class="zahlen"><h2><span>Darum wir.</span><br />Unser Mehrwert gegenüber anderen Agenturen</h2><div class="raster"><article><b>27+</b><p>Betriebe betreuen wir seit mehr als einem Jahr.</p></article><article><p class="m">Wir arbeiten nur für das Handwerk und kennen eure Abläufe.</p></article><article><b>12</b><p>Jahre Erfahrung mit Film und Social Media.</p></article><article class="w"><h3>Entspannte Stimmung am Drehtag</h3><p>Wir helfen euch dabei, vor der Kamera locker zu wirken.</p></article><article><b>5,0</b><p>aus 40 Bewertungen</p></article><article class="w"><h3>Fachwissen aus eurer Branche</h3><p>Wir wissen, welche Themen eure Kunden wirklich interessieren.</p></article></div><a class="p" href="#termin">Gespräch vereinbaren</a></section>
  <section class="fragen" id="fragen"><h2><span>FAQ.</span><br />Häufige Fragen</h2>{[['Was kostet die Zusammenarbeit?','Das hängt von der Zahl der Drehtage ab. Im Erstgespräch nennen wir einen festen Preis.'],['Wann sehen wir erste Ergebnisse?','Die ersten Filme liegen nach drei Wochen vor, Anfragen kommen meist nach zwei bis drei Monaten.'],['Müssen wir selbst vor die Kamera?','Nur wer möchte. Oft reichen zwei oder drei Leute aus dem Team.'],['Wann geht es los?','In der Regel innerhalb von vier Wochen nach dem Gespräch.']].map(([f, a]) => <details><summary>{f}</summary><p>{a}</p></details>)}</section>
</main>
<footer id="termin"><ul class="leiste">{leute.slice(0, 7).map(([n], i) => <li style={`--h:${[150, 170, 160, 210, 170, 160, 150][i]}px`}><img src={b(n)} alt="" loading="lazy" /></li>)}</ul>
  <div class="unten"><div><a class="wm" href="#">FILMBAR</a><p>Instagram · LinkedIn · YouTube</p></div><ul><li><a href="#">Start</a></li><li><a href="#vorteile">Vorteile</a></li><li><a href="#service">Service</a></li><li><a href="#ablauf">Ablauf</a></li></ul><ul><li><a href="#">Impressum</a></li><li><a href="#">Datenschutz</a></li><li><a href="#">Cookies</a></li></ul><p>FILMBAR GmbH<br />Musterstraße 10<br />10115 Berlin<br />hallo@filmbar.example</p></div><small>Beispielinhalte, die Firma ist erfunden.</small></footer>
<script is:inline>
(() => {
  document.querySelectorAll('[data-band]').forEach((k) => k.addEventListener('click', () => k.parentElement.querySelector('ul').scrollBy({ left: k.dataset.band * 340, behavior: 'smooth' })));
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bilder = [...document.querySelectorAll('.ab .bild img')];
  const beob = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { const i = [...document.querySelectorAll('[data-schritt]')].indexOf(e.target); bilder.forEach((x, k) => x.classList.toggle('an', k === i)); } }), { rootMargin: '-45% 0px -45% 0px' });
  document.querySelectorAll('[data-schritt]').forEach((s) => beob.observe(s));
  if (ruhig) return;
  document.documentElement.classList.add('js');
  const zeig = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('da'); zeig.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-zeig]').forEach((s) => zeig.observe(s));
  const f = document.querySelector('[data-streu]'), st = [...f.querySelectorAll('img')];
  const z = () => { const r = f.getBoundingClientRect(); if (r.bottom < 0 || r.top > innerHeight) return; const p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight; st.forEach((x) => { x.style.transform = `translateY(${p * x.dataset.tiefe * 70}px)`; }); };
  addEventListener('scroll', z, { passive: true }); z();
})();
</script>
