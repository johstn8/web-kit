---
/**
 * Kachelraster mit grosser Bildflaeche oben und Text darunter, zwei Spalten,
 * wahlweise mit breiten Kacheln. Auf einer Kachel koennen Kennwerte als
 * kleine Glasetiketten am Bild sitzen. Abgeleitet aus mercury.com
 * (Funktionskacheln) und rico-gmbh.de (Produkt mit Kennwerten).
 *
 * Die Kachelflaeche wechselt je Kachel zwischen hell und dunkel, das nimmt
 * dem Raster die Gleichfoermigkeit des SaaS-Kartenkastens. Kennwerte nur,
 * wenn sie belegt sind.
 */
import './glas.css';
import Sektion from './Sektion.astro';
import type { Bild } from './_lib.ts';
interface Kachel { titel: string; text: string; bild?: Bild; breit?: boolean; dunkel?: boolean; kennwerte?: string[]; ziel?: string }
interface Props { titel?: string; lead?: string; kacheln: Kachel[]; flaeche?: 'bg' | 'surface' | 'surface-alt' }
const { titel, lead, kacheln, flaeche } = Astro.props;
---
<Sektion titel={titel} lead={lead} flaeche={flaeche}>
  <ul class="kacheln">
    {kacheln.map((k) => (
      <li class:list={{ breit: k.breit }}>
        <div class:list={['bild', { dunkel: k.dunkel }]}>
          {k.bild && <img src={k.bild.src} alt={k.bild.alt} loading="lazy" />}
          {k.kennwerte && <ul class="werte">{k.kennwerte.map((w) => <li class="glas">{w}</li>)}</ul>}
        </div>
        <h3>{k.ziel ? <a href={k.ziel}>{k.titel}</a> : k.titel}</h3>
        <p>{k.text}</p>
      </li>
    ))}
  </ul>
</Sektion>

<style>
  .kacheln { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-5); list-style: none; margin: 0; padding: 0; }
  .breit { grid-column: 1 / -1; }
  .bild { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface-alt); display: grid; place-items: center; }
  .breit .bild { aspect-ratio: 21 / 9; }
  .bild.dunkel { background: #1b1b26; }
  .bild img { width: 100%; height: 100%; object-fit: cover; }
  .werte { position: absolute; inset: var(--space-3); display: flex; flex-wrap: wrap; align-content: flex-end; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .werte li { padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); font-size: var(--text-small); font-weight: 500; }
  h3 { margin: var(--space-4) 0 var(--space-1); font-size: var(--text-h3); font-weight: var(--text-h3--font-weight); letter-spacing: var(--text-h3--letter-spacing); }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 0; color: var(--color-text-secondary); font-size: var(--text-small); line-height: 1.5; max-width: 34rem; }
  @media (max-width: 640px) { .kacheln { grid-template-columns: 1fr; } .breit .bild { aspect-ratio: 4 / 3; } }
</style>
