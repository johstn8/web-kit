---
/**
 * Eckige, hellgraue Kacheln, je eine fuer ein Produkt oder Projekt: freigestelltes
 * Objekt, Marke oder Auftraggeber, Titel, ein Satz, Plus als Link. Nach modulo-
 * consulting.de, vom Nutzer 2026-11-07 gelobt ("eckige Kacheln mit den einzelnen
 * Produkten"). Die Kacheln sind versetzt hoch, damit das Raster nicht starr wirkt.
 * Gemessen 2026-11-07: Die Kachel selbst reagiert nicht auf Hover; Knoepfe wachsen auf
 * 110 % in 0,3 s.
 */
import type { Bild } from './_lib.ts';
interface Kachel { titel: string; marke?: string; text: string; bild: Bild; ziel?: string }
interface Props { titel?: string; kacheln: Kachel[] }
const { titel, kacheln } = Astro.props;
---
<section class="produktkacheln">
  {titel && <h2>{titel}</h2>}
  <ul>{kacheln.map((k) => (
    <li><a href={k.ziel ?? '#'}>
      {k.marke && <span class="marke">{k.marke}</span>}
      <h3>{k.titel}</h3><p>{k.text}</p>
      <img src={k.bild.src} alt={k.bild.alt} loading="lazy" />
      <i aria-hidden="true">+</i>
    </a></li>
  ))}</ul>
</section>

<style>
  .produktkacheln { max-width: var(--container); margin-inline: auto; padding: var(--space-12) var(--gutter); }
  h2 { margin: 0 0 var(--space-8); text-align: center; font-size: var(--text-h2); line-height: var(--text-h2--line-height); font-weight: var(--text-h2--font-weight); }
  ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); list-style: none; margin: 0; padding: 0; }
  li:nth-child(even) { translate: 0 var(--space-8); }
  a { position: relative; display: grid; grid-template-rows: auto auto auto 1fr; min-height: 26rem; padding: var(--space-6); background: var(--color-surface-alt); color: var(--color-text); text-decoration: none; overflow: hidden; }
  .marke { font-weight: 700; color: var(--color-text-secondary); letter-spacing: .02em; }
  h3 { margin: var(--space-3) 0 var(--space-2); max-width: 14ch; font-size: var(--text-h3); line-height: 1.2; }
  p { margin: 0; max-width: 24ch; font-size: var(--text-small); color: var(--color-text-secondary); }
  img { justify-self: end; align-self: end; width: 62%; max-height: 16rem; object-fit: contain; }
  i { position: absolute; right: var(--space-4); top: var(--space-4); display: grid; place-content: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-surface); font-style: normal; transition: transform .3s; }
  a:hover i { transform: scale(1.1); }
  a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 3px; }
  @media (max-width: 40rem) { ul { grid-template-columns: 1fr; } li:nth-child(even) { translate: none; } a { min-height: 20rem; } }
</style>
