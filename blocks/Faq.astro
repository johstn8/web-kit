---
/** FAQ als native details-Elemente: funktioniert ohne JavaScript,
 *  ist tastaturbedienbar und braucht keine ARIA-Nachbildung. */
import Sektion from './Sektion.astro';
interface Props { titel?: string; faq: { frage: string; antwort: string }[] }
const { titel = 'Häufige Fragen', faq } = Astro.props;
---
<Sektion titel={titel} id="faq">
  <div class="liste">
    {faq.map((f) => (
      <details name="faq">
        <summary>{f.frage}</summary>
        <p>{f.antwort}</p>
      </details>
    ))}
  </div>
</Sektion>

<style>
  .liste { max-width: var(--prose); border-top: 1px solid var(--color-border); }
  details { border-bottom: 1px solid var(--color-border); }
  summary { cursor: pointer; padding: var(--space-4) 0; font-size: var(--text-h3); font-weight: 500; list-style-position: outside; }
  summary:hover { color: var(--color-text-secondary); }
  summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; border-radius: var(--radius-sm); }
  details p { margin: 0 0 var(--space-4); font-size: var(--text-body); line-height: var(--text-body--line-height); color: var(--color-text-secondary); text-wrap: pretty; }
</style>
