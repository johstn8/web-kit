---
/** Gemeinsame Sektionshuelle. Der Abstand zwischen zwei Sektionen ist
 *  deutlich groesser als jeder Abstand innerhalb einer Sektion. */
interface Props { titel?: string; lead?: string; id?: string; flaeche?: 'bg' | 'surface' | 'surface-alt' }
const { titel, lead, id, flaeche = 'bg' } = Astro.props;
---
<section id={id} class:list={['sektion', `flaeche-${flaeche}`]}>
  <div class="inner">
    {titel && <h2>{titel}</h2>}
    {lead && <p class="lead">{lead}</p>}
    <div class="inhalt"><slot /></div>
  </div>
</section>

<style>
  .sektion { padding: var(--space-12) 0; }
  .flaeche-bg { background: var(--color-bg); }
  .flaeche-surface { background: var(--color-surface); }
  .flaeche-surface-alt { background: var(--color-surface-alt); }
  .inner { max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
  h2 { font-size: var(--text-h2); line-height: var(--text-h2--line-height); font-weight: var(--text-h2--font-weight); letter-spacing: var(--text-h2--letter-spacing); text-wrap: balance; margin: 0; }
  .lead { font-size: var(--text-lead); color: var(--color-text-secondary); max-width: var(--prose); text-wrap: pretty; margin: var(--space-4) 0 0; }
  .inhalt { margin-top: var(--space-8); }
</style>
