---
/**
 * Lichtbrechung am Glasrand. Einmal je Seite einbinden, dann auf einem
 * Element mit class="glas" zusaetzlich class="glas-bricht" setzen.
 *
 * Verzerrt den Hintergrund ueber einen SVG-Filter. Das geht nur in
 * Chromium; Safari und Firefox ignorieren die Regel und zeigen das normale
 * Glas aus glas.css. Deshalb ist es Zugabe, nie Traeger einer Aussage.
 */
---
<svg width="0" height="0" aria-hidden="true" style="position:absolute">
  <filter id="glas-bruch" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="4" result="rauschen" />
    <feGaussianBlur in="rauschen" stdDeviation="3" result="weich" />
    <feDisplacementMap in="SourceGraphic" in2="weich" scale="28" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
<style is:global>
  @supports (backdrop-filter: url('#glas-bruch')) {
    .glas-bricht { backdrop-filter: blur(2px) url('#glas-bruch') saturate(1.5); }
  }
</style>
