---
/**
 * Schraeg liegende Punktkarte mit Orten und animierten Boegen von einem
 * Mittelpunkt aus. Abgeleitet aus metagram-solutions.com.
 *
 * Orte kommen als Laenge und Breite, der Block rechnet sie in den
 * Ausschnitt um. Standardausschnitt ist der deutschsprachige Raum. Eine
 * echte Landesform laesst sich ueber `umriss` (SVG-Pfad im Rahmen
 * 1000 x 620) setzen; ohne sie bleibt die Flaeche ein Punktraster, das
 * keine Grenzen behauptet.
 *
 * Fuer Betriebe mit mehreren Standorten oder einem echten Einzugsgebiet.
 * Die Orte stehen zusaetzlich als Liste im Dokument, weil die Karte fuer
 * Screenreader nur Bild ist.
 */
import Sektion from './Sektion.astro';
interface Ort { name: string; lat: number; lon: number; zentrale?: boolean }
interface Props {
  titel?: string; lead?: string; orte: Ort[]; umriss?: string;
  ausschnitt?: { west: number; ost: number; sued: number; nord: number };
  flaeche?: 'bg' | 'surface' | 'surface-alt';
}
const { titel, lead, orte, umriss, ausschnitt = { west: 5, ost: 17.5, sued: 46, nord: 55.5 }, flaeche } = Astro.props;
const B = 1000, H = 620;
const punkt = (o: Ort) => ({
  ...o,
  x: ((o.lon - ausschnitt.west) / (ausschnitt.ost - ausschnitt.west)) * B,
  y: ((ausschnitt.nord - o.lat) / (ausschnitt.nord - ausschnitt.sued)) * H,
});
const pkte = orte.map(punkt);
const mitte = pkte.find((p) => p.zentrale) ?? pkte[0];
const bogen = (p: { x: number; y: number }) => {
  const mx = (mitte.x + p.x) / 2, my = (mitte.y + p.y) / 2;
  const hub = Math.hypot(p.x - mitte.x, p.y - mitte.y) * 0.32;
  return `M${mitte.x.toFixed(1)} ${mitte.y.toFixed(1)} Q${mx.toFixed(1)} ${(my - hub).toFixed(1)} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
};
---
<Sektion titel={titel} lead={lead} flaeche={flaeche} id="standorte">
  <div class="buehne" aria-hidden="true">
    <svg class="karte" viewBox={`0 0 ${B} ${H}`}>
      <defs>
        <pattern id="kartenpunkte" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" /></pattern>
      </defs>
      {umriss ? <path class="land" d={umriss} /> : <rect class="raster" width={B} height={H} fill="url(#kartenpunkte)" />}
      {pkte.filter((p) => p !== mitte).map((p, i) => <path class="bogen" d={bogen(p)} pathLength="1" style={`--i:${i}`} />)}
      {pkte.map((p) => <circle class:list={['ort', { mitte: p === mitte }]} cx={p.x} cy={p.y} r={p === mitte ? 9 : 6} />)}
      {pkte.map((p) => <text class="name" x={p.x + 14} y={p.y + 5}>{p.name}</text>)}
    </svg>
  </div>
  <ul class="orte">{orte.map((o) => <li>{o.name}</li>)}</ul>
</Sektion>

<style>
  .buehne { perspective: 1400px; margin-block: calc(-1 * var(--space-5)) 0; }
  .karte { display: block; width: 100%; height: auto; overflow: visible; transform: rotateX(40deg) rotateZ(-6deg); transform-origin: 50% 60%; }
  pattern circle { fill: var(--color-border-hover); opacity: 0.55; }
  .land { fill: var(--color-surface-alt); stroke: var(--color-border); }
  .bogen { fill: none; stroke: var(--color-accent); stroke-width: 2.5; stroke-linecap: round; }
  .ort { fill: var(--color-text); }
  .ort.mitte { fill: var(--color-accent); }
  .name { font-size: 22px; font-weight: 600; fill: var(--color-text); paint-order: stroke; stroke: var(--color-bg); stroke-width: 6px; }
  .orte { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); list-style: none; margin: var(--space-5) 0 0; padding: 0; font-size: var(--text-small); color: var(--color-text-secondary); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bogen { stroke-dasharray: 1; animation: ziehen linear both; animation-timeline: view(); animation-range: cover calc(12% + var(--i) * 4%) cover calc(42% + var(--i) * 4%); }
    }
  }
  @keyframes ziehen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
