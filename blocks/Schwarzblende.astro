---
/**
 * Schwarzer Abschnitt, in dem dunkle Flaechen ueber dem Bild liegen und beim Scrollen
 * weich aufblenden. Nach agencyinvest.de; vom Nutzer 2026-11-07 nur dieses Element
 * gelobt ("schwarzer Hintergrund und Overlay von schwarzen Elementen mit Fade").
 * Im Grund liegt das Wort des Betriebs als sehr blasse Wiederholung, nur Schmuck.
 * Das Bild blendet bewusst ins Schwarz aus: in qa.sh --erlaubt verlaufsschleier setzen,
 * weil der Nutzer genau diese Ausblendung hier will.
 */
import type { Bild, Aktion } from './_lib.ts';
interface Props { wort: string; titel: string; text: string[]; bild: Bild; aktion?: Aktion }
const { wort, titel, text, bild, aktion } = Astro.props;
---
<section class="schwarzblende" data-blende>
  <div class="wort" aria-hidden="true">{Array.from({ length: 24 }, () => <span data-w={wort}></span>)}</div>
  <figure><img src={bild.src} alt={bild.alt} loading="lazy" /></figure>
  <div class="text"><h2>{titel}</h2>{text.map((t) => <p>{t}</p>)}{aktion && <a href={aktion.ziel}>{aktion.label} <span aria-hidden="true">→</span></a>}</div>
</section>
<script is:inline>
(() => {
  const f = document.querySelectorAll('[data-blende]');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) { f.forEach((x) => x.classList.add('da')); return; }
  const o = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('da'); o.unobserve(e.target); } }), { threshold: .3 });
  f.forEach((x) => { x.classList.add('wartet'); o.observe(x); });
})();
</script>

<style>
  .schwarzblende { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-8); align-items: center; padding: var(--space-12) var(--gutter); background: #000; color: #fff; overflow: hidden; }
  .wort { position: absolute; inset: -2rem; display: flex; flex-wrap: wrap; gap: 0 2rem; align-content: flex-start; font: 800 clamp(2.5rem, 6vw, 5rem)/1 var(--font-display); text-transform: uppercase; color: rgb(255 255 255 / .05); pointer-events: none; }
  .wort span::before { content: attr(data-w); }
  figure { position: relative; margin: 0; aspect-ratio: 4 / 5; }
  figure img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); }
  figure::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 40%, #000), linear-gradient(transparent 55%, #000); }
  .text { position: relative; } h2 { margin: 0 0 var(--space-5); font-size: var(--text-h2); line-height: 1.12; font-weight: 700; }
  p { margin: 0 0 var(--space-3); color: #d6d6d6; max-width: 34rem; }
  a { display: inline-flex; gap: var(--space-2); margin-top: var(--space-4); padding: var(--space-2) var(--space-4); background: #fff; color: #000; text-decoration: none; font-size: var(--text-small); font-weight: 600; }
  /* Nur das Bild blendet auf; der Text gleitet, bleibt aber immer lesbar. */
  .wartet figure { opacity: 0; transition: opacity 1.6s var(--ease-out); } .wartet .text { translate: 0 2rem; transition: translate 1.2s var(--ease-out) .2s; }
  .wartet.da figure { opacity: 1; } .wartet.da .text { translate: 0 0; }
  @media (max-width: 52rem) { .schwarzblende { grid-template-columns: 1fr; } figure { aspect-ratio: 4 / 3; } figure::after { background: linear-gradient(transparent 50%, #000); } }
</style>
