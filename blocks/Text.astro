---
/** Lesestrecke fuer Rechtsseiten und redaktionelle Abschnitte. */
import Sektion from './Sektion.astro';
interface Props { titel?: string }
const { titel } = Astro.props;
---
<Sektion titel={titel}>
  <div class="prosa"><slot /></div>
</Sektion>

<style>
  .prosa { max-width: var(--prose); }
  .prosa :global(h2) { font-size: var(--text-h3); font-weight: 600; margin: var(--space-8) 0 var(--space-3); }
  .prosa :global(h2:first-child) { margin-top: 0; }
  .prosa :global(p), .prosa :global(li) { font-size: var(--text-body); line-height: var(--text-body--line-height); color: var(--color-text-secondary); text-wrap: pretty; }
  .prosa :global(p) { margin: 0 0 var(--space-4); }
  .prosa :global(ul) { margin: 0 0 var(--space-4); padding-inline-start: var(--space-5); }
  .prosa :global(a) { color: var(--color-text); }
</style>
