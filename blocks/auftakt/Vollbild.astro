---
/**
 * Auftakt "vollbild": Foto oder Video ueber die volle Flaeche, Titel links,
 * unten eine Zeile aus Glaschips oder Kennzahlen. Mit hoehe="seite" wird
 * daraus der Kopf einer Unterseite: dieselbe Grammatik, halbe Hoehe.
 * Abgeleitet aus comito.de und ko-mon.de.
 *
 * Unterschied zu Leitbild: Leitbild ist die gesetzte Form der Gastronomie
 * mit Infoband. Vollbild ist fuer Dienstleister, Unterseiten und
 * Veranstaltungen und traegt Beweise statt Oeffnungszeiten.
 * Video laeuft stumm und endlos, deshalb mit Pausenschalter (WCAG 2.2.2)
 * und ohne Autoplay bei reduzierter Bewegung. Titel ueber 28 Zeichen setzen
 * sich in der H1-Stufe, damit Presets mit riesiger Displaystufe nicht ueberlaufen.
 */
import '../glas.css';
import type { Aktion, Bild } from '../_lib.ts';
interface Props {
  titel: string; lead?: string; bild: Bild; video?: string;
  aktionen?: Aktion[]; chips?: string[]; kennzahlen?: { wert: string; label: string }[];
  hoehe?: 'voll' | 'seite'; schleier?: number;
}
const { titel, lead, bild, video, aktionen = [], chips = [], kennzahlen = [], hoehe = 'voll', schleier = 0.42 } = Astro.props;
---
<section class:list={['auftakt', hoehe]} style={`--schleier:${schleier}`} id="inhalt">
  {video
    ? <video src={video} poster={bild.src} muted loop playsinline data-vollbild-video aria-hidden="true"></video>
    : <img src={bild.src} alt={bild.alt} width="1920" height="1080" fetchpriority="high" decoding="async" />}
  <div class="inner">
    <div class="kopf">
      <h1 class:list={{ klein: hoehe === 'seite' || titel.length > 28 }}>{titel}</h1>
      {lead && <p class="lead">{lead}</p>}
      {aktionen.length > 0 && (
        <p class="handlung">{aktionen.map((a) => <a class={a.art ?? 'primaer'} href={a.ziel}>{a.label}</a>)}</p>
      )}
    </div>
    {(chips.length > 0 || kennzahlen.length > 0) && (
      <div class="fuss">
        {chips.length > 0 && <ul class="chips">{chips.map((c) => <li class="glas-dunkel">{c}</li>)}</ul>}
        {kennzahlen.length > 0 && <dl>{kennzahlen.map((k) => <div><dd>{k.wert}</dd><dt>{k.label}</dt></div>)}</dl>}
      </div>
    )}
  </div>
  {video && <button class="pause glas-dunkel" type="button" data-vollbild-pause aria-pressed="false" aria-label="Video anhalten"></button>}
</section>

{video && (
  <script is:inline>
    (() => {
      const v = document.querySelector('[data-vollbild-video]'), b = document.querySelector('[data-vollbild-pause]');
      if (!v || !b) return;
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {}); else b.setAttribute('aria-pressed', 'true');
      b.addEventListener('click', () => { const an = v.paused; an ? v.play() : v.pause(); b.setAttribute('aria-pressed', String(!an)); });
    })();
  </script>
)}

<style>
  .auftakt { position: relative; isolation: isolate; display: flex; color: #fff; background: #14151a; overflow: hidden; }
  .voll { min-height: 100svh; }
  .seite { min-height: clamp(24rem, 56svh, 34rem); }
  img, video { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .auftakt::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgb(10 12 18 / var(--schleier)); }
  .inner { width: 100%; max-width: calc(var(--container) + 4rem); margin-inline: auto; padding: 7rem var(--gutter) var(--space-6); display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-8); }
  .kopf { max-width: 44rem; }
  h1 { margin: 0; font-size: var(--text-display); line-height: var(--text-display--line-height); font-weight: var(--text-display--font-weight); letter-spacing: var(--text-display--letter-spacing); text-wrap: balance; }
  h1.klein { font-size: var(--text-h1); line-height: var(--text-h1--line-height); }
  .lead { margin: var(--space-4) 0 0; font-size: var(--text-lead); line-height: var(--text-lead--line-height); text-wrap: pretty; }
  .handlung { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-6) 0 0; }
  .handlung a { display: inline-block; padding: var(--space-3) var(--space-5); border-radius: var(--aktion-radius, var(--radius-sm)); font-weight: 500; text-decoration: none; }
  .primaer { background: var(--aktion-bild-grund, var(--color-accent)); color: var(--aktion-bild-text, var(--color-accent-contrast)); }
  .sekundaer { color: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.7); }
  .fuss { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-5); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .chips li { padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); font-size: var(--text-small); }
  dl { display: flex; gap: var(--space-8); margin: 0; }
  dd { margin: 0; font-family: var(--font-display); font-size: var(--text-h1); line-height: 1; font-weight: var(--text-h2--font-weight); }
  dt { font-size: var(--text-small); margin-top: var(--space-1); }
  .pause { position: absolute; right: var(--space-4); top: 6rem; width: 2.75rem; height: 2.75rem; border: 0; border-radius: var(--radius-full); cursor: pointer; }
  .pause::before { content: ''; position: absolute; inset: 34%; border-inline: 4px solid currentColor; }
  .pause[aria-pressed='true']::before { inset: 32% 30% 32% 38%; border: 0; background: currentColor; clip-path: polygon(0 0, 100% 50%, 0 100%); }
</style>
