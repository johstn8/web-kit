---
/** Auftakt, Komposition "zweispaltig": Text links, Beweisform rechts.
 *  Die Beweisspalte traegt reale Daten, nicht Dekoration. */
import type { Aktion } from '../_lib.ts';
interface Props { titel: string; lead: string; aktion?: Aktion; fakten?: { label: string; wert: string }[] }
const { titel, lead, aktion, fakten = [] } = Astro.props;
---
<section class="auftakt">
  <div class="inner">
    <div class="text">
      <h1>{titel}</h1>
      <p class="lead">{lead}</p>
      {aktion && <p class="handlung"><a href={aktion.ziel}>{aktion.label}</a></p>}
    </div>
    {fakten.length > 0 && (
      <dl class="fakten">
        {fakten.map((f) => (<div><dt>{f.label}</dt><dd>{f.wert}</dd></div>))}
      </dl>
    )}
  </div>
</section>

<style>
  .auftakt { padding: var(--space-12) 0 var(--space-8); }
  .inner { display: grid; gap: var(--space-8); grid-template-columns: 1.2fr 0.8fr; align-items: start; max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
  h1 { font-size: var(--text-h1); line-height: var(--text-h1--line-height); font-weight: var(--text-h1--font-weight); letter-spacing: var(--text-h1--letter-spacing); text-wrap: balance; margin: 0; }
  .lead { font-size: var(--text-lead); line-height: var(--text-lead--line-height); color: var(--color-text-secondary); text-wrap: pretty; margin: var(--space-5) 0 0; }
  .handlung { margin: var(--space-6) 0 0; }
  .handlung a { display: inline-block; font-weight: 500; padding: var(--space-3) var(--space-5); border-radius: var(--radius-sm); background: var(--color-accent); color: var(--color-accent-contrast); text-decoration: none; }
  .fakten { display: grid; gap: var(--space-4); margin: 0; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  dt { font-size: var(--text-label); letter-spacing: var(--text-label--letter-spacing); text-transform: uppercase; color: var(--color-text-tertiary); }
  dd { margin: var(--space-1) 0 0; font-size: var(--text-h3); font-weight: 600; font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) { .inner { grid-template-columns: 1fr; } }
</style>
